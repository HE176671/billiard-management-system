@model List<Bms.Web.Models.ProductPriceHistoryViewModel>
@{
    ViewData["Title"] = "Lịch sử biến động giá bán (BR-15)";
    Layout = "_AdminLayout";
    string? productName = ViewBag.ProductName as string;
    int? productId = ViewBag.ProductId as int?;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-clock-history text-danger me-2"></i>Nhật ký Lịch sử thay đổi giá bán
        </h4>
        <span class="text-muted small">
            Tuân thủ quy tắc <strong>BR-15</strong>: Bảo toàn giá bán lúc phát sinh giao dịch, chống sửa lùi đơn giá của các hóa đơn trong quá khứ.
            @if (!string.IsNullOrEmpty(productName))
            {
                <span class="fw-bold text-dark">— Đang lọc theo món: @productName</span>
            }
        </span>
    </div>
    <div class="d-flex gap-2">
        @if (productId.HasValue)
        {
            <a asp-action="PriceHistory" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-list-ul me-1"></i>Xem tất cả các món
            </a>
        }
        <a asp-action="Index" class="btn btn-primary-bms btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Về danh sách món
        </a>
    </div>
</div>

<div class="data-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 50px;" class="text-center">#</th>
                    <th>Tên món / Sản phẩm</th>
                    <th class="text-end">Giá cũ</th>
                    <th class="text-center" style="width: 40px;"></th>
                    <th class="text-end">Giá mới</th>
                    <th class="text-center">Mức chênh lệch</th>
                    <th class="text-center">Thời điểm thay đổi (UTC+7)</th>
                    <th>Người thực hiện</th>
                    <th>Lý do / Ghi chú</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            Chưa có dữ liệu thay đổi giá bán nào được ghi nhận.
                        </td>
                    </tr>
                }
                else
                {
                    int idx = 1;
                    foreach (var h in Model)
                    {
                        var diff = h.NewPrice - h.OldPrice;
                        <tr>
                            <td class="text-center text-muted small">@idx</td>
                            <td>
                                <a asp-action="PriceHistory" asp-route-productId="@h.ProductId" class="fw-semibold text-decoration-none text-dark">
                                    @h.ProductName
                                </a>
                            </td>
                            <td class="text-end text-muted">
                                @h.OldPrice.ToString("N0") ₫
                            </td>
                            <td class="text-center text-muted">
                                <i class="bi bi-arrow-right"></i>
                            </td>
                            <td class="text-end fw-bold text-danger">
                                @h.NewPrice.ToString("N0") ₫
                            </td>
                            <td class="text-center">
                                @if (diff > 0)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                        +@diff.ToString("N0") ₫
                                    </span>
                                }
                                else if (diff < 0)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        @diff.ToString("N0") ₫
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted">0 ₫</span>
                                }
                            </td>
                            <td class="text-center text-muted small">
                                @h.EffectiveDateUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm:ss")
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-person me-1"></i>@(h.ChangedByName ?? "Hệ thống")
                                </span>
                            </td>
                            <td>
                                <span class="text-muted small">@(string.IsNullOrWhiteSpace(h.Note) ? "—" : h.Note)</span>
                            </td>
                        </tr>
                        idx++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>
