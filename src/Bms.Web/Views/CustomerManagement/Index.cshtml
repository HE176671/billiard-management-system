@model Bms.Web.Models.CustomerManagementViewModel
@using Bms.Web.Services
@{
    ViewData["Title"] = "Danh sách hội viên";
    Layout = "_AdminLayout";
    var form = Model.Form;
    var selectedId = form?.Id;

    string TierStyle(string? name) => name switch
    {
        "Gold"   => "background:#fef3c7;color:#b45309",
        "Silver" => "background:#e2e8f0;color:#475569",
        "Member" => "background:#dbeafe;color:#1d4ed8",
        _        => "background:#f1f5f9;color:#64748b"
    };
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3 rounded-3" role="alert" style="font-size:0.875rem">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3 rounded-3" style="font-size:0.875rem">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3">
    <!-- ═══════════ Danh sách hội viên ═══════════ -->
    <div class="@(form != null ? "col-lg-8" : "col-12")">
        <div class="data-card">
            <div class="data-card-header">
                <span class="data-card-title"><i class="bi bi-people me-2"></i>Danh sách hội viên (@Model.TotalCount)</span>
                <div class="d-flex gap-2">
                    <a asp-action="Lookup" class="btn-primary-bms">
                        <i class="bi bi-person-plus"></i> Đăng ký tại quầy (CCCD 18+)
                    </a>
                    <a asp-action="ExportCsv"
                       asp-route-search="@Model.Search"
                       asp-route-tierId="@Model.TierId"
                       asp-route-segment="@Model.Segment"
                       class="btn-outline-bms">
                        <i class="bi bi-download"></i> Xuất CSV
                    </a>
                </div>
            </div>

            <form method="get" id="searchForm" class="d-flex gap-2 flex-wrap p-3 border-bottom bg-light bg-opacity-50">
                <input type="text" name="search" value="@Model.Search" placeholder="Tìm theo họ tên, số điện thoại hoặc email..."
                       class="form-control" style="flex:1;min-width:200px" />
                <select name="segment" class="form-select" style="width:175px"
                        onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.Segment))">Tất cả nhóm khách</option>
                    @foreach (var seg in new[] { "Champion", "Loyal", "New", "AtRisk" })
                    {
                        <option value="@seg" selected="@(Model.Segment == seg)">@VnFormat.SegmentLabel(seg)</option>
                    }
                </select>
                <select name="tierId" class="form-select" style="width:140px"
                        onchange="this.form.submit()">
                    <option value="" selected="@(Model.TierId == null)">Tất cả hạng</option>
                    @foreach (var t in Model.Tiers)
                    {
                        <option value="@t.Id" selected="@(Model.TierId == t.Id)">Hạng @t.Name</option>
                    }
                </select>
                <button type="submit" class="btn-primary-bms" title="Tìm kiếm"><i class="bi bi-search"></i> Tìm</button>
                @if (!string.IsNullOrEmpty(Model.Search) || Model.TierId != null || !string.IsNullOrEmpty(Model.Segment))
                {
                    <a asp-action="Index" class="btn-outline-bms"><i class="bi bi-x-lg"></i> Xóa lọc</a>
                }
            </form>

            @if (!Model.Customers.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    Không tìm thấy hội viên nào phù hợp.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Họ và tên</th>
                                <th>Số điện thoại</th>
                                <th>Email &amp; Ngày sinh</th>
                                <th>Hạng</th>
                                <th>Nhóm khách</th>
                                <th class="text-end">Chi tiêu 12T</th>
                                <th class="text-end">Điểm</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Customers)
                            {
                                var editHref = Url.Action("Index", new { search = Model.Search, tierId = Model.TierId, segment = Model.Segment, page = Model.Page, id = c.Id });
                                <tr style="@(c.Id == selectedId ? "background:#fff1f3" : "")">
                                    <td>
                                        <a asp-action="Profile" asp-route-id="@c.Id" class="fw-semibold text-dark text-decoration-none">
                                            @c.FullName
                                        </a>
                                    </td>
                                    <td class="fw-semibold">@(c.PhoneNumber ?? "—")</td>
                                    <td>
                                        <div style="font-size:0.82rem">@(c.Email ?? "—")</div>
                                        @if (c.DateOfBirth.HasValue)
                                        {
                                            <div class="text-muted" style="font-size:0.75rem">NS: @c.DateOfBirth.Value.ToString("dd/MM/yyyy")</div>
                                        }
                                    </td>
                                    <td>
                                        @if (c.TierName != null)
                                        {
                                            <span style="@(TierStyle(c.TierName));padding:2px 10px;border-radius:6px;font-size:0.75rem;font-weight:600">@c.TierName</span>
                                        }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                    <td>
                                        <span style="@(c.SegmentStyle);padding:2px 10px;border-radius:6px;font-size:0.75rem;font-weight:600">@VnFormat.SegmentLabel(c.Segment)</span>
                                    </td>
                                    <td class="text-end text-muted">@VnFormat.Money(c.Spend12M)</td>
                                    <td class="text-end fw-semibold">@VnFormat.Number(c.RewardPoints)</td>
                                    <td class="text-end text-nowrap">
                                        <a asp-controller="LoyaltyTest" asp-action="Index" asp-route-customerId="@c.Id" asp-route-customerMode="member"
                                           class="btn-outline-bms py-1 px-2 me-1" style="font-size:0.75rem" title="Chuyển sang Thanh toán">
                                            <i class="bi bi-receipt-cutoff"></i> Thanh toán
                                        </a>
                                        <a asp-action="Profile" asp-route-id="@c.Id" class="btn-sm-icon me-1" title="Xem hồ sơ hội viên">
                                            <i class="bi bi-person-vcard"></i>
                                        </a>
                                        <a href="@editHref" class="btn-sm-icon" title="Sửa thông tin">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="d-flex justify-content-center align-items-center gap-2 py-3 flex-wrap border-top">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <a asp-action="Index"
                               asp-route-search="@Model.Search"
                               asp-route-tierId="@Model.TierId"
                               asp-route-segment="@Model.Segment"
                               asp-route-page="@i"
                               asp-route-id="@selectedId"
                               class="btn-sm-icon"
                               style="@(i == Model.Page ? "background:#e94560;color:#fff;border-color:#e94560" : "")">@i</a>
                        }
                    </div>
                }
            }
        </div>
    </div>

    <!-- ═══════════ Khung sửa thông tin hội viên ═══════════ -->
    @if (form != null)
    {
        <div class="col-lg-4">
            <div class="form-card" id="customerDetailPanel" style="max-width:none">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <h2 class="h6 fw-bold mb-0">
                        <i class="bi bi-pencil-square me-2 text-danger"></i>Cập nhật thông tin hội viên
                    </h2>
                    <div class="d-flex gap-1">
                        <a asp-action="Profile" asp-route-id="@form.Id" class="btn-outline-bms py-1 px-2" style="font-size:0.75rem">
                            <i class="bi bi-person-vcard"></i> Hồ sơ chi tiết
                        </a>
                        <a asp-action="Index" asp-route-search="@Model.Search" asp-route-tierId="@Model.TierId"
                           asp-route-segment="@Model.Segment" asp-route-page="@Model.Page"
                           class="btn-sm-icon" title="Đóng"><i class="bi bi-x-lg"></i></a>
                    </div>
                </div>

                <form asp-action="Save" method="post" id="customerForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@form.Id" />
                    <input type="hidden" name="search" value="@Model.Search" />
                    <input type="hidden" name="tierId" value="@Model.TierId" />
                    <input type="hidden" name="segment" value="@Model.Segment" />
                    <input type="hidden" name="page" value="@Model.Page" />
                    <input type="hidden" name="IsActive" value="@(form.IsActive ? "true" : "false")" />

                    @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="alert alert-danger py-2 rounded-3" style="font-size:0.8rem">
                            @foreach (var e in ViewData.ModelState[string.Empty]!.Errors) { <div>@e.ErrorMessage</div> }
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label" for="FullName">Họ và tên (theo CCCD) <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="FullName" name="FullName" maxlength="100"
                               value="@form.FullName" required />
                        @Html.ValidationMessage("FullName", new { @class = "field-error" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="PhoneNumber">Số điện thoại <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="PhoneNumber" name="PhoneNumber" maxlength="10"
                               inputmode="numeric" pattern="^0\d{9}$" title="Bắt đầu bằng 0 và gồm 10 chữ số"
                               value="@form.PhoneNumber" required />
                        @Html.ValidationMessage("PhoneNumber", new { @class = "field-error" })
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-7">
                            <label class="form-label" for="Email">Email</label>
                            <input type="email" class="form-control" id="Email" name="Email" maxlength="256"
                                   value="@form.Email" />
                        </div>
                        <div class="col-5">
                            <label class="form-label" for="DateOfBirth">Ngày sinh (CCCD)</label>
                            <input type="date" class="form-control" id="DateOfBirth" name="DateOfBirth"
                                   value="@(form.DateOfBirth?.ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label">Hạng hiện tại</label>
                            <input type="text" class="form-control" value="@(form.TierName ?? "—")" readonly disabled />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Điểm tích lũy</label>
                            <input type="text" class="form-control" value="@VnFormat.Number(form.RewardPoints)" readonly disabled />
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" name="MarketingOptIn" value="true" id="chkOptIn" checked="@form.MarketingOptIn" />
                        <label class="form-check-label" for="chkOptIn" style="font-size:0.84rem">Nhận thông báo chương trình ưu đãi</label>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <button type="submit" class="btn-primary-bms" id="btnSaveCustomer">
                            <i class="bi bi-check-lg"></i> Lưu thay đổi
                        </button>
                        <a asp-controller="LoyaltyTest" asp-action="Index" asp-route-customerId="@form.Id" asp-route-customerMode="member"
                           class="btn-outline-bms">
                            <i class="bi bi-receipt-cutoff"></i> Chuyển sang Thanh toán
                        </a>
                        <a asp-action="Index" asp-route-search="@Model.Search" asp-route-tierId="@Model.TierId"
                           asp-route-segment="@Model.Segment" asp-route-page="@Model.Page"
                           class="btn-outline-bms">Đóng</a>
                    </div>
                </form>
            </div>
        </div>
    }
</div>
