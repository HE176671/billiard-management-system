@model Bms.Web.Models.CustomerManagementViewModel
@using Bms.Web.Services
@{
    ViewData["Title"] = "Quản lý khách hàng";
    Layout = "_AdminLayout";
    var form = Model.Form;
    var selectedId = form?.Id;

    string TierStyle(string? name) => name switch
    {
        "Gold"   => "background:#fef3c7;color:#b45309",
        "Silver" => "background:#e2e8f0;color:#475569",
        "Member" => "background:#dbeafe;color:#1d4ed8",
        _        => "background:#f1f5f9;color:#64748b"
    };
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3 rounded-3" role="alert" style="font-size:0.875rem">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3 rounded-3" style="font-size:0.875rem">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3">
    <!-- ═══════════ Trái: danh sách ═══════════ -->
    <div class="col-md-7">
        <div class="data-card">
            <div class="data-card-header">
                <span class="data-card-title"><i class="bi bi-people me-2"></i>Danh sách khách hàng (@Model.TotalCount)</span>
                <a asp-action="Index"
                   asp-route-add="true"
                   asp-route-search="@Model.Search"
                   asp-route-tierId="@Model.TierId"
                   asp-route-status="@Model.Status"
                   asp-route-page="@Model.Page"
                   id="btnAddCustomer" class="btn-primary-bms">
                    <i class="bi bi-plus-lg"></i> Add Customer
                </a>
            </div>

            <form method="get" id="searchForm" class="d-flex gap-2 flex-wrap p-3 border-bottom">
                <input type="text" name="search" value="@Model.Search" placeholder="Tìm tên / SĐT..."
                       class="form-control" style="flex:1;min-width:160px;font-size:0.8rem" />
                <select name="tierId" class="form-select" style="width:130px;font-size:0.8rem"
                        onchange="this.form.submit()">
                    <option value="" selected="@(Model.TierId == null)">All Tiers</option>
                    @foreach (var t in Model.Tiers)
                    {
                        <option value="@t.Id" selected="@(Model.TierId == t.Id)">@t.Name</option>
                    }
                </select>
                <select name="status" class="form-select" style="width:130px;font-size:0.8rem"
                        onchange="this.form.submit()">
                    <option value="" selected="@(Model.Status == null)">All Status</option>
                    <option value="active" selected="@(Model.Status == "active")">Active</option>
                    <option value="locked" selected="@(Model.Status == "locked")">Locked</option>
                </select>
                <button type="submit" class="btn-primary-bms" title="Tìm kiếm"><i class="bi bi-search"></i></button>
                @if (!string.IsNullOrEmpty(Model.Search) || Model.TierId != null || Model.Status != null)
                {
                    <a asp-action="Index" class="btn-outline-bms"><i class="bi bi-x"></i> Xóa lọc</a>
                }
            </form>

            @if (!Model.Customers.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    Không tìm thấy khách hàng nào.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Full Name</th>
                                <th>Phone</th>
                                <th>Tier</th>
                                <th class="text-end">Points</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Customers)
                            {
                                var href = Url.Action("Index", new { search = Model.Search, tierId = Model.TierId, status = Model.Status, page = Model.Page, id = c.Id });
                                <tr style="cursor:pointer;@(c.Id == selectedId ? "background:#fff1f3" : "")"
                                    onclick="location.href='@href'">
                                    <td><strong>@c.FullName</strong></td>
                                    <td>@(c.PhoneNumber ?? "—")</td>
                                    <td>
                                        @if (c.TierName != null)
                                        {
                                            <span style="@(TierStyle(c.TierName));padding:2px 10px;border-radius:20px;font-size:0.75rem;font-weight:600">@c.TierName</span>
                                        }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                    <td class="text-end">@VnFormat.Number(c.RewardPoints)</td>
                                    <td>
                                        @if (c.IsActive) { <span class="badge-active">Active</span> }
                                        else { <span class="badge-inactive">Locked</span> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="d-flex justify-content-center align-items-center gap-2 py-3 flex-wrap">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <a asp-action="Index"
                               asp-route-search="@Model.Search"
                               asp-route-tierId="@Model.TierId"
                               asp-route-status="@Model.Status"
                               asp-route-page="@i"
                               asp-route-id="@selectedId"
                               class="btn-sm-icon"
                               style="@(i == Model.Page ? "background:#e94560;color:#fff;border-color:#e94560" : "")">@i</a>
                        }
                    </div>
                }
            }
        </div>
    </div>

    <!-- ═══════════ Phải: chi tiết ═══════════ -->
    <div class="col-md-5">
        @if (form == null)
        {
            <div class="form-card text-center text-muted py-5">
                <i class="bi bi-person-lines-fill fs-1 d-block mb-2"></i>
                Chọn một khách hàng ở danh sách bên trái<br />hoặc bấm <strong>Add Customer</strong> để thêm mới.
            </div>
        }
        else
        {
            <div class="form-card" id="customerDetailPanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h6 fw-bold mb-0">
                        <i class="bi @(form.IsNew ? "bi-person-plus" : "bi-person-vcard") me-2"></i>
                        @(form.IsNew ? "Thêm khách hàng mới" : "Chi tiết khách hàng")
                    </h2>
                    <a asp-action="Index" asp-route-search="@Model.Search" asp-route-tierId="@Model.TierId"
                       asp-route-status="@Model.Status" asp-route-page="@Model.Page"
                       class="btn-sm-icon" title="Đóng"><i class="bi bi-x-lg"></i></a>
                </div>

                <form asp-action="Save" method="post" id="customerForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@form.Id" />
                    <input type="hidden" name="search" value="@Model.Search" />
                    <input type="hidden" name="tierId" value="@Model.TierId" />
                    <input type="hidden" name="status" value="@Model.Status" />
                    <input type="hidden" name="page" value="@Model.Page" />

                    @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="alert alert-danger py-2 rounded-3" style="font-size:0.8rem">
                            @foreach (var e in ViewData.ModelState[string.Empty]!.Errors) { <div>@e.ErrorMessage</div> }
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label" for="FullName">Full Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="FullName" name="FullName" maxlength="100"
                               value="@form.FullName" required />
                        @Html.ValidationMessage("FullName", new { @class = "field-error" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="PhoneNumber">Phone Number <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="PhoneNumber" name="PhoneNumber" maxlength="10"
                               inputmode="numeric" pattern="\d{10}" title="Đúng 10 chữ số"
                               value="@form.PhoneNumber" required />
                        <div class="form-text">10 chữ số, dùng làm tên đăng nhập.</div>
                        @Html.ValidationMessage("PhoneNumber", new { @class = "field-error" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="Email">Email <span class="text-muted fw-normal">(không bắt buộc)</span></label>
                        <input type="email" class="form-control" id="Email" name="Email" maxlength="256"
                               value="@form.Email" />
                        @Html.ValidationMessage("Email", new { @class = "field-error" })
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label">Membership Tier</label>
                            <input type="text" class="form-control" value="@(form.TierName ?? "—")" readonly disabled />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Total Points</label>
                            <input type="text" class="form-control" value="@VnFormat.Number(form.RewardPoints)" readonly disabled />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Total Spend</label>
                            <input type="text" class="form-control" value="@VnFormat.Money(form.TotalSpend)" readonly disabled />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label d-block">Account Status</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="IsActive" id="statusActive"
                                   value="true" checked="@form.IsActive" />
                            <label class="form-check-label" for="statusActive"><span class="badge-active">Active</span></label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="IsActive" id="statusLocked"
                                   value="false" checked="@(!form.IsActive)" />
                            <label class="form-check-label" for="statusLocked"><span class="badge-inactive">Locked</span></label>
                        </div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <button type="submit" class="btn-primary-bms" id="btnSaveCustomer">
                            <i class="bi bi-save"></i> @(form.IsNew ? "Thêm khách hàng" : "Cập nhật")
                        </button>
                        <a asp-action="Index" asp-route-search="@Model.Search" asp-route-tierId="@Model.TierId"
                           asp-route-status="@Model.Status" asp-route-page="@Model.Page"
                           class="btn-outline-bms">Hủy</a>
                    </div>
                </form>

                @if (!form.IsNew)
                {
                    <hr class="my-4" />

                    <!-- Gắn thẻ thành viên -->
                    <form asp-action="AssignCard" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@form.Id" />
                        <input type="hidden" name="search" value="@Model.Search" />
                        <input type="hidden" name="tierId" value="@Model.TierId" />
                        <input type="hidden" name="status" value="@Model.Status" />
                        <input type="hidden" name="page" value="@Model.Page" />
                        <label class="form-label" for="cardCode"><i class="bi bi-credit-card-2-front me-1"></i>Thẻ thành viên</label>
                        <div class="d-flex gap-2">
                            <input type="text" class="form-control" id="cardCode" name="cardCode" maxlength="20"
                                   value="@form.CardCode" placeholder="Để trống = tự sinh mã (MB0001…)" />
                            <button type="submit" class="btn-primary-bms text-nowrap" id="btnAssignCard">
                                <i class="bi bi-link-45deg"></i> Gắn thẻ
                            </button>
                        </div>
                    </form>
                }
            </div>
        }
    </div>
</div>
