@model Bms.Web.Models.InvoiceListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tra cứu & Đối soát hóa đơn";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-receipt text-danger me-2"></i>Tra cứu & Đối soát hóa đơn</h4>
        <span class="text-muted small">Quản lý toàn bộ hóa đơn thanh toán tiền mặt & cổng trực tuyến VNPay</span>
    </div>
    <div>
        <a asp-controller="Order" asp-action="Counter" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-cart3"></i> Gọi món tại quầy
        </a>
    </div>
</div>

<!-- Bộ lọc tìm kiếm & đối soát -->
<div class="data-card p-3 mb-4">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small text-muted">Từ khóa (Mã HĐ, Bàn):</label>
            <input type="text" name="search" value="@Model.SearchKeyword" class="form-control form-control-sm" placeholder="VD: B01, 10..." />
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted">Trạng thái:</label>
            <select name="status" class="form-select form-select-sm">
                <option value="">-- Tất cả --</option>
                <option value="Paid" selected="@(Model.StatusFilter == "Paid")">Đã thanh toán (Paid)</option>
                <option value="Unpaid" selected="@(Model.StatusFilter == "Unpaid")">Chưa thanh toán (Unpaid)</option>
                <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Đã hủy (Cancelled)</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted">Từ ngày:</label>
            <input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted">Đến ngày:</label>
            <input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-danger btn-sm px-3 fw-bold flex-grow-1">
                <i class="bi bi-search me-1"></i> Tra cứu
            </button>
            <a asp-action="Invoices" class="btn btn-outline-secondary btn-sm">Đặt lại</a>
        </div>
    </form>
</div>

<!-- Danh sách hóa đơn -->
<div class="data-card">
    <div class="data-card-header">
        <span class="data-card-title">Kết quả tra cứu (@Model.TotalCount hóa đơn)</span>
    </div>

    @if (!Model.Invoices.Any())
    {
        <div class="p-5 text-center text-muted">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
            Không tìm thấy hóa đơn nào phù hợp với điều kiện tìm kiếm.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Mã HĐ</th>
                        <th>Bàn</th>
                        <th>Thời gian tạo</th>
                        <th>Tiền giờ</th>
                        <th>Tiền F&B</th>
                        <th>Giảm giá</th>
                        <th>Tổng tiền</th>
                        <th>PT Thanh toán</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Chi tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in Model.Invoices)
                    {
                        var badgeClass = inv.Status == "Paid" ? "badge bg-success" : (inv.Status == "Unpaid" ? "badge bg-warning text-dark" : "badge bg-danger");
                        <tr>
                            <td><strong>#@inv.Id</strong></td>
                            <td><span class="badge bg-danger">Bàn @inv.TableCode</span></td>
                            <td>
                                <div>@inv.CreatedAtUtc.AddHours(7).ToString("HH:mm:ss")</div>
                                <div class="text-muted small">@inv.CreatedAtUtc.AddHours(7).ToString("dd/MM/yyyy")</div>
                            </td>
                            <td>@inv.TotalPlaytime.ToString("#,##0 ₫")</td>
                            <td>@inv.TotalFandB.ToString("#,##0 ₫")</td>
                            <td class="text-success">@(inv.DiscountAmount > 0 ? $"-{inv.DiscountAmount:#,##0 ₫}" : "0 ₫")</td>
                            <td class="fw-bold text-danger">@inv.FinalAmount.ToString("#,##0 ₫")</td>
                            <td>
                                @if (inv.PaymentMethod == "VNPay")
                                {
                                    <span class="badge bg-primary"><i class="bi bi-qr-code me-1"></i>VNPay</span>
                                    @if (!string.IsNullOrEmpty(inv.GatewayRefCode))
                                    {
                                        <div class="text-muted" style="font-size: 0.7rem;">Mã: @inv.GatewayRefCode</div>
                                    }
                                }
                                else if (inv.PaymentMethod == "Cash")
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-cash me-1"></i>Tiền mặt</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td><span class="@badgeClass">@inv.Status</span></td>
                            <td class="text-end">
                                <a asp-action="InvoiceReceipt" asp-route-id="@inv.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye"></i> Xem
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="p-3 border-top d-flex justify-content-between align-items-center">
                <span class="text-muted small">Trang @Model.Page / @Model.TotalPages</span>
                <div class="btn-group btn-group-sm">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <a asp-action="Invoices" 
                           asp-route-page="@i" 
                           asp-route-search="@Model.SearchKeyword"
                           asp-route-status="@Model.StatusFilter"
                           asp-route-fromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                           asp-route-toDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                           class="btn @(Model.Page == i ? "btn-danger fw-bold" : "btn-outline-secondary")">
                            @i
                        </a>
                    }
                </div>
            </div>
        }
    }
</div>

