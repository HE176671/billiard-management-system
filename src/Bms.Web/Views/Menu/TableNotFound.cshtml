@model Bms.Web.Models.QrMenuViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Không tìm thấy bàn - Billiard Club</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background-color: #f8fafc;
            color: #1e293b;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }
        .error-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.06);
            padding: 2.5rem 1.5rem;
            max-width: 420px;
            text-align: center;
            width: 100%;
        }
        .error-icon {
            font-size: 3.5rem;
            color: #ef4444;
            margin-bottom: 1rem;
        }
    </style>
</head>
<body>
    <div class="error-card">
        <i class="bi bi-qr-code-scan error-icon"></i>
        <h4 class="fw-bold mb-2">Không tìm thấy thông tin bàn</h4>
        <p class="text-muted small mb-4">
            @(Model.ErrorMessage ?? "Mã bàn không tồn tại trên hệ thống hoặc mã QR đã hết hạn. Vui lòng quét lại mã QR tại bàn của bạn!")
        </p>
        <button class="btn btn-outline-secondary w-100" onclick="window.location.reload()">
            <i class="bi bi-arrow-clockwise me-1"></i>Thử tải lại trang
        </button>
    </div>
</body>
</html>
