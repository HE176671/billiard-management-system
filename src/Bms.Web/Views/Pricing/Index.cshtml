@model Bms.Web.Models.PricingListViewModel
@{
    ViewData["Title"] = "Cấu hình Bảng giá Bàn, Gậy cho thuê & Combo Giờ chơi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var editCue = Model.EditCue;
    var editCombo = Model.EditCombo;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ═══════════════════════════════════════════════════════════════════════ -->
<!-- PHẦN 1: CẤU HÌNH GIÁ BÀN THEO GIỜ & KHUNG GIỜ                          -->
<!-- ═══════════════════════════════════════════════════════════════════════ -->
<div class="row g-3 mb-4">
    <!-- Trái: Giá chuẩn theo loại bàn (Pool / Carom / VIP) -->
    <div class="col-lg-5">
        <div class="data-card h-100">
            <div class="data-card-header">
                <span class="data-card-title">
                    <i class="bi bi-grid-3x3-gap-fill me-1 text-danger"></i> 1A. Đơn giá bàn tiêu chuẩn (Theo giờ)
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Loại bàn</th>
                            <th>Giá chuẩn / giờ</th>
                            <th class="text-end">Cập nhật</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tt in Model.TableTypeRates)
                        {
                            <tr>
                                <td class="fw-bold">@tt.Name</td>
                                <td colspan="2">
                                    <form asp-action="UpdateTableBaseRate" method="post" class="d-flex gap-2 justify-content-end align-items-center">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@tt.Id" />
                                        <div class="input-group input-group-sm" style="max-width:170px">
                                            <input type="number" name="hourlyRate" value="@tt.HourlyRate.ToString("0")" min="1000" step="1000" class="form-control fw-semibold text-end" required />
                                            <span class="input-group-text">₫/h</span>
                                        </div>
                                        <button type="submit" class="btn-primary-bms py-1 px-2" style="font-size:0.75rem">
                                            Lưu
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="p-3 text-muted" style="font-size:0.78rem;border-top:1px solid #f1f5f9">
                Đơn giá tiêu chuẩn được áp dụng mặc định khi mở bàn nếu không thuộc khung giờ đặc biệt bên cạnh.
            </div>
        </div>
    </div>

    <!-- Phải: Bảng giá bàn theo khung giờ -->
    <div class="col-lg-7">
        <div class="data-card h-100">
            <div class="data-card-header">
                <span class="data-card-title">
                    <i class="bi bi-clock-history me-1 text-primary"></i> 1B. Bảng giá bàn theo khung giờ trong ngày
                </span>
                <a asp-action="Create" class="btn-primary-bms py-1 px-3" style="font-size:0.8rem">
                    <i class="bi bi-plus-lg"></i> Thêm khung giờ
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Loại bàn</th>
                            <th>Giờ bắt đầu</th>
                            <th>Giờ kết thúc</th>
                            <th>Giá / giờ</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Configs)
                        {
                            <tr>
                                <td><strong>@p.TableTypeName</strong></td>
                                <td>@p.StartHour</td>
                                <td>@p.EndHour</td>
                                <td><strong class="text-danger">@p.HourlyRate.ToString("N0") ₫/giờ</strong></td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn-sm-icon" title="Sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-sm-icon danger" title="Xóa"
                                                onclick="return confirm('Xóa mức giá khung giờ này?')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Configs.Any())
                        {
                            <tr><td colspan="5" class="text-center py-4 text-muted">Chưa có cấu hình khung giờ riêng. Hệ thống đang áp dụng giá chuẩn bên trái.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════════ -->
<!-- PHẦN 2: CẤU HÌNH GIÁ GẬY CHO THUÊ (THEO LƯỢT)                          -->
<!-- ═══════════════════════════════════════════════════════════════════════ -->
<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="data-card p-4 h-100">
            <h2 class="h6 fw-bold mb-2">
                <i class="bi bi-sliders2-vertical me-2 text-danger"></i>@(editCue != null ? $"Chỉnh sửa gậy thuê #{editCue.Id}" : "2. Thêm / Cấu hình Gậy cho thuê")
            </h2>
            <p class="text-muted mb-3" style="font-size:0.8rem">
                Thiết lập đơn giá gậy Bida cho thuê tính theo lượt chơi và số lượng tồn tại quầy.
            </p>

            <form asp-action="SaveRentalCue" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@(editCue?.Id ?? 0)" />

                <div class="mb-2">
                    <label class="form-label">Tên loại gậy cho thuê <span class="text-danger">*</span></label>
                    <input type="text" name="name" value="@(editCue?.Name ?? "")" class="form-control"
                           placeholder="VD: Gậy Carbon Predator (Thuê theo lượt)" required maxlength="100" />
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-7">
                        <label class="form-label">Giá thuê / lượt (₫) <span class="text-danger">*</span></label>
                        <input type="number" name="price" value="@(editCue != null ? editCue.Price.ToString("0") : "40000")"
                               min="1000" step="1000" class="form-control" required />
                    </div>
                    <div class="col-5">
                        <label class="form-label">Số lượng gậy</label>
                        <input type="number" name="stockQuantity" value="@(editCue?.StockQuantity ?? 10)"
                               min="0" class="form-control" required />
                    </div>
                </div>

                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" name="isActive" value="true" id="cueActiveSwitch"
                           checked="@(editCue?.IsActive ?? true)" />
                    <label class="form-check-label" for="cueActiveSwitch" style="font-size:0.85rem">Mở cho thuê tại quầy</label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn-primary-bms flex-grow-1 justify-content-center">
                        <i class="bi bi-check-lg"></i> @(editCue != null ? "Lưu cập nhật" : "Thêm gậy cho thuê")
                    </button>
                    @if (editCue != null)
                    {
                        <a asp-action="Index" class="btn-outline-bms">Hủy</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="data-card h-100">
            <div class="data-card-header">
                <span class="data-card-title">
                    <i class="bi bi-list-Columns-reverse me-1"></i> Danh mục Gậy cho thuê theo lượt (@Model.RentalCues.Count)
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Tên gậy cho thuê</th>
                            <th class="text-end">Đơn giá / lượt</th>
                            <th class="text-center">Số lượng</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cue in Model.RentalCues)
                        {
                            <tr>
                                <td class="fw-semibold">@cue.Name</td>
                                <td class="text-end fw-bold text-primary">@cue.Price.ToString("N0") ₫/lượt</td>
                                <td class="text-center">@cue.StockQuantity cây</td>
                                <td>
                                    @if (cue.IsActive)
                                    {
                                        <span class="badge-active">Đang cho thuê</span>
                                    }
                                    else
                                    {
                                        <span class="badge-inactive">Tạm ngưng</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Index" asp-route-editCueId="@cue.Id" class="btn-outline-bms py-1 px-2" style="font-size:0.75rem">
                                        <i class="bi bi-pencil"></i> Sửa
                                    </a>
                                    <form asp-action="ToggleCueStatus" method="post" class="d-inline ms-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@cue.Id" />
                                        <button type="submit" class="btn-outline-bms py-1 px-2" style="font-size:0.75rem">
                                            @(cue.IsActive ? "Đóng" : "Mở")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.RentalCues.Any())
                        {
                            <tr><td colspan="5" class="text-center py-4 text-muted">Chưa có danh mục gậy cho thuê.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════════ -->
<!-- PHẦN 3: KHUYẾN MÃI COMBO GIỜ CHƠI + TẶNG KÈM NƯỚC / ĐỒ ĂN              -->
<!-- ═══════════════════════════════════════════════════════════════════════ -->
<div class="row g-3">
    <div class="col-lg-4">
        <div class="data-card p-4 h-100">
            <h2 class="h6 fw-bold mb-2">
                <i class="bi bi-cup-straw me-2 text-success"></i>@(editCombo != null ? $"Chỉnh sửa Combo #{editCombo.Id}" : "3. Tạo Khuyến mãi Combo Giờ chơi")
            </h2>
            <p class="text-muted mb-3" style="font-size:0.8rem">
                Thiết lập gói khuyến mãi giờ chơi kèm tặng nước/món (VD: Chơi 2 tiếng mua Combo được tặng 2 ly Trà đào).
            </p>

            <form asp-action="SaveCombo" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@(editCombo?.Id ?? 0)" />

                <div class="mb-2">
                    <label class="form-label">Tên gói khuyến mãi Combo <span class="text-danger">*</span></label>
                    <input type="text" name="name" value="@(editCombo?.Name ?? "")" class="form-control"
                           placeholder="VD: Combo 2 Giờ Chơi + Tặng 2 Trà Đào" required maxlength="100" />
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label">Số giờ chơi <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="number" name="playtimeHours" value="@((editCombo?.PlaytimeHours ?? 2.0m).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))"
                                   min="0.5" max="24" step="0.5" class="form-control" required />
                            <span class="input-group-text">giờ</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Giá trọn gói (₫) <span class="text-danger">*</span></label>
                        <input type="number" name="price" value="@((editCombo?.Price ?? 190000m).ToString("0"))"
                               min="0" step="5000" class="form-control" required />
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-8">
                        <label class="form-label">Nước / Món tặng kèm trong Combo</label>
                        <select name="bonusProductId" class="form-select">
                            <option value="">-- Chọn nước / đồ ăn tặng kèm --</option>
                            @foreach (var prod in Model.AvailableBonusProducts)
                            {
                                <option value="@prod.Id" selected="@(editCombo?.BonusProductId == prod.Id)">
                                    @prod.Name (Giá lẻ @prod.Price.ToString("N0")₫)
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-4">
                        <label class="form-label">SL tặng</label>
                        <input type="number" name="bonusQuantity" value="@(editCombo?.BonusQuantity ?? 2)"
                               min="1" max="20" class="form-control" />
                    </div>
                </div>

                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" name="isActive" value="true" id="comboActiveSwitch"
                           checked="@(editCombo?.IsActive ?? true)" />
                    <label class="form-check-label" for="comboActiveSwitch" style="font-size:0.85rem">Mở áp dụng gói Combo này</label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn-primary-bms flex-grow-1 justify-content-center">
                        <i class="bi bi-check-lg"></i> @(editCombo != null ? "Lưu cập nhật Combo" : "Tạo gói Combo")
                    </button>
                    @if (editCombo != null)
                    {
                        <a asp-action="Index" class="btn-outline-bms">Hủy</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="data-card h-100">
            <div class="data-card-header">
                <span class="data-card-title">
                    <i class="bi bi-stars me-1 text-warning"></i> Danh sách các gói Khuyến mãi Combo Giờ chơi (@Model.Combos.Count)
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Tên gói Combo</th>
                            <th class="text-center">Thời lượng</th>
                            <th>Quà tặng kèm (Nước / Đồ ăn)</th>
                            <th class="text-end">Giá trọn gói</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Combos)
                        {
                            <tr>
                                <td class="fw-bold">@c.Name</td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">@c.PlaytimeHours.ToString("0.#") giờ</span>
                                </td>
                                <td>
                                    <span class="text-success fw-semibold"><i class="bi bi-gift-fill me-1"></i>@c.IncludedItemsSummary</span>
                                </td>
                                <td class="text-end fw-bold text-danger">@c.Price.ToString("N0") ₫</td>
                                <td>
                                    @if (c.IsActive)
                                    {
                                        <span class="badge-active">Đang mở</span>
                                    }
                                    else
                                    {
                                        <span class="badge-inactive">Đã đóng</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Index" asp-route-editComboId="@c.Id" class="btn-outline-bms py-1 px-2" style="font-size:0.75rem">
                                        <i class="bi bi-pencil"></i> Sửa
                                    </a>
                                    <form asp-action="ToggleComboStatus" method="post" class="d-inline ms-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <button type="submit" class="btn-outline-bms py-1 px-2" style="font-size:0.75rem">
                                            @(c.IsActive ? "Đóng" : "Mở")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Combos.Any())
                        {
                            <tr><td colspan="6" class="text-center py-4 text-muted">Chưa có gói khuyến mãi Combo giờ chơi nào.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
