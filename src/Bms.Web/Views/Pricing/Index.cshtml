@model Bms.Web.Models.PricingListViewModel
@{
    ViewData["Title"] = "Bảng giá";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="data-card">
    <div class="data-card-header">
        <span class="data-card-title"><i class="bi bi-currency-dollar me-1"></i> Bảng giá theo khung giờ</span>
        <a asp-action="Create" class="btn-primary-bms">
            <i class="bi bi-plus-lg"></i> Thêm mức giá
        </a>
    </div>

    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>Loại bàn</th>
                <th>Giờ bắt đầu</th>
                <th>Giờ kết thúc</th>
                <th>Giá / giờ</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Configs)
            {
                <tr>
                    <td><strong>@p.TableTypeName</strong></td>
                    <td>@p.StartHour</td>
                    <td>@p.EndHour</td>
                    <td><strong>@p.HourlyRate.ToString("N0") ₫</strong></td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn-sm-icon" title="Sửa">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-sm-icon danger" title="Xóa"
                                    onclick="return confirm('Xóa mức giá này?')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Configs.Any())
            {
                <tr><td colspan="5" class="text-center py-4 text-muted">Chưa có cấu hình giá nào.</td></tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-3" style="font-size:0.82rem;color:#64748b">
    <i class="bi bi-info-circle me-1"></i>
    Cấu hình giá theo loại bàn và giờ trong ngày, không cho phép trùng khung giờ cùng loại bàn. Module mở phiên cần đọc cấu hình này khi tính giá.
</div>
