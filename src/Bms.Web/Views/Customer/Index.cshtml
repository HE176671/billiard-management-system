@model Bms.Web.Models.CustomerBookingDashboardViewModel
@{
    ViewData["Title"] = "Đặt bàn trực tuyến";
    Layout = "_AdminLayout";
    var defaultIso = Model.DefaultStartLocal.ToString("yyyy-MM-ddTHH:mm");
    var minIso = Model.MinStartLocal.ToString("yyyy-MM-ddTHH:mm");
    var maxIso = Model.MaxStartLocal.ToString("yyyy-MM-ddTHH:mm");
}

<!-- ===================================================================== -->
<!-- PHẦN 1: CSS TÙY CHỈNH & THÔNG BÁO TEMPDATA                            -->
<!-- ===================================================================== -->

<style>
    .booking-table-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 1rem;
    }
    .booking-table-card {
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 1rem;
        background: #fff;
        cursor: pointer;
        transition: all 0.15s ease;
        position: relative;
    }
    .booking-table-card:hover:not(.disabled) {
        border-color: #94a3b8;
        transform: translateY(-2px);
    }
    .booking-table-card.selected {
        border-color: #e94560;
        background: rgba(233, 69, 96, 0.04);
        box-shadow: 0 4px 12px rgba(233, 69, 96, 0.15);
    }
    .booking-table-card.disabled {
        background: #f8fafc;
        border-color: #e2e8f0;
        opacity: 0.65;
        cursor: not-allowed;
    }
    .policy-banner {
        background: #fff8f1;
        border: 1px solid #fed7aa;
        color: #9a3412;
        border-radius: 10px;
        padding: 0.85rem 1.15rem;
        font-size: 0.85rem;
    }
</style>

@if (TempData["BookingError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["BookingError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="data-card p-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h5 class="mb-1 fw-bold">🎱 Đặt bàn trực tuyến</h5>
            <p class="text-muted small mb-0">Chọn thời gian đến và chọn bàn trước theo nhu cầu của bạn.</p>
        </div>
        <a asp-controller="Customer" asp-action="History" class="btn btn-outline-bms">
            <i class="bi bi-clock-history"></i> Xem Lịch đặt bàn của tôi
        </a>
    </div>

    <div class="policy-banner mb-4">
        <div class="fw-bold mb-1"><i class="bi bi-info-circle-fill me-1"></i> Quy định đặt bàn của quán:</div>
        <ul class="mb-0 ps-3">
            <li>Được đặt trước tối đa <strong>15 ngày</strong>. Quán giữ bàn cho bạn trong vòng <strong>15 phút</strong> kể từ giờ hẹn (quá 15 phút chưa đến hệ thống tự động hủy giữ chỗ).</li>
            <li>Khi bắt đầu chơi sẽ <strong>không giới hạn thời gian</strong>, khách tự chủ động giờ nghỉ và <strong>tính tiền theo số phút thực tế</strong> (trừ trường hợp bàn có lịch đặt kế tiếp thì cần trống bàn hoặc chuyển bàn trước giờ hẹn tiếp theo 5 phút).</li>
            <li>Nếu bàn bạn chọn đang có ca chơi trước đó chưa kết thúc kịp, quán cam kết <strong>ưu tiên chuyển bàn hoặc bố trí ngay bàn trống cùng hạng tương đương</strong> khi bạn đến Check-in.</li>
        </ul>
    </div>

    <form asp-controller="Customer" asp-action="CreateBooking" method="post" id="customer-booking-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="TableId" id="selected-table-id" value="" />

        <!-- ============================================================= -->
        <!-- PHẦN 2: CHỌN THỜI GIAN ĐẾN & GHI CHÚ YÊU CẦU                  -->
        <!-- ============================================================= -->
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label fw-semibold">1. Chọn ngày & giờ đến (Tối đa 15 ngày tới)</label>
                <input type="hidden" id="input-start-time" name="StartTimeLocal" value="@defaultIso" />
                @{
                    var startDay = Model.MinStartLocal.Date;
                    var defaultDateStr = Model.DefaultStartLocal.ToString("yyyy-MM-dd");
                    var defaultHour = Model.DefaultStartLocal.Hour;
                    var defaultMinute = Model.DefaultStartLocal.Minute;
                    string[] vnDayNames = { "Chủ Nhật", "Thứ Hai", "Thứ Ba", "Thứ Tư", "Thứ Năm", "Thứ Sáu", "Thứ Bảy" };
                }
                <div class="row g-2">
                    <div class="col-6">
                        <select class="form-select" id="select-booking-date" aria-label="Ngày đến">
                            @for (int d = 0; d <= Bms.Web.Models.BookingPolicy.MaxAdvanceDays; d++)
                            {
                                var curDate = startDay.AddDays(d);
                                var valStr = curDate.ToString("yyyy-MM-dd");
                                var dayLabel = d == 0 ? "Hôm nay" : d == 1 ? "Ngày mai" : vnDayNames[(int)curDate.DayOfWeek];
                                <option value="@valStr" selected="@(valStr == defaultDateStr)">
                                    @dayLabel — @curDate.ToString("dd/MM/yyyy")
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-3">
                        <select class="form-select" id="select-booking-hour" aria-label="Giờ đến (24h)">
                            @for (int h = 0; h < 24; h++)
                            {
                                <option value="@h.ToString("D2")" selected="@(h == defaultHour)">
                                    @h.ToString("D2") giờ
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-3">
                        <select class="form-select" id="select-booking-minute" aria-label="Phút đến">
                            @for (int m = 0; m < 60; m += 5)
                            {
                                <option value="@m.ToString("D2")" selected="@(m == defaultMinute)">
                                    @m.ToString("D2") phút
                                </option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-text">Hệ thống sẽ kiểm tra và hiển thị các bàn trống tương ứng với giờ bạn chọn.</div>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold" for="input-notes">Ghi chú yêu cầu (Tùy chọn)</label>
                <input type="text"
                       class="form-control"
                       id="input-notes"
                       name="Notes"
                       maxlength="300"
                       placeholder="Ví dụ: Cần chuẩn bị gậy riêng, đi nhóm 4 người..." />
            </div>
        </div>

        <!-- ============================================================= -->
        <!-- PHẦN 3: LƯỚI CHỌN BÀN TRƯỚC & NÚT XÁC NHẬN ĐẶT BÀN            -->
        <!-- ============================================================= -->
        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label fw-semibold mb-0">2. Chọn bàn trước</label>
                <span class="small text-muted" id="tables-loading-indicator" style="display:none;">
                    <span class="spinner-border spinner-border-sm me-1"></span>Đang kiểm tra bàn khả dụng...
                </span>
            </div>

            <div class="booking-table-grid" id="bookable-tables-grid">
                @foreach (var table in Model.AvailableTables)
                {
                    var disabledClass = table.IsBookableAtSelectedTime ? "" : "disabled";
                    <div class="booking-table-card @disabledClass"
                         data-table-id="@table.TableId"
                         data-table-code="@table.TableCode"
                         data-bookable="@(table.IsBookableAtSelectedTime ? "true" : "false")">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fs-5 fw-bold">@table.TableCode</span>
                            @if (table.IsBookableAtSelectedTime)
                            {
                                <span class="badge bg-success">Khả dụng</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Không khả dụng</span>
                            }
                        </div>
                        <div class="small text-muted mb-1">
                            Loại bàn: <strong class="text-dark">@table.TableTypeName</strong> · Tầng @table.FloorNumber
                        </div>
                        <div class="small text-muted">
                            Đơn giá: <strong class="text-danger">@table.HourlyRate.ToString("N0") ₫/giờ</strong>
                        </div>
                        @if (!table.IsBookableAtSelectedTime && !string.IsNullOrEmpty(table.UnavailableReason))
                        {
                            <div class="small text-danger mt-2 fw-semibold">
                                <i class="bi bi-x-circle me-1"></i>@table.UnavailableReason
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="d-flex justify-content-end align-items-center gap-3 pt-3 border-top">
            <span class="text-muted small" id="selected-table-summary">Chưa chọn bàn nào</span>
            <button type="submit" class="btn-primary-bms px-4 py-2" id="btn-submit-booking" disabled>
                <i class="bi bi-calendar2-check"></i> <span id="btn-submit-text">Vui lòng chọn bàn</span>
            </button>
        </div>
    </form>
</div>

<!-- ===================================================================== -->
<!-- PHẦN 4: JAVASCRIPT CHỌN BÀN & KIỂM TRA BÀN TRỐNG THEO GIỜ (AJAX)      -->
<!-- ===================================================================== -->
@section Scripts {
    <script>
        (() => {
            const grid = document.getElementById('bookable-tables-grid');
            const hiddenInput = document.getElementById('selected-table-id');
            const summaryText = document.getElementById('selected-table-summary');
            const btnSubmit = document.getElementById('btn-submit-booking');
            const btnSubmitText = document.getElementById('btn-submit-text');
            const timeInput = document.getElementById('input-start-time');
            const selectDate = document.getElementById('select-booking-date');
            const selectHour = document.getElementById('select-booking-hour');
            const selectMinute = document.getElementById('select-booking-minute');
            const loadingEl = document.getElementById('tables-loading-indicator');

            function selectTable(card) {
                if (!card || card.getAttribute('data-bookable') !== 'true') return;

                grid.querySelectorAll('.booking-table-card').forEach(c => c.classList.remove('selected'));
                card.classList.add('selected');

                const id = card.getAttribute('data-table-id');
                const code = card.getAttribute('data-table-code');
                hiddenInput.value = id;
                summaryText.textContent = `Đã chọn bàn ${code}`;
                btnSubmit.disabled = false;
                btnSubmitText.textContent = `Xác nhận Đặt bàn ${code}`;
            }

            function clearSelection() {
                hiddenInput.value = '';
                summaryText.textContent = 'Chưa chọn bàn nào';
                btnSubmit.disabled = true;
                btnSubmitText.textContent = 'Vui lòng chọn bàn';
            }

            if (grid) {
                grid.addEventListener('click', (e) => {
                    const card = e.target.closest('.booking-table-card');
                    if (card) selectTable(card);
                });

                // Tự động chọn bàn khả dụng đầu tiên
                const firstAvailable = grid.querySelector('.booking-table-card[data-bookable="true"]');
                if (firstAvailable) selectTable(firstAvailable);
            }

            if (timeInput && selectDate && selectHour && selectMinute) {
                const syncAndRefreshTables = async () => {
                    const val = `${selectDate.value}T${selectHour.value}:${selectMinute.value}`;
                    timeInput.value = val;
                    if (!val) return;

                    if (loadingEl) loadingEl.style.display = 'inline-block';
                    clearSelection();

                    try {
                        const resp = await fetch(`/Customer/GetBookableTables?startTimeLocal=${encodeURIComponent(val)}`);
                        if (!resp.ok) return;
                        const data = await resp.json();
                        if (!data || !data.tables) return;

                        grid.replaceChildren();
                        data.tables.forEach(t => {
                            const isBookable = Boolean(t.isBookableAtSelectedTime ?? t.IsBookableAtSelectedTime);
                            const tableId = t.tableId ?? t.TableId;
                            const tableCode = t.tableCode ?? t.TableCode;
                            const typeName = t.tableTypeName ?? t.TableTypeName;
                            const floor = t.floorNumber ?? t.FloorNumber;
                            const rate = Number(t.hourlyRate ?? t.HourlyRate ?? 0).toLocaleString('vi-VN');
                            const reason = t.unavailableReason ?? t.UnavailableReason;

                            const card = document.createElement('div');
                            card.className = `booking-table-card ${isBookable ? '' : 'disabled'}`;
                            card.setAttribute('data-table-id', tableId);
                            card.setAttribute('data-table-code', tableCode);
                            card.setAttribute('data-bookable', isBookable ? 'true' : 'false');

                            card.innerHTML = `
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fs-5 fw-bold">${tableCode}</span>
                                    <span class="badge ${isBookable ? 'bg-success' : 'bg-secondary'}">
                                        ${isBookable ? 'Khả dụng' : 'Không khả dụng'}
                                    </span>
                                </div>
                                <div class="small text-muted mb-1">
                                    Loại bàn: <strong class="text-dark">${typeName}</strong> · Tầng ${floor}
                                </div>
                                <div class="small text-muted">
                                    Đơn giá: <strong class="text-danger">${rate} ₫/giờ</strong>
                                </div>
                                ${!isBookable && reason ? `<div class="small text-danger mt-2 fw-semibold"><i class="bi bi-x-circle me-1"></i>${reason}</div>` : ''}
                            `;
                            grid.appendChild(card);
                        });

                        const firstAvail = grid.querySelector('.booking-table-card[data-bookable="true"]');
                        if (firstAvail) selectTable(firstAvail);
                    } finally {
                        if (loadingEl) loadingEl.style.display = 'none';
                    }
                };

                selectDate.addEventListener('change', syncAndRefreshTables);
                selectHour.addEventListener('change', syncAndRefreshTables);
                selectMinute.addEventListener('change', syncAndRefreshTables);
            }
        })();
    </script>
}
