@{
    ViewData["Title"] = "Trang khách hàng";
}

<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <section class="card border-0 shadow-sm overflow-hidden">
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center"
                             style="width: 56px; height: 56px; font-size: 1.75rem"
                             aria-hidden="true">
                            🎱
                        </div>
                        <div>
                            <span class="badge text-bg-primary mb-1">Khu vực khách hàng</span>
                            <h1 class="h3 mb-0">Xin chào, @User.Identity?.Name!</h1>
                        </div>
                    </div>

                    <p class="text-secondary mb-4">
                        Chào mừng bạn đến với Billiard Management System. Đây là trang tổng quan
                        dành cho tài khoản khách hàng của bạn.
                    </p>

                    <div class="alert alert-info d-flex gap-2 align-items-start mb-4" role="status">
                        <span aria-hidden="true">ℹ️</span>
                        <div>
                            <strong>Các tính năng khách hàng đang được phát triển.</strong>
                            <div class="small mt-1">
                                Chức năng đặt bàn và xem lịch sử đặt bàn sẽ được bổ sung tại đây.
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <a asp-controller="Profile" asp-action="ChangePassword"
                           class="btn btn-outline-secondary">
                            Đổi mật khẩu
                        </a>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger">Đăng xuất</button>
                        </form>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>
