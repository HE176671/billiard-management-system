@model Bms.Web.Models.RevenueTargetIndexViewModel
@using Bms.Web.Services
@{
    ViewData["Title"] = "Mục tiêu doanh thu";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string Badge(RevenueTargetProgress p) => p.StatusText switch
    {
        "Đạt" or "Đúng tiến độ" => "bg-success",
        "Không đạt" or "Chậm tiến độ" => "bg-danger",
        _ => "bg-secondary"
    };
    string Bar(decimal pct) => pct >= 100 ? "bg-success" : pct >= 70 ? "bg-warning" : "bg-danger";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">
        Đặt mục tiêu cho từng tháng; thực thu lấy trực tiếp từ <code>PaymentTransactions</code>, cùng nguồn với Báo cáo doanh thu.
    </p>
    <a asp-action="Create" class="btn-primary-bms"><i class="bi bi-plus-lg"></i> Đặt mục tiêu</a>
</div>

@if (Model.Current is { } c)
{
    <div class="form-card mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="mb-0">Tháng này (@c.Label) — ngày @c.DaysElapsed/@c.DaysInMonth</h6>
            <span class="badge @Badge(c)">@c.StatusText</span>
        </div>
        <div class="progress mb-3" style="height:14px" role="progressbar" aria-valuenow="@c.PercentAchieved" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar @Bar(c.PercentAchieved)" style="width:@Math.Min(100, c.PercentAchieved).ToString(System.Globalization.CultureInfo.InvariantCulture)%">@c.PercentAchieved%</div>
        </div>
        <div class="row g-3 text-center">
            <div class="col-6 col-md-3"><div class="stat-label">Mục tiêu</div><div class="fw-semibold">@c.TargetAmount.ToString("N0") ₫</div></div>
            <div class="col-6 col-md-3"><div class="stat-label">Đã thu</div><div class="fw-semibold text-success">@c.ActualRevenue.ToString("N0") ₫</div></div>
            <div class="col-6 col-md-3"><div class="stat-label">Dự báo cuối tháng</div><div class="fw-semibold">@c.ForecastRevenue.ToString("N0") ₫</div></div>
            <div class="col-6 col-md-3"><div class="stat-label">Cần thu mỗi ngày còn lại</div><div class="fw-semibold @(c.Achieved ? "text-success" : "text-danger")">@(c.Achieved ? "Đã đạt" : c.RequiredPerDay.ToString("N0") + " ₫")</div></div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning mb-4">
        <i class="bi bi-exclamation-triangle me-1"></i> Tháng này chưa có mục tiêu doanh thu.
        <a asp-action="Create" class="alert-link">Đặt ngay</a>
    </div>
}

<div class="data-card">
    <div class="data-card-header">
        <span class="data-card-title"><i class="bi bi-bullseye me-1 text-primary"></i> Các mục tiêu</span>
        @if (Model.EndedCount > 0)
        {
            <span class="text-muted small">Đạt @Model.AchievedCount/@Model.EndedCount tháng đã kết thúc</span>
        }
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Tháng</th>
                    <th class="text-end">Mục tiêu</th>
                    <th class="text-end">Thực thu</th>
                    <th style="min-width:160px">% đạt</th>
                    <th>Trạng thái</th>
                    <th>Ghi chú</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Items)
                {
                    <tr>
                        <td><strong>@p.Label</strong></td>
                        <td class="text-end">@p.TargetAmount.ToString("N0")</td>
                        <td class="text-end">@(p.State == TargetMonthState.Future ? "—" : p.ActualRevenue.ToString("N0"))</td>
                        <td>
                            @if (p.State != TargetMonthState.Future)
                            {
                                <div class="progress" style="height:10px">
                                    <div class="progress-bar @Bar(p.PercentAchieved)" style="width:@Math.Min(100, p.PercentAchieved).ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                </div>
                                <small>@p.PercentAchieved%</small>
                            }
                        </td>
                        <td><span class="badge @Badge(p)">@p.StatusText</span></td>
                        <td class="text-muted small">@p.Note</td>
                        <td class="text-end text-nowrap">
                            @if (p.State != TargetMonthState.Ended)
                            {
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn-sm-icon" title="Sửa"><i class="bi bi-pencil"></i></a>
                            }
                            @if (p.State == TargetMonthState.Future)
                            {
                                <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Xóa mục tiêu tháng @p.Label?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-sm-icon text-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="7" class="text-center py-4 text-muted">Chưa có mục tiêu nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
