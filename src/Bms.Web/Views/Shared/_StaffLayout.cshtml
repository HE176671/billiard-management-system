<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — BMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/table-management.css" asp-append-version="true" />
</head>
<body class="staff-layout-body">
    <!-- Topbar: BMS - TABLE MANAGEMENT SCREEN & User actions -->
    <header class="staff-topbar">
        <div class="topbar-brand">
            <span class="brand-title">BMS - TABLE MANAGEMENT SCREEN</span>
        </div>
        <div class="topbar-user-area">
            <div class="user-chip">
                <i class="bi bi-person-fill user-icon"></i>
                <span class="user-role-label">Thu ngân</span>
                <span class="user-name">@(User.Identity?.Name ?? "Nhân viên")</span>
            </div>
            <a asp-controller="Profile" asp-action="ChangePassword" class="btn-topbar-action" title="Đổi mật khẩu">
                <i class="bi bi-shield-lock"></i>
                <span>Đổi mật khẩu</span>
            </a>
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-topbar-action btn-logout" title="Đăng xuất">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Đăng xuất</span>
                </button>
            </form>
        </div>
    </header>

    <!-- Main Content: Full-width layout -->
    <main class="staff-main-container">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
