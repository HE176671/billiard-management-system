@inject Bms.Web.Data.ApplicationDbContext LayoutDb
@using Microsoft.EntityFrameworkCore
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — BMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/table-management.css" asp-append-version="true" />
</head>
<body class="staff-layout-body">
    <!-- Sidebar cố định bên trái đồng bộ toàn diện với _AdminLayout -->
    <nav class="sidebar">
        <div class="sidebar-brand">
            <div class="logo">🎱 BMS</div>
            <span class="logo-sub">Billiard Management System</span>
        </div>
        @{
            var curController = ViewContext.RouteData.Values["controller"]?.ToString();
            var curAction = ViewContext.RouteData.Values["action"]?.ToString();
            var isAdmin = User.IsInRole("Admin");
            var isManager = User.IsInRole("Manager");
            var isStaff = User.IsInRole("Staff") && !isManager && !isAdmin;
            var curUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            int pendingAdjustCount = 0;
            int unreadNotiCount = 0;
            int pendingOrderCount = 0;
            try
            {
                if (isManager || isAdmin)
                {
                    pendingAdjustCount = await LayoutDb.PointAdjustmentRequests.AsNoTracking()
                        .CountAsync(r => r.Status == Bms.Web.Data.PointAdjustmentRequest.StatusPending);
                }
                if (!string.IsNullOrEmpty(curUserId))
                {
                    unreadNotiCount = await LayoutDb.Notifications.AsNoTracking()
                        .CountAsync(n => n.UserId == curUserId && !n.IsRead);
                }
                pendingOrderCount = await LayoutDb.Orders.AsNoTracking()
                    .CountAsync(o => o.Status == "Pending");
            }
            catch { /* Bỏ qua nếu DB đang nâng cấp */ }

            string Active(string c, string? a = null) =>
                curController == c && (a == null || curAction == a) ? "active" : "";

            string roleLabel = isAdmin && !isManager
                ? "Admin (Phân quyền)"
                : isManager
                    ? "Manager (Quản lý)"
                    : "Staff (Nhân viên)";
        }
        <div class="sidebar-nav">
            @if (isAdmin && !isManager)
            {
                <div class="nav-section-label">Quản trị hệ thống</div>
                <a class="sidebar-link @Active("RoleManagement")" asp-controller="RoleManagement" asp-action="Index">
                    <i class="bi bi-shield-lock"></i> Phân quyền tài khoản
                </a>
                <a class="sidebar-link @Active("Employee")" asp-controller="Employee" asp-action="Index">
                    <i class="bi bi-people"></i> Nhân viên
                </a>
            }

            @if (isManager)
            {
                <div class="nav-section-label">Quản lý Vận hành</div>
                <a class="sidebar-link @Active("Dashboard")" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Tổng quan hoạt động
                </a>
                <a class="sidebar-link @Active("Revenue")" asp-controller="Revenue" asp-action="Index">
                    <i class="bi bi-graph-up"></i> Báo cáo doanh thu
                </a>
                <a class="sidebar-link @Active("Shift", "Manage")" asp-controller="Shift" asp-action="Manage">
                    <i class="bi bi-clipboard-check"></i> Quản lý ca
                </a>
                <a class="sidebar-link @Active("Employee")" asp-controller="Employee" asp-action="Index">
                    <i class="bi bi-people"></i> Quản lý nhân viên
                </a>
                <a class="sidebar-link @Active("Pricing")" asp-controller="Pricing" asp-action="Index">
                    <i class="bi bi-tags"></i> Bảng giá &amp; Combo dịch vụ
                </a>
                <a class="sidebar-link @Active("Table")" asp-controller="Table" asp-action="Index">
                    <i class="bi bi-grid-3x3"></i> Quản lý bàn
                </a>

                <div class="nav-section-label">F&amp;B &amp; Kho hàng</div>
                <a class="sidebar-link @Active("Product")" asp-controller="Product" asp-action="Index">
                    <i class="bi bi-cup-straw"></i> Thực đơn &amp; Món
                </a>
                <a class="sidebar-link @Active("Combo")" asp-controller="Combo" asp-action="Index">
                    <i class="bi bi-box2-heart"></i> Gói Combo
                </a>
                <a class="sidebar-link @Active("Inventory")" asp-controller="Inventory" asp-action="Index">
                    <i class="bi bi-boxes"></i> Quản lý kho hàng
                </a>

                <div class="nav-section-label">Quản lý Hội viên &amp; Ưu đãi</div>
                <a class="sidebar-link @Active("CrmDashboard")" asp-controller="CrmDashboard" asp-action="Index">
                    <i class="bi bi-bar-chart-line"></i> Thống kê hội viên
                </a>
                <a class="sidebar-link @(curController == "CustomerManagement" && (curAction == "Index" || curAction == "Profile") ? "active" : "")"
                   asp-controller="CustomerManagement" asp-action="Index">
                    <i class="bi bi-person-lines-fill"></i> Tra cứu hội viên
                </a>
                <a class="sidebar-link @(curController == "PointAdjustment" ? "active" : "")"
                   asp-controller="PointAdjustment" asp-action="Pending">
                    <i class="bi bi-clipboard2-check"></i> Duyệt điều chỉnh điểm
                    @if (pendingAdjustCount > 0)
                    {
                        <span class="badge-count">@pendingAdjustCount</span>
                    }
                </a>
                <a class="sidebar-link @Active("TierConfig")" asp-controller="TierConfig" asp-action="Index">
                    <i class="bi bi-award"></i> Hạng thành viên
                </a>
                <a class="sidebar-link @Active("RewardItem")" asp-controller="RewardItem" asp-action="Index">
                    <i class="bi bi-gift"></i> Quà đổi điểm
                </a>
            }

            @if (isStaff || (!isAdmin && !isManager))
            {
                <div class="nav-section-label">Hội viên &amp; Tại quầy</div>
                <a class="sidebar-link @(curController == "CustomerManagement" && (curAction == "Index" || curAction == "Profile") ? "active" : "")"
                   asp-controller="CustomerManagement" asp-action="Index">
                    <i class="bi bi-person-lines-fill"></i> Tra cứu hội viên
                </a>
                <a class="sidebar-link @Active("PointAdjustment")"
                   asp-controller="PointAdjustment" asp-action="Index">
                    <i class="bi bi-sliders"></i> Lập phiếu điều chỉnh điểm
                </a>
                <a class="sidebar-link @Active("LoyaltyTest")"
                   asp-controller="LoyaltyTest" asp-action="Index">
                    <i class="bi bi-receipt-cutoff"></i> Tính tiền &amp; Tích điểm
                </a>

                <div class="nav-section-label">Nghiệp vụ ca làm &amp; F&amp;B</div>
                <a class="sidebar-link @(curController == "Shift" && curAction != "Manage" ? "active" : "")" asp-controller="Shift" asp-action="Index"><i class="bi bi-cash-coin"></i> Ca của tôi</a>
                <a class="sidebar-link @Active("Table")" asp-controller="Table" asp-action="Index"><i class="bi bi-grid-3x3"></i> Quản lý bàn</a>
                <a class="sidebar-link @Active("Order")" asp-controller="Order" asp-action="Service">
                    <i class="bi bi-bell"></i> Phục vụ F&amp;B
                    @if (pendingOrderCount > 0)
                    {
                        <span class="badge-count global-qr-pending-badge">@pendingOrderCount</span>
                    }
                </a>
                <a class="sidebar-link @Active("Product")" asp-controller="Product" asp-action="Index"><i class="bi bi-cup-straw"></i> Thực đơn &amp; Món</a>
                <a class="sidebar-link @Active("Combo")" asp-controller="Combo" asp-action="Index"><i class="bi bi-box2-heart"></i> Gói Combo</a>
                <a class="sidebar-link @Active("Inventory")" asp-controller="Inventory" asp-action="Index"><i class="bi bi-boxes"></i> Quản lý kho hàng</a>
            }
        </div>
        <div class="sidebar-footer">
            @{
                var userName = User.Identity?.Name?.Trim();
                var initialChar = !string.IsNullOrEmpty(userName) ? char.ToUpper(userName[0]).ToString() : "?";
                var displayName = !string.IsNullOrEmpty(userName) ? userName : "Nhân viên";
            }
            <div class="user-chip">
                <div class="user-avatar">@initialChar</div>
                <div>
                    <div class="user-name">@displayName</div>
                    <div class="user-role">@roleLabel</div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Wrapper -->
    <div class="main-wrapper">
        <header class="topbar">
            <span class="topbar-title">@ViewData["Title"]</span>
            <div class="topbar-actions">
                @if (isStaff)
                {
                    <a asp-controller="Order" asp-action="Service" class="btn-logout" title="Đơn QR chờ duyệt">
                        <i class="bi bi-cup-straw text-warning"></i> Đơn QR
                        @if (pendingOrderCount > 0)
                        {
                            <span class="badge rounded-pill bg-warning text-dark global-qr-pending-badge" style="font-size:0.65rem">@pendingOrderCount</span>
                        }
                    </a>
                }
                <a asp-controller="Profile" asp-action="Index" class="btn-logout" title="Hồ sơ cá nhân">
                    <i class="bi bi-person-circle"></i> Hồ sơ
                </a>
                <a asp-controller="Notification" asp-action="Index" class="btn-logout" title="Thông báo">
                    <i class="bi bi-bell"></i> Thông báo
                    @if (unreadNotiCount > 0)
                    {
                        <span class="badge rounded-pill bg-danger" style="font-size:0.65rem">@unreadNotiCount</span>
                    }
                </a>
                <a asp-controller="Profile" asp-action="ChangePassword" class="btn-logout" title="Đổi mật khẩu">
                    <i class="bi bi-shield-lock"></i> Đổi mật khẩu
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-logout" title="Đăng xuất">
                        <i class="bi bi-box-arrow-right"></i> Đăng xuất
                    </button>
                </form>
            </div>
        </header>

        <main class="page-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/bms-number-validator.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        (function() {
            try {
                const conn = new signalR.HubConnectionBuilder()
                    .withUrl("/hubs/order")
                    .withAutomaticReconnect()
                    .build();

                conn.on("ReceiveNewOrder", function (data) {
                    document.querySelectorAll('.global-qr-pending-badge').forEach(el => {
                        const current = parseInt(el.textContent || '0') || 0;
                        el.textContent = current + 1;
                        el.style.display = 'inline-block';
                    });
                });

                conn.on("OrderConfirmed", function() {
                    document.querySelectorAll('.global-qr-pending-badge').forEach(el => {
                        const current = parseInt(el.textContent || '0') || 0;
                        if (current > 1) el.textContent = current - 1;
                        else el.style.display = 'none';
                    });
                });

                conn.on("OrderRejected", function() {
                    document.querySelectorAll('.global-qr-pending-badge').forEach(el => {
                        const current = parseInt(el.textContent || '0') || 0;
                        if (current > 1) el.textContent = current - 1;
                        else el.style.display = 'none';
                    });
                });

                conn.start().then(() => conn.invoke("JoinStaffGroup")).catch(() => {});
            } catch(e) {}
        })();
    </script>
</body>
</html>
