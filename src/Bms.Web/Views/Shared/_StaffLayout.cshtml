<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — BMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/table-management.css" asp-append-version="true" />
</head>
<body class="staff-layout-body">
    <!-- Sidebar cố định bên trái phong cách _AdminLayout -->
    <nav class="sidebar">
        <div class="sidebar-brand">
            <div class="logo">🎱 BMS</div>
            <span class="logo-sub">Billiard Management System</span>
        </div>
        <div class="sidebar-nav">
            <div class="nav-section-label">NGHIỆP VỤ</div>
            <a class="sidebar-link active" asp-controller="Table" asp-action="Index">
                <i class="bi bi-grid-3x3"></i> Quản lý bàn
            </a>
        </div>
        <div class="sidebar-footer">
            @{
                var userName = User.Identity?.Name?.Trim();
                var initialChar = !string.IsNullOrEmpty(userName) ? char.ToUpper(userName[0]).ToString() : "?";
                var displayName = !string.IsNullOrEmpty(userName) ? userName : "Nhân viên";
                var roleName = User.IsInRole("Admin") ? "Administrator" : "Staff";
            }
            <div class="user-chip">
                <div class="user-avatar">@initialChar</div>
                <div>
                    <div class="user-name">@displayName</div>
                    <div class="user-role">@roleName</div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Wrapper -->
    <div class="main-wrapper">
        <header class="topbar">
            <span class="topbar-title">@ViewData["Title"]</span>
            <div class="topbar-actions">
                <a asp-controller="Profile" asp-action="ChangePassword" class="btn-logout" title="Đổi mật khẩu">
                    <i class="bi bi-shield-lock"></i> Đổi mật khẩu
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-logout" title="Đăng xuất">
                        <i class="bi bi-box-arrow-right"></i> Đăng xuất
                    </button>
                </form>
            </div>
        </header>

        <main class="page-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
