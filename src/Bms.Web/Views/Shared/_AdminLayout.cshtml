<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — BMS Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --sidebar-width: 240px;
            --primary:   #e94560;
            --primary-dark: #c62a47;
            --bg-dark:   #0f172a;
            --bg-sidebar:#1e293b;
            --bg-card:   #ffffff;
            --text-muted-light: #94a3b8;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: 'Segoe UI', system-ui, sans-serif;
            background: #f1f5f9;
            color: #1e293b;
        }

        /* ── Sidebar ── */
        .sidebar {
            position: fixed; top: 0; left: 0;
            width: var(--sidebar-width);
            height: 100vh;
            background: var(--bg-sidebar);
            display: flex; flex-direction: column;
            z-index: 100;
        }
        .sidebar-brand {
            padding: 1.5rem 1.25rem 1rem;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }
        .sidebar-brand .logo {
            font-size: 1.25rem; font-weight: 700;
            color: var(--primary); letter-spacing: -0.5px;
        }
        .sidebar-brand .logo-sub {
            font-size: 0.7rem; color: var(--text-muted-light);
            display: block; margin-top: 2px;
        }
        .sidebar-nav { flex: 1; padding: 1rem 0; overflow-y: auto; }
        .nav-section-label {
            font-size: 0.65rem; font-weight: 600; letter-spacing: 1px;
            color: var(--text-muted-light); text-transform: uppercase;
            padding: 0.75rem 1.25rem 0.35rem;
        }
        .sidebar-link {
            display: flex; align-items: center; gap: 0.65rem;
            padding: 0.55rem 1.25rem;
            color: #cbd5e1; font-size: 0.875rem;
            text-decoration: none; border-radius: 0;
            transition: background 0.15s, color 0.15s;
            border-left: 3px solid transparent;
        }
        .sidebar-link:hover { background: rgba(255,255,255,0.06); color: #fff; }
        .sidebar-link.active {
            background: rgba(233,69,96,0.15);
            color: var(--primary);
            border-left-color: var(--primary);
            font-weight: 600;
        }
        .sidebar-link i { font-size: 1rem; width: 1.1rem; text-align: center; }
        .sidebar-link .badge-count {
            margin-left: auto;
            background: var(--primary); color: #fff;
            font-size: 0.65rem; border-radius: 10px;
            padding: 1px 7px;
        }
        .sidebar-footer {
            padding: 1rem 1.25rem;
            border-top: 1px solid rgba(255,255,255,0.08);
        }
        .user-chip {
            display: flex; align-items: center; gap: 0.6rem;
        }
        .user-avatar {
            width: 32px; height: 32px; border-radius: 50%;
            background: var(--primary);
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 0.8rem; color: #fff; flex-shrink: 0;
        }
        .user-chip .user-name { font-size: 0.8rem; color: #e2e8f0; font-weight: 500; }
        .user-chip .user-role { font-size: 0.7rem; color: var(--text-muted-light); }

        /* ── Main ── */
        .main-wrapper {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex; flex-direction: column;
        }
        .topbar {
            background: #fff;
            border-bottom: 1px solid #e2e8f0;
            padding: 0 1.5rem;
            height: 56px;
            display: flex; align-items: center; justify-content: space-between;
            position: sticky; top: 0; z-index: 50;
        }
        .topbar-title { font-weight: 600; font-size: 1rem; color: #1e293b; }
        .topbar-actions { display: flex; align-items: center; gap: 0.75rem; }
        .btn-logout {
            border: 1px solid #e2e8f0; background: #fff;
            color: #64748b; border-radius: 8px;
            padding: 0.3rem 0.75rem; font-size: 0.8rem;
            cursor: pointer; transition: all 0.15s;
            display: flex; align-items: center; gap: 0.4rem;
        }
        .btn-logout:hover { border-color: var(--primary); color: var(--primary); }
        .page-content { padding: 1.5rem; flex: 1; }

        /* ── Cards ── */
        .stat-card {
            background: #fff; border-radius: 12px;
            padding: 1.25rem 1.5rem;
            border: 1px solid #e2e8f0;
            display: flex; align-items: center; gap: 1rem;
        }
        .stat-icon {
            width: 44px; height: 44px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.2rem; flex-shrink: 0;
        }
        .stat-icon.red   { background: rgba(233,69,96,0.1);  color: var(--primary); }
        .stat-icon.blue  { background: rgba(59,130,246,0.1); color: #3b82f6; }
        .stat-icon.green { background: rgba(16,185,129,0.1); color: #10b981; }
        .stat-icon.amber { background: rgba(245,158,11,0.1); color: #f59e0b; }
        .stat-value { font-size: 1.5rem; font-weight: 700; line-height: 1; }
        .stat-label { font-size: 0.75rem; color: #64748b; margin-top: 2px; }

        /* ── Table ── */
        .data-card {
            background: #fff; border-radius: 12px;
            border: 1px solid #e2e8f0; overflow: hidden;
        }
        .data-card-header {
            padding: 1rem 1.25rem;
            border-bottom: 1px solid #f1f5f9;
            display: flex; align-items: center; justify-content: space-between;
            gap: 1rem; flex-wrap: wrap;
        }
        .data-card-title { font-weight: 600; font-size: 0.9rem; }
        .table { margin: 0; }
        .table th {
            background: #f8fafc; font-size: 0.75rem;
            font-weight: 600; text-transform: uppercase;
            letter-spacing: 0.5px; color: #64748b;
            border-bottom: 1px solid #e2e8f0; padding: 0.65rem 1rem;
        }
        .table td { padding: 0.75rem 1rem; vertical-align: middle; font-size: 0.875rem; }
        .table tbody tr:hover { background: #f8fafc; }
        .badge-active   { background:#dcfce7; color:#16a34a; padding:2px 10px; border-radius:20px; font-size:0.75rem; font-weight:600; }
        .badge-inactive { background:#fee2e2; color:#dc2626; padding:2px 10px; border-radius:20px; font-size:0.75rem; font-weight:600; }

        /* ── Buttons ── */
        .btn-primary-bms {
            background: var(--primary); color: #fff; border: none;
            border-radius: 8px; padding: 0.45rem 1rem;
            font-size: 0.875rem; font-weight: 500;
            transition: background 0.15s, transform 0.1s;
            display: inline-flex; align-items: center; gap: 0.4rem;
        }
        .btn-primary-bms:hover { background: var(--primary-dark); transform: translateY(-1px); color: #fff; }
        .btn-outline-bms {
            background: transparent; color: var(--primary);
            border: 1px solid var(--primary); border-radius: 8px;
            padding: 0.4rem 0.85rem; font-size: 0.8rem;
            transition: all 0.15s;
            display: inline-flex; align-items: center; gap: 0.35rem;
        }
        .btn-outline-bms:hover { background: var(--primary); color: #fff; }
        .btn-sm-icon {
            width: 30px; height: 30px; border-radius: 6px;
            display: inline-flex; align-items: center; justify-content: center;
            font-size: 0.85rem; border: 1px solid #e2e8f0;
            background: #fff; color: #64748b; cursor: pointer;
            transition: all 0.15s;
        }
        .btn-sm-icon:hover { border-color: var(--primary); color: var(--primary); }
        .btn-sm-icon.danger:hover { border-color: #dc2626; color: #dc2626; }

        /* ── Form ── */
        .form-card {
            background: #fff; border-radius: 12px;
            border: 1px solid #e2e8f0; padding: 1.5rem;
            max-width: 640px;
        }
        .form-label { font-size: 0.875rem; font-weight: 500; color: #374151; }
        .form-control, .form-select {
            border: 1px solid #e2e8f0; border-radius: 8px;
            font-size: 0.875rem; padding: 0.5rem 0.75rem;
            transition: border-color 0.15s, box-shadow 0.15s;
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(233,69,96,0.12);
        }
        .form-text { font-size: 0.75rem; color: #94a3b8; }
        .field-error { font-size: 0.78rem; color: #dc2626; margin-top: 3px; }
    </style>
</head>
<body>

<!-- ── Sidebar ── -->
<nav class="sidebar">
    <div class="sidebar-brand">
        <div class="logo">🎱 BMS</div>
        <span class="logo-sub">Billiard Management System</span>
    </div>
    <div class="sidebar-nav">
        <div class="nav-section-label">Admin</div>
        <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Employee" ? "active" : "")"
           asp-controller="Employee" asp-action="Index">
            <i class="bi bi-people"></i> Nhân viên
        </a>

        <div class="nav-section-label">Nghiệp vụ</div>
        <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Table" ? "active" : "")"
           href="#">
            <i class="bi bi-grid-3x3"></i> Quản lý bàn
        </a>
        <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Booking" ? "active" : "")"
           href="#">
            <i class="bi bi-calendar-check"></i> Đặt bàn
        </a>
        <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Menu" ? "active" : "")"
           href="#">
            <i class="bi bi-cup-straw"></i> Thực đơn
        </a>
    </div>
    <div class="sidebar-footer">
        <div class="user-chip">
            <div class="user-avatar">@(User.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "?")</div>
            <div>
                <div class="user-name">@User.Identity?.Name</div>
                <div class="user-role">Administrator</div>
            </div>
        </div>
    </div>
</nav>

<!-- ── Main ── -->
<div class="main-wrapper">
    <div class="topbar">
        <span class="topbar-title">@ViewData["Title"]</span>
        <div class="topbar-actions">
            <a asp-controller="Profile" asp-action="ChangePassword" class="btn-logout" title="Đổi mật khẩu">
                <i class="bi bi-shield-lock"></i> Đổi mật khẩu
            </a>
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-logout">
                    <i class="bi bi-box-arrow-right"></i> Đăng xuất
                </button>
            </form>
        </div>
    </div>
    <div class="page-content">
        @RenderBody()
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
