@model Bms.Web.Models.OrderMenuViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Gọi đồ - Bàn @Model.TableCode | BMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --primary: #e94560;
            --primary-dark: #c0354c;
            --dark-bg: #1a1a2e;
            --card-bg: #ffffff;
            --text-color: #2b2d42;
        }
        body {
            background-color: #f4f6f9;
            color: var(--text-color);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            padding-bottom: 90px;
        }
        .header-bar {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            color: #fff;
            padding: 1.25rem 1rem;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 4px 15px rgba(0,0,0,0.15);
        }
        .table-badge {
            background: var(--primary);
            color: #fff;
            font-weight: 700;
            font-size: 1.1rem;
            padding: 0.35rem 0.85rem;
            border-radius: 8px;
            letter-spacing: 0.5px;
        }
        .category-tab {
            overflow-x: auto;
            white-space: nowrap;
            background: #fff;
            padding: 0.65rem 1rem;
            border-bottom: 1px solid #e2e8f0;
            position: sticky;
            top: 76px;
            z-index: 90;
        }
        .category-pill {
            display: inline-block;
            padding: 0.4rem 1rem;
            border-radius: 20px;
            background: #edf2f7;
            color: #4a5568;
            font-size: 0.875rem;
            font-weight: 600;
            text-decoration: none;
            margin-right: 0.5rem;
            transition: all 0.2s;
        }
        .category-pill.active, .category-pill:hover {
            background: var(--primary);
            color: #fff;
        }
        .product-card {
            background: #fff;
            border-radius: 12px;
            padding: 1rem;
            margin-bottom: 0.85rem;
            border: 1px solid #edf2f7;
            box-shadow: 0 2px 5px rgba(0,0,0,0.03);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
        }
        .product-name {
            font-weight: 600;
            font-size: 1rem;
            color: #1e293b;
            margin-bottom: 2px;
        }
        .product-price {
            font-weight: 700;
            color: var(--primary);
            font-size: 0.95rem;
        }
        .qty-controls {
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }
        .btn-qty {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            border: 1px solid #cbd5e1;
            background: #fff;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #334155;
            cursor: pointer;
            transition: 0.15s;
        }
        .btn-qty:active {
            transform: scale(0.92);
            background: #f1f5f9;
        }
        .qty-input {
            width: 46px;
            height: 32px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            text-align: center;
            font-weight: 700;
            font-size: 0.95rem;
            color: #1e293b;
            padding: 0 4px;
            -moz-appearance: textfield;
        }
        .qty-input::-webkit-outer-spin-button,
        .qty-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        .qty-input:focus {
            border-color: var(--primary);
            outline: none;
            box-shadow: 0 0 0 2px rgba(233,69,96,0.15);
        }
        /* Toast notification */
        .toast-notify {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: #1e293b;
            color: #fff;
            padding: 0.75rem 1.25rem;
            border-radius: 12px;
            font-size: 0.875rem;
            font-weight: 500;
            z-index: 9999;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease, transform 0.3s ease;
            max-width: 90%;
            text-align: center;
            border-left: 4px solid var(--primary);
        }
        .toast-notify.show {
            opacity: 1;
            transform: translateX(-50%) translateY(10px);
        }
        .cart-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: #fff;
            padding: 0.75rem 1rem;
            box-shadow: 0 -4px 15px rgba(0,0,0,0.1);
            display: flex;
            align-items: center;
            justify-content: space-between;
            z-index: 1000;
        }
        .btn-checkout {
            background: var(--primary);
            color: #fff;
            font-weight: 700;
            border-radius: 10px;
            padding: 0.65rem 1.4rem;
            border: none;
            box-shadow: 0 4px 10px rgba(233,69,96,0.3);
        }
        .btn-checkout:disabled {
            background: #cbd5e1;
            box-shadow: none;
        }
        .order-history-card {
            background: #fff;
            border-radius: 10px;
            padding: 0.85rem;
            margin-bottom: 0.65rem;
            border-left: 4px solid var(--primary);
        }
        .badge-pending { background: #fef3c7; color: #b45309; }
        .badge-served { background: #dcfce7; color: #15803d; }
        .badge-cancelled { background: #fee2e2; color: #b91c1c; }
    </style>
</head>
<body>

<!-- Header -->
<div class="header-bar d-flex justify-content-between align-items-center">
    <div>
        <div class="d-flex align-items-center gap-2">
            <span class="table-badge">BÀN @Model.TableCode</span>
            <span class="badge bg-secondary">Tầng @(Model.FloorNumber ?? 1)</span>
        </div>
        <div class="small text-white-50 mt-1">@Model.TableTypeName</div>
    </div>
    <button class="btn btn-sm btn-outline-light rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#orderHistoryModal">
        <i class="bi bi-clock-history"></i> Đơn đã gọi (@Model.MyOrders.Count)
    </button>
</div>

<div class="container py-3">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.HasActiveSession)
    {
        <div class="card border-0 shadow-sm rounded-4 text-center p-4 mt-3">
            <div class="display-3 text-warning mb-3">🎱</div>
            <h4 class="fw-bold">Bàn chưa mở phiên chơi</h4>
            <p class="text-muted">Bàn @Model.TableCode hiện tại chưa bắt đầu phiên chơi nào.<br />Vui lòng liên hệ nhân viên để mở bàn hoặc gọi đồ trực tiếp tại quầy.</p>
        </div>
    }
    else
    {
        <!-- Form gửi đơn -->
        <form asp-action="SubmitTable" asp-controller="Order" method="post" id="orderForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="tableCode" value="@Model.TableCode" />

            <div class="mb-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Thực đơn hôm nay</h5>
                <span class="badge bg-light text-dark border">Phương án: Nhân viên xác nhận tại bàn</span>
            </div>

            @foreach (var cat in Model.Categories)
            {
                <div class="mb-4">
                    <h6 class="text-uppercase fw-bold text-muted small mb-3">
                        <i class="bi bi-tag-fill me-1 text-danger"></i> @cat.Name
                    </h6>
                    @foreach (var prod in cat.Products)
                    {
                        var isAvailable = prod.IsAvailable;
                        <div class="product-card @(!isAvailable ? "opacity-50" : "")">
                            <div>
                                <div class="product-name">@prod.Name</div>
                                <div class="product-price">@prod.Price.ToString("#,##0 ₫")</div>
                                @if (!isAvailable)
                                {
                                    <span class="badge bg-secondary small">Hết hàng</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Còn: @prod.StockQuantity</span>
                                }
                            </div>
                            @if (isAvailable)
                            {
                                <div class="qty-controls" data-product-id="@prod.Id" data-name="@prod.Name" data-price="@prod.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-max="@prod.StockQuantity">
                                    <button type="button" class="btn-qty btn-minus" onclick="changeQty(@prod.Id, -1)">-</button>
                                    <input type="number" class="qty-input" id="qty-val-@prod.Id" value="0" min="0" max="@prod.StockQuantity" oninput="onInputQty(@prod.Id)" />
                                    <button type="button" class="btn-qty btn-plus" onclick="changeQty(@prod.Id, 1)">+</button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <div id="hiddenInputsContainer"></div>

            <!-- Thanh Cart dưới cùng -->
            <div class="cart-bar">
                <div>
                    <div class="text-muted small">Tạm tính:</div>
                    <div class="fw-bold fs-5 text-danger" id="cartTotalText">0 ₫</div>
                </div>
                <button type="submit" class="btn-checkout" id="submitBtn" disabled>
                    <i class="bi bi-send-fill me-1"></i> Gửi gọi món (<span id="cartCountText">0</span>)
                </button>
            </div>
        </form>
    }
</div>

<!-- Modal Lịch sử đơn của bàn -->
<div class="modal fade" id="orderHistoryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content border-0 rounded-4">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-clock-history me-2 text-danger"></i>Đơn đã gọi của bàn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3">
                @if (!Model.MyOrders.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                        Chưa có món nào được gọi trong phiên này.
                    </div>
                }
                else
                {
                    @foreach (var o in Model.MyOrders)
                    {
                        var badgeClass = o.Status == "Pending" ? "badge-pending" : (o.Status == "Served" ? "badge-served" : "badge-cancelled");
                        <div class="order-history-card">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold">Đơn #@o.OrderId</span>
                                <span class="badge @badgeClass">@o.StatusDisplay</span>
                            </div>
                            <div class="small text-muted mb-2">Thời gian: @o.OrderTimeUtc.AddHours(7).ToString("HH:mm:ss dd/MM")</div>
                            <ul class="list-unstyled mb-1">
                                @foreach (var it in o.Items)
                                {
                                    <li class="d-flex justify-content-between small py-1 border-bottom">
                                        <span>@it.ProductName x @it.Quantity</span>
                                        <span class="fw-semibold">@it.Subtotal.ToString("#,##0 ₫")</span>
                                    </li>
                                }
                            </ul>
                            <div class="text-end fw-bold text-danger mt-1">
                                Tổng: @o.TotalAmount.ToString("#,##0 ₫")
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Toast thông báo -->
<div id="toastNotification" class="toast-notify"></div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const cart = {}; // { productId: { qty: X, price: Y } }
    let toastTimeout = null;

    function showToast(msg) {
        const toast = document.getElementById('toastNotification');
        toast.textContent = msg;
        toast.classList.add('show');
        if (toastTimeout) clearTimeout(toastTimeout);
        toastTimeout = setTimeout(() => {
            toast.classList.remove('show');
        }, 3000);
    }

    function onInputQty(productId) {
        const controls = document.querySelector(`.qty-controls[data-product-id="${productId}"]`);
        const stockMax = parseInt(controls.getAttribute('data-max') || '20');
        const price = parseFloat(controls.getAttribute('data-price') || '0');
        const name = controls.getAttribute('data-name') || 'Món này';
        const input = document.getElementById(`qty-val-${productId}`);

        let val = parseInt(input.value);
        if (isNaN(val) || val < 0) {
            val = 0;
            input.value = 0;
        }

        if (val > stockMax) {
            val = stockMax;
            input.value = val;
            showToast(`Món "${name}" trong kho chỉ còn tối đa ${stockMax} sản phẩm. Đã tự động điều chỉnh về ${stockMax}.`);
        } else if (val > 20) {
            val = 20;
            input.value = val;
            showToast(`Mỗi lần gọi món chỉ được đặt tối đa 20 sản phẩm. Đã điều chỉnh về 20.`);
        }

        if (val === 0) {
            delete cart[productId];
        } else {
            cart[productId] = { qty: val, price: price };
        }

        updateCartBar();
    }

    function changeQty(productId, delta) {
        const controls = document.querySelector(`.qty-controls[data-product-id="${productId}"]`);
        const stockMax = parseInt(controls.getAttribute('data-max') || '20');
        const price = parseFloat(controls.getAttribute('data-price') || '0');
        const name = controls.getAttribute('data-name') || 'Món này';
        const input = document.getElementById(`qty-val-${productId}`);

        let current = cart[productId] ? cart[productId].qty : 0;
        let next = current + delta;

        if (delta > 0 && next > stockMax) {
            showToast(`Món "${name}" trong kho chỉ còn tối đa ${stockMax} sản phẩm!`);
            next = stockMax;
        } else if (delta > 0 && next > 20) {
            showToast(`Mỗi lần gọi món chỉ được đặt tối đa 20 sản phẩm.`);
            next = 20;
        }
        if (next < 0) next = 0;

        input.value = next;
        if (next === 0) {
            delete cart[productId];
        } else {
            cart[productId] = { qty: next, price: price };
        }

        updateCartBar();
    }

    function updateCartBar() {
        let totalCount = 0;
        let totalAmount = 0;
        const container = document.getElementById('hiddenInputsContainer');
        container.innerHTML = '';

        let index = 0;
        for (const [prodId, item] of Object.entries(cart)) {
            totalCount += item.qty;
            totalAmount += item.qty * item.price;

            const inputId = document.createElement('input');
            inputId.type = 'hidden';
            inputId.name = `Items[${index}].ProductId`;
            inputId.value = prodId;

            const inputQty = document.createElement('input');
            inputQty.type = 'hidden';
            inputQty.name = `Items[${index}].Quantity`;
            inputQty.value = item.qty;

            container.appendChild(inputId);
            container.appendChild(inputQty);
            index++;
        }

        document.getElementById('cartCountText').textContent = totalCount;
        document.getElementById('cartTotalText').textContent = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(totalAmount);
        document.getElementById('submitBtn').disabled = totalCount === 0;
    }
</script>
</body>
</html>

