@model List<Bms.Web.Data.Order>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Duyệt đơn gọi món từ bàn";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-bell text-danger me-2"></i>Duyệt đơn gọi món</h4>
        <span class="text-muted small">Kiểm tra và xác nhận món ăn/uống do khách gửi từ mã QR tại bàn (Phương án 1)</span>
    </div>
    <div>
        <a asp-action="Counter" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Quay lại gọi tại quầy
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="data-card">
    <div class="data-card-header">
        <span class="data-card-title"><i class="bi bi-hourglass-split me-1 text-warning"></i> Danh sách đơn chờ xác nhận (@Model.Count)</span>
    </div>

    @if (!Model.Any())
    {
        <div class="p-5 text-center text-muted">
            <i class="bi bi-check2-circle text-success fs-1 d-block mb-3"></i>
            <h5>Không có đơn nào đang chờ duyệt!</h5>
            <p class="small text-muted mb-0">Khi khách tại bàn quét mã QR và gửi đơn, yêu cầu sẽ lập tức hiển thị tại đây.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Bàn</th>
                        <th>Thời gian</th>
                        <th>Danh sách món</th>
                        <th>Tổng tiền</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        var totalAmount = o.OrderDetails.Sum(d => d.Quantity * d.UnitPrice);
                        <tr>
                            <td>
                                <span class="fw-bold text-dark">#@o.Id</span>
                            </td>
                            <td>
                                <span class="badge bg-danger fs-6 px-3 py-1">Bàn @o.Session.Table.TableCode</span>
                            </td>
                            <td>
                                <div class="fw-semibold">@o.OrderTimeUtc.AddHours(7).ToString("HH:mm:ss")</div>
                                <div class="text-muted" style="font-size: 0.75rem;">@o.OrderTimeUtc.AddHours(7).ToString("dd/MM/yyyy")</div>
                            </td>
                            <td>
                                <ul class="list-unstyled mb-0">
                                    @foreach (var d in o.OrderDetails)
                                    {
                                        <li class="small">
                                            <strong>@d.Product.Name</strong> &times; @d.Quantity 
                                            <span class="text-muted">(@d.UnitPrice.ToString("#,##0 ₫"))</span>
                                            @if (d.Product.StockQuantity < d.Quantity)
                                            {
                                                <span class="badge bg-danger ms-1">Thiếu hàng (còn @d.Product.StockQuantity)</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            </td>
                            <td>
                                <span class="fw-bold text-danger">@totalAmount.ToString("#,##0 ₫")</span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <form asp-action="ApproveOrder" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@o.Id" />
                                        <button type="submit" class="btn btn-sm btn-success px-3 fw-bold shadow-xs" 
                                                onclick="return confirm('Xác nhận duyệt và phục vụ đơn này cho bàn @o.Session.Table.TableCode?');">
                                            <i class="bi bi-check-lg me-1"></i> Duyệt & Phục vụ
                                        </button>
                                    </form>
                                    <form asp-action="CancelOrder" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@o.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" 
                                                onclick="return confirm('Bạn có chắc chắn muốn hủy đơn này?');">
                                            <i class="bi bi-x-lg me-1"></i> Hủy
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

