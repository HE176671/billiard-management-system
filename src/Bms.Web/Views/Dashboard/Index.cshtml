@model Bms.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Bảng điều khiển";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-gray-800">Tổng quan hệ thống</h1>
    <a href="#" class="btn btn-primary btn-sm shadow-sm">
        <i class="bi bi-download text-white-50 me-1"></i> Xuất báo cáo (Demo)
    </a>
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="stat-card">
            <div class="stat-icon blue"><i class="bi bi-person-badge"></i></div>
            <div>
                <div class="stat-value">@Model.TotalActiveStaff</div>
                <div class="stat-label">Nhân viên đang HĐ</div>
            </div>
        </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
        <div class="stat-card">
            <div class="stat-icon green"><i class="bi bi-people"></i></div>
            <div>
                <div class="stat-value">@Model.TotalCustomers</div>
                <div class="stat-label">Tổng Khách hàng</div>
            </div>
        </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
        <div class="stat-card">
            <div class="stat-icon orange"><i class="bi bi-vinyl"></i></div>
            <div>
                <div class="stat-value">@Model.TablesInUse</div>
                <div class="stat-label">Bàn đang có khách</div>
            </div>
        </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
        <div class="stat-card">
            <div class="stat-icon red"><i class="bi bi-cash-stack"></i></div>
            <div>
                <div class="stat-value">@Model.TodayRevenue.ToString("N0") ₫</div>
                <div class="stat-label">Tiền giờ (Hôm nay)</div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4 rounded-3">
            <div class="card-header bg-white border-0 py-3">
                <h6 class="m-0 font-weight-bold" style="color: var(--primary-color);">Biểu đồ tần suất khách hàng (Minh họa)</h6>
            </div>
            <div class="card-body">
                <div class="text-center text-muted py-5" style="min-height: 250px;">
                    <i class="bi bi-bar-chart display-1 mb-3" style="color:#e2e8f0;"></i>
                    <p>Phần biểu đồ doanh thu chi tiết sẽ được Leader phân công ở Sprint sau.</p>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4 rounded-3">
            <div class="card-header bg-white border-0 py-3">
                <h6 class="m-0 font-weight-bold" style="color: var(--primary-color);">Thông báo hệ thống</h6>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item px-4 py-3 text-muted">
                        <i class="bi bi-database-check text-success me-2"></i> Hệ thống đã hoàn thiện cập nhật Database Schema (Bản Full).
                    </li>
                    <li class="list-group-item px-4 py-3 text-muted">
                        <i class="bi bi-tags text-warning me-2"></i> Bảng giá cập nhật: Pool (100k/h), Carom (120k/h).
                    </li>
                    <li class="list-group-item px-4 py-3 text-muted">
                        <i class="bi bi-person-gear text-info me-2"></i> Chức năng phân quyền Admin & Staff hoạt động ổn định.
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
