@model Bms.Web.Models.DashboardViewModel
@{ ViewData["Title"] = "Dashboard tổng quan"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<p class="text-muted">Số liệu trực tiếp từ hệ thống. Ngày và tháng tính theo giờ Việt Nam (UTC+7).</p>
<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="stat-card"><div><div class="stat-value">@Model.TodayRevenue.ToString("N0") ₫</div><div class="stat-label">Doanh thu hôm nay</div></div></div></div>
    <div class="col-md-4"><div class="stat-card"><div><div class="stat-value">@Model.MonthRevenue.ToString("N0") ₫</div><div class="stat-label">Doanh thu tháng này</div></div></div></div>
    <div class="col-md-4"><div class="stat-card"><div><div class="stat-value">@Model.TotalTables</div><div class="stat-label">Tổng số bàn · @Model.AvailableTables trống · @Model.InUseTables đang chơi</div></div></div></div>
    <div class="col-md-6"><div class="stat-card"><div><div class="stat-value">@Model.StaffCount</div><div class="stat-label">Nhân viên</div></div></div></div>
    <div class="col-md-6"><div class="stat-card"><div><div class="stat-value">@Model.CustomerCount</div><div class="stat-label">Khách hàng</div></div></div></div>
</div>
<a asp-controller="Revenue" asp-action="Index" class="btn-primary-bms">Xem báo cáo doanh thu</a>

