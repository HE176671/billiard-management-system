@model List<Bms.Web.Models.ComboViewModel>
@{
    ViewData["Title"] = "Quản lý Gói Combo";
    Layout = "_AdminLayout";
    bool isManager = User.IsInRole("Manager") || User.IsInRole("Admin");
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-box2-heart text-danger me-2"></i>Quản lý Gói Combo</h4>
        <span class="text-muted small">
            Cấu hình gói dịch vụ gồm <strong>số giờ chơi + món kèm</strong> (nước/đồ ăn) theo quy tắc <strong>UC-06</strong>. Khi mở bàn sẽ tự động trừ kho món kèm (BR-07a).
        </span>
    </div>
    <div>
        @if (isManager)
        {
            <a asp-action="Create" class="btn btn-primary-bms btn-sm">
                <i class="bi bi-plus-lg me-1"></i>+ Tạo gói Combo mới
            </a>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="data-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 50px;" class="text-center">#</th>
                    <th>Tên gói Combo</th>
                    <th class="text-center">Giờ chơi tặng kèm</th>
                    <th>Món ăn / Nước uống đi kèm</th>
                    <th>Loại bàn áp dụng</th>
                    <th class="text-end">Giá trọn gói</th>
                    <th class="text-center">Trạng thái</th>
                    @if (isManager)
                    {
                        <th class="text-center" style="width: 130px;">Thao tác</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            Chưa có gói Combo nào trong hệ thống.
                        </td>
                    </tr>
                }
                else
                {
                    int idx = 1;
                    foreach (var c in Model)
                    {
                        <tr>
                            <td class="text-center text-muted small">@idx</td>
                            <td>
                                <span class="fw-semibold text-dark">@c.Name</span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold">
                                    <i class="bi bi-stopwatch me-1"></i>@c.PlaytimeHours.ToString("0.##") Giờ
                                </span>
                            </td>
                            <td>
                                @if (c.Items.Count == 0)
                                {
                                    <span class="text-muted small">Không kèm món</span>
                                }
                                else
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var it in c.Items)
                                        {
                                            <span class="badge bg-light text-dark border">
                                                @it.Quantity x @it.ProductName
                                                @if (it.CurrentStock < it.Quantity)
                                                {
                                                    <span class="text-danger ms-1 fw-bold" title="Món này trong kho đã hết hàng">(Hết kho!)</span>
                                                }
                                                else
                                                {
                                                    <span class="text-success ms-1">(còn @it.CurrentStock)</span>
                                                }
                                            </span>
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-secondary border">
                                    <i class="bi bi-grid me-1"></i>@(string.IsNullOrEmpty(c.TableTypeName) ? "Tất cả các loại bàn" : c.TableTypeName)
                                </span>
                            </td>
                            <td class="text-end fw-bold text-danger fs-6">
                                @c.Price.ToString("N0") ₫
                            </td>
                            <td class="text-center">
                                @if (c.IsActive)
                                {
                                    <span class="badge-active">Đang mở bán</span>
                                }
                                else
                                {
                                    <span class="badge-inactive">Tạm ngưng</span>
                                }
                            </td>
                            @if (isManager)
                            {
                                <td class="text-center">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-outline-secondary btn-sm-icon" title="Chỉnh sửa combo">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="ToggleActive" asp-route-id="@c.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Bạn có chắc muốn đổi trạng thái combo @c.Name?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn @(c.IsActive ? "btn-outline-danger" : "btn-outline-success") btn-sm-icon"
                                                    title="@(c.IsActive ? "Tạm ngưng" : "Mở bán lại")">
                                                <i class="bi @(c.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            }
                        </tr>
                        idx++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>
