@model string
@{
    var activeTab = Model ?? "Index";
}
<div class="data-card mb-3 px-3 py-2">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-wallet2 text-danger fs-5"></i>
            <span class="fw-semibold" style="font-size:0.9rem">Phân hệ Tài chính &amp; Kiểm soát Chi phí</span>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Revenue" asp-action="Index"
               class="@(activeTab == "Index" ? "btn-primary-bms" : "btn-outline-bms")" style="font-size:0.82rem">
                <i class="bi bi-graph-up"></i> Báo cáo tổng quan
            </a>
            <a asp-controller="Revenue" asp-action="Expenses"
               class="@(activeTab == "Expenses" ? "btn-primary-bms" : "btn-outline-bms")" style="font-size:0.82rem">
                <i class="bi bi-journal-text"></i> Sổ cái chi phí
            </a>
            <a asp-controller="Revenue" asp-action="CreateExpense"
               class="@(activeTab == "CreateExpense" ? "btn-primary-bms" : "btn-outline-bms")" style="font-size:0.82rem">
                <i class="bi bi-plus-circle"></i> Lập phiếu chi
            </a>
            <a asp-controller="Revenue" asp-action="AuditCases"
               class="@(activeTab == "AuditCases" || activeTab == "AuditDetail" ? "btn-primary-bms" : "btn-outline-bms")" style="font-size:0.82rem">
                <i class="bi bi-shield-check"></i> Kiểm toán thất thoát
            </a>
            <a asp-controller="Revenue" asp-action="Budgets"
               class="@(activeTab == "Budgets" ? "btn-primary-bms" : "btn-outline-bms")" style="font-size:0.82rem">
                <i class="bi bi-sliders"></i> Định mức ngân sách
            </a>
        </div>
    </div>
</div>
