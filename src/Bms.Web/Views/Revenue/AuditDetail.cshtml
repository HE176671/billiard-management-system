@model Bms.Web.Models.AuditCaseDetailViewModel
@{
    ViewData["Title"] = $"Điều tra & Xử lý Thất thoát {Model.Case.CaseCode} (UC-FIN-06)";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var stClass = Model.Case.Status switch
    {
        "Resolved" => "bg-success",
        "Investigating" => "bg-warning text-dark",
        _ => "bg-danger"
    };
}

@await Html.PartialAsync("_FinancialNav", "AuditDetail")
@await Html.PartialAsync("_Alerts")

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h4 class="fw-bold mb-1">
            🔎 Màn Hình 6: Điều Tra &amp; Ra Quyết Định Xử Lý Hồ Sơ <code>@Model.Case.CaseCode</code>
            <span class="badge @stClass ms-2">@Model.Case.StatusDisplayName</span>
        </h4>
        <p class="text-muted small mb-0">
            <strong>Giải quyết vấn đề gì?</strong> Khép kín 100% vòng lặp Kiểm toán End-to-End (<code>BR-FIN-17</code>): khi CFO quyết định <strong>Truy thu tiền mặt</strong> hoặc <strong>Khấu trừ lương nhân viên vi phạm</strong>, khoản tiền thu hồi sẽ được cộng bù trực tiếp vào <strong>Lợi Nhuận Ròng trên Bảng P&amp;L</strong>!
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="AuditCases" class="btn btn-outline-secondary">⬅ Quay lại Danh Sách Hồ Sơ</a>
        <a asp-action="Index" asp-route-from="2026-01-01" asp-route-to="2026-12-31" asp-route-groupBy="month" class="btn btn-outline-primary">📊 Kiểm Tra Lợi Nhuận P&amp;L Sau Thu Hồi</a>
    </div>
</div>

<!-- 3 Thẻ Đối Chiếu Chênh Lệch Tiền -->
<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="stat-card h-100 border-start border-4 border-primary">
            <div class="text-muted small fw-semibold">SỐ TIỀN KỲ VỌNG ĐÚNG THEO HỆ THỐNG</div>
            <div class="fs-4 fw-bold text-primary mt-1">@Model.Case.ExpectedAmount.ToString("N0") ₫</div>
            <div class="small text-muted mt-1">Từ dữ liệu Phiên chơi / Order Served / Đầu ca</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card h-100 border-start border-4 border-secondary">
            <div class="text-muted small fw-semibold">SỐ TIỀN THỰC TẾ ĐÃ GHI NHẬN</div>
            <div class="fs-4 fw-bold text-dark mt-1">@Model.Case.RecordedAmount.ToString("N0") ₫</div>
            <div class="small text-muted mt-1">Từ Hóa đơn / PaymentTransactions / Két cuối ca</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card h-100 border-start border-4 border-danger">
            <div class="text-muted small fw-semibold">CHÊNH LỆCH THẤT THOÁT &amp; ĐÃ THU HỒI</div>
            <div class="fs-4 fw-bold text-danger mt-1">
                -@Model.Case.LeakageAmount.ToString("N0") ₫
                @if (Model.Case.RecoveredAmount > 0)
                {
                    <span class="text-success fs-6 ms-2">(Đã thu hồi: +@Model.Case.RecoveredAmount.ToString("N0") ₫)</span>
                }
            </div>
            <div class="small text-muted mt-1">Mã quy tắc vi phạm: <strong>@Model.Case.RuleCode (@Model.Case.Severity)</strong></div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Cột trái: Bằng chứng đối soát chi tiết -->
    <div class="col-lg-6">
        <div class="data-card p-4 h-100">
            <h6 class="fw-bold mb-3 border-bottom pb-2">1. Hồ Sơ Bằng Chứng Đối Soát Dữ Liệu</h6>
            <table class="table table-sm table-borderless mb-3">
                <tbody>
                    <tr>
                        <th class="text-muted" style="width: 38%;">Mã hồ sơ vụ việc:</th>
                        <td><code>@Model.Case.CaseCode</code></td>
                    </tr>
                    <tr>
                        <th class="text-muted">Quy tắc kiểm toán:</th>
                        <td><span class="badge bg-dark">@Model.Case.RuleCode</span> — <strong>@Model.Case.LeakageType</strong></td>
                    </tr>
                    <tr>
                        <th class="text-muted">Thời điểm phát sinh (UTC+7):</th>
                        <td>@Model.Case.OccurredAtVn.ToString("dd/MM/yyyy HH:mm") (Kỳ P&amp;L: <code>@Model.Case.PeriodMonth</code>)</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Vị trí (Bàn / Phiên / Ca):</th>
                        <td class="fw-bold">@Model.Case.LocationOrRef</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Nhân sự chịu trách nhiệm:</th>
                        <td class="fw-bold text-danger">@Model.Case.ResponsibleStaff</td>
                    </tr>
                </tbody>
            </table>

            <div class="p-3 rounded bg-light border mb-3">
                <div class="fw-bold small text-dark mb-1">📌 Bằng chứng truy vết từ SQL Server:</div>
                <div class="small">@Model.Case.EvidenceDetail</div>
            </div>

            <div class="p-3 rounded border border-warning bg-warning bg-opacity-10">
                <div class="fw-bold small text-dark mb-1">💡 Ý nghĩa Quản trị &amp; Khuyến nghị CFO (Giải quyết vấn đề gì?):</div>
                <div class="small">@Model.Case.ProblemSolvedAction</div>
            </div>

            @if (Model.Case.Status == "Resolved")
            {
                <div class="p-3 rounded border border-success bg-success bg-opacity-10 mt-3 small">
                    <div class="fw-bold text-success">✅ Hồ sơ đã được xử lý:</div>
                    <div><strong>Hình thức chế tài:</strong> @Model.Case.ResolutionDisplayName</div>
                    <div><strong>Số tiền thu hồi về quỹ P&amp;L:</strong> @Model.Case.RecoveredAmount.ToString("N0") ₫</div>
                    <div><strong>Biên bản kết luận:</strong> @Model.Case.InvestigationNote</div>
                </div>
            }
        </div>
    </div>

    <!-- Cột phải: Form Ra Quyết Định Xử Lý & Thu Hồi Tiền (End-to-End Resolution) -->
    <div class="col-lg-6">
        <div class="data-card p-4 h-100">
            <h6 class="fw-bold mb-3 border-bottom pb-2">2. Quyết Định Xử Lý &amp; Chế Tài Thu Hồi Của CFO (<code>UC-FIN-06</code>)</h6>
            <form asp-action="ResolveAuditCase" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ResolutionInput.CaseId" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Bước chuyển trạng thái hồ sơ <span class="text-danger">*</span></label>
                    <select asp-for="ResolutionInput.TargetStatus" class="form-select">
                        <option value="Resolved">✅ Chốt quyết định xử lý &amp; Đóng hồ sơ (Resolved — Cập nhật P&amp;L ngay)</option>
                        <option value="Investigating">🔎 Chuyển sang Đang điều tra &amp; Yêu cầu nhân viên giải trình (Investigating)</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Phương án chế tài tài chính (Khi chọn Resolved) <span class="text-danger">*</span></label>
                    <select asp-for="ResolutionInput.ResolutionType" class="form-select">
                        <option value="RecoveredCash">💵 Phương án 1: Truy thu tiền mặt bổ sung nộp vào quỹ (RecoveredCash)</option>
                        <option value="DeductedPayroll">🧾 Phương án 2: Khấu trừ trực tiếp vào lương nhân sự vi phạm (DeductedPayroll)</option>
                        <option value="Waived">📝 Phương án 3: Miễn trừ có biên bản giải trình hợp lệ (Waived — Thu hồi 0 ₫)</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Số tiền thu hồi / bồi hoàn về quỹ (VND) — Tối đa: <strong>@Model.Case.LeakageAmount.ToString("N0") ₫</strong>
                    </label>
                    <input asp-for="ResolutionInput.RecoveredAmount" type="number" min="0" max="@Model.Case.LeakageAmount" step="1000" class="form-control fw-bold text-success" />
                    <small class="text-muted">Số tiền này sẽ được cộng bù trực tiếp vào chỉ số <strong>Tiền Thu Hồi Sau Kiểm Toán</strong> và làm tăng <strong>Lợi Nhuận Ròng P&amp;L</strong>.</small>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Biên bản kết luận điều tra &amp; Giải trình bắt buộc <span class="text-danger">*</span></label>
                    <textarea asp-for="ResolutionInput.InvestigationNote" class="form-control" rows="4" required minlength="5" maxlength="1000" placeholder="Nhập rõ căn cứ xử lý: Đã thu tiền mặt nộp bổ sung theo phiếu thu / Đã lập biên bản trừ lương ca tối / Lý do miễn trừ..."></textarea>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-primary-bms py-2 fw-bold">
                        ⚖️ Lưu Quyết Định Xử Lý &amp; Đồng Bộ Lợi Nhuận P&amp;L
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
