@model Bms.Web.Models.AuditCaseDetailViewModel
@{
    ViewData["Title"] = $"Xử lý hồ sơ thất thoát {Model.Case.CaseCode}";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var stClass = Model.Case.Status switch
    {
        "Resolved" => "bg-success",
        "Investigating" => "bg-warning text-dark",
        _ => "bg-danger"
    };
}

@await Html.PartialAsync("_FinancialNav", "AuditDetail")
@await Html.PartialAsync("_Alerts")

<!-- 3 Thẻ đối chiếu số liệu -->
<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon blue"><i class="bi bi-calculator"></i></div>
            <div>
                <div class="stat-value text-primary">@Model.Case.ExpectedAmount.ToString("N0") ₫</div>
                <div class="stat-label">Số tiền đúng theo phiên / đơn hàng</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon amber"><i class="bi bi-receipt-cutoff"></i></div>
            <div>
                <div class="stat-value text-dark">@Model.Case.RecordedAmount.ToString("N0") ₫</div>
                <div class="stat-label">Số tiền thực tế đã ghi nhận</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon red"><i class="bi bi-exclamation-triangle"></i></div>
            <div>
                <div class="stat-value text-danger">
                    -@Model.Case.LeakageAmount.ToString("N0") ₫
                </div>
                <div class="stat-label">
                    Chênh lệch thất thoát
                    @if (Model.Case.RecoveredAmount > 0)
                    {
                        <span class="text-success fw-semibold">(Thu hồi: +@Model.Case.RecoveredAmount.ToString("N0") ₫)</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Cột trái: Thông tin chi tiết hồ sơ đối soát -->
    <div class="col-lg-6">
        <div class="data-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <h6 class="fw-bold mb-0">
                    <i class="bi bi-file-earmark-text me-2 text-primary"></i>Thông tin hồ sơ <code>@Model.Case.CaseCode</code>
                </h6>
                <span class="badge @stClass">@Model.Case.StatusDisplayName</span>
            </div>

            <table class="table table-sm table-borderless mb-3">
                <tbody>
                    <tr>
                        <th class="text-muted" style="width: 38%;">Mã quy tắc:</th>
                        <td><span class="badge bg-secondary">@Model.Case.RuleCode</span> — <strong>@Model.Case.LeakageType</strong></td>
                    </tr>
                    <tr>
                        <th class="text-muted">Thời điểm phát sinh:</th>
                        <td>@Model.Case.OccurredAtVn.ToString("dd/MM/yyyy HH:mm") (Kỳ: <code>@Model.Case.PeriodMonth</code>)</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Vị trí (Bàn / Ca / HĐ):</th>
                        <td class="fw-semibold">@Model.Case.LocationOrRef</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Nhân sự liên quan:</th>
                        <td class="fw-semibold text-danger">@Model.Case.ResponsibleStaff</td>
                    </tr>
                </tbody>
            </table>

            <div class="p-3 rounded bg-light border mb-3">
                <div class="fw-semibold small text-dark mb-1">Chi tiết đối chiếu dữ liệu:</div>
                <div class="small text-muted">@Model.Case.EvidenceDetail</div>
            </div>

            <div class="p-3 rounded border bg-light">
                <div class="fw-semibold small text-dark mb-1">Hướng xử lý đề xuất:</div>
                <div class="small text-muted">@Model.Case.ProblemSolvedAction</div>
            </div>

            @if (Model.Case.Status == "Resolved")
            {
                <div class="p-3 rounded border border-success bg-success bg-opacity-10 mt-3 small">
                    <div class="fw-semibold text-success mb-1"><i class="bi bi-check-circle-fill me-1"></i>Kết quả xử lý:</div>
                    <div><strong>Hình thức:</strong> @Model.Case.ResolutionDisplayName</div>
                    <div><strong>Số tiền thu hồi:</strong> @Model.Case.RecoveredAmount.ToString("N0") ₫</div>
                    <div><strong>Ghi chú kết luận:</strong> @Model.Case.InvestigationNote</div>
                </div>
            }
        </div>
    </div>

    <!-- Cột phải: Form Cập nhật kết quả xử lý -->
    <div class="col-lg-6">
        <div class="data-card p-4 h-100">
            <h6 class="fw-bold mb-3 pb-2 border-bottom">
                <i class="bi bi-check2-square me-2 text-danger"></i>Quyết định xử lý &amp; thu hồi thất thoát
            </h6>
            <form asp-action="ResolveAuditCase" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ResolutionInput.CaseId" />

                <div class="mb-3">
                    <label class="form-label">Trạng thái xử lý <span class="text-danger">*</span></label>
                    <select asp-for="ResolutionInput.TargetStatus" class="form-select">
                        <option value="Resolved">Hoàn tất xử lý &amp; Đóng hồ sơ</option>
                        <option value="Investigating">Đang tra soát &amp; Yêu cầu giải trình</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Hình thức xử lý tài chính <span class="text-danger">*</span></label>
                    <select asp-for="ResolutionInput.ResolutionType" class="form-select">
                        <option value="RecoveredCash">Thu hồi tiền mặt bổ sung vào quỹ</option>
                        <option value="DeductedPayroll">Khấu trừ vào lương nhân sự vi phạm</option>
                        <option value="Waived">Miễn trừ (Có giải trình hợp lệ — Thu hồi 0 ₫)</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Số tiền thu hồi / bồi hoàn (VNĐ) — Tối đa: <strong>@Model.Case.LeakageAmount.ToString("N0") ₫</strong>
                    </label>
                    <input asp-for="ResolutionInput.RecoveredAmount" type="number" min="0" max="@Model.Case.LeakageAmount" step="1000" class="form-control fw-bold text-success" />
                    <small class="text-muted">Khoản tiền thu hồi sẽ được cộng bù vào lợi nhuận ròng trên báo cáo doanh thu.</small>
                </div>

                <div class="mb-3">
                    <label class="form-label">Biên bản kết luận / Lý do xử lý <span class="text-danger">*</span></label>
                    <textarea asp-for="ResolutionInput.InvestigationNote" class="form-control" rows="4" required minlength="5" maxlength="1000" placeholder="Nhập nội dung kết luận kiểm tra, số phiếu thu bồi hoàn hoặc lý do miễn trừ..."></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="AuditCases" class="btn-outline-bms">Quay lại</a>
                    <button type="submit" class="btn-primary-bms">
                        <i class="bi bi-check2"></i> Lưu quyết định xử lý
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
