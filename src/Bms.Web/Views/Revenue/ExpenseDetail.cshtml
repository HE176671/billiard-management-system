@model Bms.Web.Models.ExpenseDetailViewModel
@{
    ViewData["Title"] = $"Chi tiết phiếu chi {Model.Expense.ExpenseCode}";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var badgeClass = Model.Expense.Status switch
    {
        "Pending" => "bg-warning text-dark",
        "Rejected" => "bg-danger",
        _ => "bg-success"
    };
}

@await Html.PartialAsync("_FinancialNav", "Expenses")
@await Html.PartialAsync("_Alerts")

<div class="row g-3">
    <!-- Cột trái: Form Chỉnh Sửa Thông Tin Phiếu Chi -->
    <div class="col-lg-7">
        <div class="data-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <div>
                    <h6 class="fw-bold mb-0">
                        <i class="bi bi-receipt me-2 text-primary"></i>Phiếu chi <code>@Model.Expense.ExpenseCode</code>
                    </h6>
                </div>
                <span class="badge @badgeClass">@Model.Expense.StatusDisplayName</span>
            </div>

            <form asp-action="UpdateExpense" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="EditInput.Id" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Ngày phát sinh <span class="text-danger">*</span></label>
                        <input asp-for="EditInput.ExpenseDate" type="date" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Nhóm chi phí <span class="text-danger">*</span></label>
                        <select asp-for="EditInput.Category" class="form-select" required>
                            <option value="Maintenance">Bảo trì bàn, vải nỉ, gậy &amp; bi</option>
                            <option value="InventoryCOGS">Giá vốn nhập bia &amp; nước giải khát</option>
                            <option value="Utilities">Tiền điện, nước &amp; mặt bằng</option>
                            <option value="Payroll">Lương nhân sự theo ca</option>
                        </select>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Nội dung khoản chi <span class="text-danger">*</span></label>
                        <input asp-for="EditInput.Title" class="form-control" required maxlength="150" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Số tiền (VNĐ) <span class="text-danger">*</span></label>
                        <input asp-for="EditInput.Amount" type="number" min="1000" max="1000000000" step="1000" class="form-control fw-bold text-danger" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Nhà cung cấp / Đơn vị nhận</label>
                        <input asp-for="EditInput.VendorName" class="form-control" maxlength="150" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ca phân bổ</label>
                        <select asp-for="EditInput.ShiftPeriod" class="form-select">
                            <option value="All">Toàn thời gian</option>
                            <option value="Day">Ca ngày (08:00–18:00)</option>
                            <option value="Night">Ca đêm (18:00–02:00)</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Bàn liên quan</label>
                        <select asp-for="EditInput.TableId" class="form-select">
                            <option value="">Chi phí chung toàn quán</option>
                            @foreach (var t in Model.TableOptions)
                            {
                                <option value="@t.Id">@t.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Ghi chú chứng từ</label>
                        <textarea asp-for="EditInput.Notes" class="form-control" rows="3" maxlength="500"></textarea>
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Expenses" class="btn-outline-bms">Quay lại</a>
                    <button type="submit" class="btn-primary-bms">
                        <i class="bi bi-check2"></i> Lưu cập nhật
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Cột phải: Phê duyệt phiếu chi + Xóa -->
    <div class="col-lg-5">
        <div class="data-card p-4 mb-3">
            <h6 class="fw-bold mb-3 pb-2 border-bottom">
                <i class="bi bi-clipboard-check me-2 text-success"></i>Phê duyệt phiếu chi
            </h6>
            <div class="p-3 rounded bg-light mb-3 small">
                <div class="mb-1"><strong>Mã phiếu:</strong> <code>@Model.Expense.ExpenseCode</code></div>
                <div class="mb-1"><strong>Người lập:</strong> @Model.Expense.CreatedByName (@Model.Expense.CreatedAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm"))</div>
                <div><strong>Đã duyệt trong kỳ (@Model.PeriodMonth):</strong> @Model.CategoryApprovedActual.ToString("N0") ₫ / Định mức: @Model.CategoryBudgetCap.ToString("N0") ₫</div>
                @if (Model.WouldExceedBudget)
                {
                    <div class="text-danger fw-semibold mt-2">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Khoản chi này vượt định mức ngân sách tháng của danh mục.
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Expense.ReviewNote))
                {
                    <div class="mt-2 pt-2 border-top"><strong>Ghi chú duyệt:</strong> @Model.Expense.ReviewNote</div>
                }
            </div>

            <form asp-action="ReviewExpense" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Expense.Id" />
                <div class="mb-3">
                    <label class="form-label">Trạng thái phê duyệt</label>
                    <select name="targetStatus" class="form-select">
                        <option value="Approved" selected="@(Model.Expense.Status == "Approved")">Phê duyệt (Hạch toán vào chi phí)</option>
                        <option value="Pending" selected="@(Model.Expense.Status == "Pending")">Tạm giữ chờ kiểm tra lại</option>
                        <option value="Rejected" selected="@(Model.Expense.Status == "Rejected")">Từ chối thanh toán</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Ghi chú phê duyệt</label>
                    <input type="text" name="reviewNote" value="@Model.Expense.ReviewNote" class="form-control" placeholder="Nhập ý kiến phê duyệt hoặc lý do từ chối..." maxlength="500" />
                </div>
                <button type="submit" class="btn btn-success w-100">
                    <i class="bi bi-check2-circle me-1"></i>Xác nhận phê duyệt
                </button>
            </form>
        </div>

        <div class="data-card p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold text-danger small">Xóa phiếu chi</div>
                    <small class="text-muted">Xóa phiếu chi nhập nhầm khỏi sổ cái.</small>
                </div>
                <form asp-action="DeleteExpense" method="post" onsubmit="return confirm('Xác nhận xóa phiếu chi @Model.Expense.ExpenseCode?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Expense.Id" />
                    <input type="hidden" name="returnTo" value="Expenses" />
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-trash me-1"></i>Xóa phiếu
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
