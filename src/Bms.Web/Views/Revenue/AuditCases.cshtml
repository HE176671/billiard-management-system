@model Bms.Web.Models.AuditCaseListViewModel
@{
    ViewData["Title"] = "Kiểm toán & Đối soát thất thoát";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@await Html.PartialAsync("_FinancialNav", "AuditCases")
@await Html.PartialAsync("_Alerts")

<!-- 4 Thẻ thống kê kiểm toán -->
<div class="row g-3 mb-3">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon red"><i class="bi bi-exclamation-octagon"></i></div>
            <div>
                <div class="stat-value text-danger">@Model.TotalDetectedLeakage.ToString("N0") ₫</div>
                <div class="stat-label">Tổng thất thoát phát hiện</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon green"><i class="bi bi-arrow-return-left"></i></div>
            <div>
                <div class="stat-value text-success">+@Model.TotalRecoveredAmount.ToString("N0") ₫</div>
                <div class="stat-label">Đã thu hồi / Khấu trừ</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon amber"><i class="bi bi-folder2-open"></i></div>
            <div>
                <div class="stat-value text-warning">@(Model.OpenCount + Model.InvestigatingCount) vụ</div>
                <div class="stat-label">Chờ xử lý (@Model.OpenCount mới · @Model.InvestigatingCount đang tra soát)</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon blue"><i class="bi bi-shield-check"></i></div>
            <div>
                <div class="stat-value text-primary">@Model.ResolvedCount vụ</div>
                <div class="stat-label">Đã xử lý (Còn lại: @Model.RemainingUnresolvedLeakage.ToString("N0") ₫)</div>
            </div>
        </div>
    </div>
</div>

<!-- Danh sách hồ sơ & Bộ lọc -->
<div class="data-card">
    <div class="data-card-header">
        <span class="data-card-title">
            <i class="bi bi-shield-exclamation me-2 text-danger"></i>Danh sách hồ sơ đối soát thất thoát (@Model.Cases.Count hồ sơ)
        </span>
        <form asp-action="SyncAuditCases" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-primary-bms">
                <i class="bi bi-arrow-repeat"></i> Quét đối soát dữ liệu
            </button>
        </form>
    </div>

    <form asp-action="AuditCases" method="get" class="row g-2 align-items-end p-3 border-bottom bg-light bg-opacity-50">
        <div class="col-md-3">
            <label class="form-label small">Nhóm sai lệch</label>
            <select name="ruleCode" class="form-select form-select-sm">
                <option value="">Tất cả quy tắc</option>
                <option value="LEAK-01" selected="@(Model.RuleCode == "LEAK-01")">LEAK-01: Đóng bàn không lập hóa đơn</option>
                <option value="LEAK-02" selected="@(Model.RuleCode == "LEAK-02")">LEAK-02: Hóa đơn treo chưa thu đủ</option>
                <option value="LEAK-03" selected="@(Model.RuleCode == "LEAK-03")">LEAK-03: Giảm giờ chơi / Bỏ sót đồ uống</option>
                <option value="LEAK-04" selected="@(Model.RuleCode == "LEAK-04")">LEAK-04: Chênh lệch tiền mặt cuối ca</option>
                <option value="LEAK-05" selected="@(Model.RuleCode == "LEAK-05")">LEAK-05: Áp giảm giá không hợp lệ</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">Mức độ</label>
            <select name="severity" class="form-select form-select-sm">
                <option value="">Tất cả mức độ</option>
                <option value="Critical" selected="@(Model.Severity == "Critical")">Nghiêm trọng (Critical)</option>
                <option value="High" selected="@(Model.Severity == "High")">Cao (High)</option>
                <option value="Warning" selected="@(Model.Severity == "Warning")">Cảnh báo (Warning)</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small">Trạng thái xử lý</label>
            <select name="status" class="form-select form-select-sm">
                <option value="">Tất cả trạng thái</option>
                <option value="Open" selected="@(Model.Status == "Open")">Mới phát hiện</option>
                <option value="Investigating" selected="@(Model.Status == "Investigating")">Đang tra soát</option>
                <option value="Resolved" selected="@(Model.Status == "Resolved")">Đã xử lý</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small">Tìm kiếm</label>
            <div class="input-group input-group-sm">
                <input type="text" name="keyword" value="@Model.Keyword" class="form-control" placeholder="Mã hồ sơ, bàn, ca, nhân viên..." />
                <button type="submit" class="btn-primary-bms"><i class="bi bi-search"></i> Tìm</button>
            </div>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Mã hồ sơ</th>
                    <th>Thời điểm</th>
                    <th>Vị trí &amp; Nhân viên</th>
                    <th>Chi tiết chênh lệch</th>
                    <th class="text-end">Thất thoát</th>
                    <th class="text-end">Đã thu hồi</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Cases.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">Không có hồ sơ kiểm toán nào phù hợp với điều kiện lọc.</td>
                    </tr>
                }
                else
                {
                    @foreach (var c in Model.Cases)
                    {
                        var stClass = c.Status switch
                        {
                            "Resolved" => "bg-success",
                            "Investigating" => "bg-warning text-dark",
                            _ => "bg-danger"
                        };
                        <tr>
                            <td>
                                <div class="fw-semibold"><code>@c.CaseCode</code></div>
                                <span class="badge bg-secondary">@c.RuleCode</span>
                            </td>
                            <td>@c.OccurredAtVn.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <div class="fw-semibold">@c.LocationOrRef</div>
                                <small class="text-muted">NV: @c.ResponsibleStaff</small>
                            </td>
                            <td style="max-width: 340px;">
                                <div class="fw-semibold small">@c.LeakageType</div>
                                <div class="small text-muted">@c.EvidenceDetail</div>
                                @if (!string.IsNullOrEmpty(c.InvestigationNote))
                                {
                                    <div class="small text-primary mt-1"><strong>Ghi chú xử lý:</strong> @c.InvestigationNote</div>
                                }
                            </td>
                            <td class="text-end fw-bold text-danger">-@c.LeakageAmount.ToString("N0") ₫</td>
                            <td class="text-end fw-semibold text-success">
                                @(c.RecoveredAmount > 0 ? $"+{c.RecoveredAmount:N0} ₫" : "0 ₫")
                            </td>
                            <td>
                                <span class="badge @stClass">@c.StatusDisplayName</span>
                                @if (!string.IsNullOrEmpty(c.ResolutionType))
                                {
                                    <div class="small text-muted mt-1">@c.ResolutionDisplayName</div>
                                }
                            </td>
                            <td class="text-end">
                                @if (c.AuditCaseId.HasValue)
                                {
                                    <a asp-action="AuditDetail" asp-route-id="@c.AuditCaseId.Value" class="btn-outline-bms" style="padding:0.25rem 0.65rem;font-size:0.78rem">
                                        <i class="bi bi-folder2-open"></i> Xử lý
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
