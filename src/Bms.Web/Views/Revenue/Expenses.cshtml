@using Bms.Web.Data
@model Bms.Web.Models.ExpenseListViewModel
@{
    ViewData["Title"] = "Sổ cái chi phí vận hành";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@await Html.PartialAsync("_FinancialNav", "Expenses")
@await Html.PartialAsync("_Alerts")

<!-- 4 Thẻ thống kê chi phí -->
<div class="row g-3 mb-3">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon green"><i class="bi bi-check2-circle"></i></div>
            <div>
                <div class="stat-value text-success">@Model.TotalApprovedAmount.ToString("N0") ₫</div>
                <div class="stat-label">Đã duyệt (@Model.ApprovedCount phiếu)</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon amber"><i class="bi bi-hourglass-split"></i></div>
            <div>
                <div class="stat-value text-warning">@Model.TotalPendingAmount.ToString("N0") ₫</div>
                <div class="stat-label">Chờ phê duyệt (@Model.PendingCount phiếu)</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon red"><i class="bi bi-x-circle"></i></div>
            <div>
                <div class="stat-value text-danger">@Model.TotalRejectedAmount.ToString("N0") ₫</div>
                <div class="stat-label">Từ chối thanh toán (@Model.RejectedCount phiếu)</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon blue"><i class="bi bi-pie-chart"></i></div>
            <div>
                <div class="stat-value @(Model.BudgetUtilizationPercent > 100 ? "text-danger" : "text-primary")">@Model.BudgetUtilizationPercent%</div>
                <div class="stat-label">Tỷ lệ dùng ngân sách (@Model.PeriodBudgetCap.ToString("N0") ₫)</div>
            </div>
        </div>
    </div>
</div>

<!-- Tổng hợp 4 nhóm chi phí so với Định mức -->
<div class="row g-3 mb-3">
    @foreach (var cat in Model.CategorySummaries)
    {
        var overCap = cat.BudgetCap > 0 && cat.TotalAmount > cat.BudgetCap;
        <div class="col-md-3">
            <div class="data-card p-3 h-100">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-semibold" style="font-size:0.85rem">@cat.CategoryName</span>
                    <span class="badge @(overCap ? "bg-danger" : "bg-success")">
                        @(overCap ? "Vượt hạn mức" : "Trong hạn mức")
                    </span>
                </div>
                <div class="fs-5 fw-bold mt-1">@cat.TotalAmount.ToString("N0") ₫</div>
                <div class="text-muted" style="font-size:0.78rem">Định mức kỳ: @cat.BudgetCap.ToString("N0") ₫ (@cat.EntryCount phiếu)</div>
            </div>
        </div>
    }
</div>

<!-- Bộ lọc & Bảng danh sách phiếu chi -->
<div class="data-card">
    <div class="data-card-header">
        <span class="data-card-title">
            <i class="bi bi-journal-text me-2"></i>Danh sách phiếu chi vận hành (@Model.Items.Count phiếu)
        </span>
        <a asp-action="CreateExpense" class="btn-primary-bms">
            <i class="bi bi-plus-lg"></i> Lập phiếu chi mới
        </a>
    </div>

    <form asp-action="Expenses" method="get" class="row g-2 align-items-end p-3 border-bottom bg-light bg-opacity-50">
        <div class="col-md-2">
            <label class="form-label small">Từ ngày</label>
            <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">Đến ngày</label>
            <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">Nhóm chi phí</label>
            <select name="category" class="form-select form-select-sm">
                <option value="">Tất cả nhóm</option>
                <option value="Maintenance" selected="@(Model.Category == "Maintenance")">Bảo trì bàn &amp; thiết bị</option>
                <option value="InventoryCOGS" selected="@(Model.Category == "InventoryCOGS")">Giá vốn đồ uống</option>
                <option value="Utilities" selected="@(Model.Category == "Utilities")">Điện, nước &amp; mặt bằng</option>
                <option value="Payroll" selected="@(Model.Category == "Payroll")">Lương nhân sự</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">Ca làm việc</label>
            <select name="shiftPeriod" class="form-select form-select-sm">
                <option value="">Tất cả ca</option>
                <option value="Day" selected="@(Model.ShiftPeriod == "Day")">Ca ngày (08h–18h)</option>
                <option value="Night" selected="@(Model.ShiftPeriod == "Night")">Ca đêm (18h–02h)</option>
                <option value="All" selected="@(Model.ShiftPeriod == "All")">Toàn thời gian</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">Trạng thái</label>
            <select name="status" class="form-select form-select-sm">
                <option value="">Tất cả trạng thái</option>
                <option value="Pending" selected="@(Model.Status == "Pending")">Chờ phê duyệt</option>
                <option value="Approved" selected="@(Model.Status == "Approved")">Đã phê duyệt</option>
                <option value="Rejected" selected="@(Model.Status == "Rejected")">Đã từ chối</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">Tìm kiếm</label>
            <div class="input-group input-group-sm">
                <input type="text" name="keyword" value="@Model.Keyword" class="form-control" placeholder="Mã phiếu, nội dung..." />
                <button type="submit" class="btn-primary-bms"><i class="bi bi-search"></i></button>
            </div>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Mã phiếu</th>
                    <th>Ngày chi</th>
                    <th>Nhóm chi phí</th>
                    <th>Nội dung &amp; Nhà cung cấp</th>
                    <th>Bàn / Ca</th>
                    <th class="text-end">Số tiền</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">Không có phiếu chi nào phù hợp với bộ lọc.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        var badgeClass = item.Status switch
                        {
                            "Pending" => "bg-warning text-dark",
                            "Rejected" => "bg-danger",
                            _ => "bg-success"
                        };
                        <tr>
                            <td class="fw-semibold">
                                <a asp-action="ExpenseDetail" asp-route-id="@item.Id" class="text-decoration-none">
                                    @item.ExpenseCode
                                </a>
                            </td>
                            <td>@item.ExpenseDate.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge bg-secondary">@item.CategoryName</span></td>
                            <td>
                                <div class="fw-semibold">@item.Title</div>
                                <small class="text-muted">Đơn vị: @(item.VendorName ?? "Nội bộ")</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.ShiftDisplayName</span>
                                @if (!string.IsNullOrEmpty(item.TableCode))
                                {
                                    <span class="badge bg-info text-dark">Bàn @item.TableCode</span>
                                }
                            </td>
                            <td class="text-end fw-bold text-danger">@item.Amount.ToString("N0") ₫</td>
                            <td><span class="badge @badgeClass">@item.StatusDisplayName</span></td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-action="ExpenseDetail" asp-route-id="@item.Id" class="btn-outline-bms" style="padding:0.25rem 0.6rem;font-size:0.78rem">
                                        <i class="bi bi-pencil-square"></i> Chi tiết
                                    </a>
                                    @if (item.Status == "Pending")
                                    {
                                        <form asp-action="ReviewExpense" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="targetStatus" value="Approved" />
                                            <input type="hidden" name="reviewNote" value="Phê duyệt từ sổ cái chi phí" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                            <button type="submit" class="btn btn-sm btn-success" style="font-size:0.78rem">
                                                <i class="bi bi-check-lg"></i> Duyệt
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
