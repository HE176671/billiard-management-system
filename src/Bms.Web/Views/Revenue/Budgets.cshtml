@model Bms.Web.Models.BudgetManagementViewModel
@{
    ViewData["Title"] = "Định mức ngân sách & Kế hoạch vận hành";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@await Html.PartialAsync("_FinancialNav", "Budgets")
@await Html.PartialAsync("_Alerts")

<!-- 4 Thẻ thống kê ngân sách năm -->
<div class="row g-3 mb-3">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon blue"><i class="bi bi-bullseye"></i></div>
            <div>
                <div class="stat-value text-primary">@Model.TotalAnnualTargetRevenue.ToString("N0") ₫</div>
                <div class="stat-label">Mục tiêu thu (Thực đạt: @Model.TotalAnnualActualRevenue.ToString("N0") ₫)</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon amber"><i class="bi bi-wallet2"></i></div>
            <div>
                <div class="stat-value text-dark">@Model.TotalAnnualExpenseCap.ToString("N0") ₫</div>
                <div class="stat-label">Tổng trần chi (Thực chi: @Model.TotalAnnualActualExpense.ToString("N0") ₫)</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon green"><i class="bi bi-piggy-bank"></i></div>
            <div>
                @{
                    var diffCap = Model.TotalAnnualExpenseCap - Model.TotalAnnualActualExpense;
                }
                <div class="stat-value @(diffCap >= 0 ? "text-success" : "text-danger")">
                    @(diffCap >= 0 ? $"+{diffCap:N0} ₫" : $"-{Math.Abs(diffCap):N0} ₫")
                </div>
                <div class="stat-label">@(diffCap >= 0 ? "Chênh lệch tiết kiệm so với trần" : "Chênh lệch vượt trần chi phí")</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon red"><i class="bi bi-exclamation-circle"></i></div>
            <div>
                <div class="stat-value text-danger">@Model.OverBudgetMonthsCount / 12 tháng</div>
                <div class="stat-label">Số tháng vượt định mức chi</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Cột trái: Bảng 12 Tháng Định mức Ngân sách -->
    <div class="col-lg-8">
        <div class="data-card">
            <div class="data-card-header">
                <span class="data-card-title">
                    <i class="bi bi-calendar3-range me-2 text-primary"></i>Định mức ngân sách 12 tháng (@Model.Year)
                </span>
                <span class="small text-muted">Chọn <strong>Sửa</strong> trên từng tháng để cập nhật hạn mức ở biểu mẫu bên phải</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Kỳ</th>
                            <th class="text-end">Mục tiêu thu<br/><small class="text-muted">Thực đạt</small></th>
                            <th class="text-end">Định mức chi<br/><small class="text-muted">Thực chi</small></th>
                            <th>Trọng tâm &amp; Kế hoạch vận hành</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.Budgets)
                        {
                            var isSelected = b.PeriodMonth == Model.SelectedPeriod;
                            var stBadge = b.Status switch
                            {
                                "Locked" => "bg-secondary",
                                "Draft" => "bg-warning text-dark",
                                _ => "bg-success"
                            };
                            <tr class="@(isSelected ? "table-active" : "")">
                                <td class="fw-semibold">@b.PeriodMonth</td>
                                <td class="text-end">
                                    <div class="fw-semibold">@b.RevenueTarget.ToString("N0") ₫</div>
                                    <small class="text-muted">@b.ActualRevenue.ToString("N0") ₫</small>
                                </td>
                                <td class="text-end">
                                    <div class="fw-semibold @(b.IsOverBudget ? "text-danger" : "text-dark")">@b.TotalExpenseCap.ToString("N0") ₫</div>
                                    <small class="@(b.IsOverBudget ? "text-danger fw-semibold" : "text-muted")">
                                        @b.ActualTotalExpense.ToString("N0") ₫
                                    </small>
                                </td>
                                <td style="max-width: 280px;">
                                    <div class="fw-semibold text-dark" style="font-size:0.85rem">@b.StrategicFocus</div>
                                    <div class="text-muted" style="font-size: 0.78rem;">@b.ActionPlanSummary</div>
                                </td>
                                <td><span class="badge @stBadge">@b.StatusDisplayName</span></td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Budgets" asp-route-year="@Model.Year" asp-route-selectedPeriod="@b.PeriodMonth"
                                           class="btn-outline-bms" style="padding:0.25rem 0.6rem;font-size:0.78rem">
                                            <i class="bi bi-pencil"></i> Sửa
                                        </a>
                                        @if (b.Id > 0 && b.Status != "Locked")
                                        {
                                            <form asp-action="DeleteBudget" method="post" class="d-inline" onsubmit="return confirm('Xóa định mức tháng @b.PeriodMonth?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@b.Id" />
                                                <button type="submit" class="btn-sm-icon danger" title="Xóa định mức">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Cột phải: Biểu mẫu cập nhật định mức tháng -->
    <div class="col-lg-4">
        <div class="data-card p-4">
            <h6 class="fw-bold mb-3 pb-2 border-bottom">
                <i class="bi bi-sliders me-2 text-danger"></i>Thiết lập định mức kỳ <code>@Model.EditInput.PeriodMonth</code>
            </h6>
            <form asp-action="SaveBudget" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-2">
                    <label class="form-label small">Kỳ ngân sách (yyyy-MM) <span class="text-danger">*</span></label>
                    <input asp-for="EditInput.PeriodMonth" class="form-control form-control-sm fw-semibold" required />
                </div>
                <div class="mb-2">
                    <label class="form-label small">Mục tiêu doanh thu tháng (VNĐ) <span class="text-danger">*</span></label>
                    <input asp-for="EditInput.RevenueTarget" type="number" step="500000" class="form-control form-control-sm fw-semibold text-primary" required />
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small">Trần bảo trì bàn/cơ</label>
                        <input asp-for="EditInput.MaintenanceCap" type="number" step="100000" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label small">Trần nhập đồ uống</label>
                        <input asp-for="EditInput.InventoryCogsCap" type="number" step="100000" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label small">Trần điện &amp; nước</label>
                        <input asp-for="EditInput.UtilitiesCap" type="number" step="100000" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label small">Trần lương nhân sự</label>
                        <input asp-for="EditInput.PayrollCap" type="number" step="100000" class="form-control form-control-sm" required />
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label small">Trọng tâm tháng <span class="text-danger">*</span></label>
                    <input asp-for="EditInput.StrategicFocus" class="form-control form-control-sm" required maxlength="150" />
                </div>
                <div class="mb-2">
                    <label class="form-label small">Kế hoạch vận hành <span class="text-danger">*</span></label>
                    <textarea asp-for="EditInput.ActionPlanSummary" class="form-control form-control-sm" rows="3" required maxlength="1000"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label small">Trạng thái áp dụng</label>
                    <select asp-for="EditInput.Status" class="form-select form-select-sm">
                        <option value="Draft">Bản nháp</option>
                        <option value="Active">Đang áp dụng</option>
                        <option value="Locked">Đã khóa sổ</option>
                    </select>
                </div>
                <button type="submit" class="btn-primary-bms w-100 justify-content-center">
                    <i class="bi bi-check2"></i> Lưu định mức tháng
                </button>
            </form>
        </div>
    </div>
</div>
