@model Bms.Web.Models.RevenueReportViewModel
@using Bms.Web.Data
@using Bms.Web.Models
@{
    ViewData["Title"] = "Báo cáo doanh thu & Lợi nhuận";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@await Html.PartialAsync("_Alerts")

<!-- 1. Bộ lọc kỳ báo cáo -->
<div class="data-card p-3 mb-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label for="from" class="form-label">Từ ngày</label>
            <input id="from" name="from" type="date" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" required />
        </div>
        <div class="col-md-3">
            <label for="to" class="form-label">Đến ngày</label>
            <input id="to" name="to" type="date" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control" required />
        </div>
        <div class="col-md-2">
            <label for="groupBy" class="form-label">Nhóm theo</label>
            <select id="groupBy" name="groupBy" class="form-select">
                <option value="month" selected="@(Model.GroupBy == "month")">Theo tháng</option>
                <option value="day" selected="@(Model.GroupBy == "day")">Theo ngày</option>
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2 flex-wrap">
            <button class="btn-primary-bms" type="submit">
                <i class="bi bi-funnel"></i> Xem báo cáo
            </button>
            <a asp-action="Index" asp-route-from="2026-01-01" asp-route-to="2026-12-31" asp-route-groupBy="month" class="btn-outline-bms">
                <i class="bi bi-calendar3"></i> Cả năm 2026
            </a>
            <form asp-action="SeedYearData" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-outline-bms" title="Làm mới dữ liệu mẫu 12 tháng">
                    <i class="bi bi-arrow-clockwise"></i> Đồng bộ dữ liệu
                </button>
            </form>
        </div>
    </form>
    <div asp-validation-summary="All" class="text-danger mt-2" style="font-size:0.85rem"></div>
</div>

@if (Model.PaymentCount == 0 && Model.ExpenseItems.Count == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle-fill me-2"></i>Chưa có dữ liệu giao dịch trong khoảng thời gian đã chọn.
    </div>
}

<!-- 2. Chỉ số tài chính tổng quan -->
<div class="row g-3 mb-4">
    <!-- Tổng doanh thu thực thu -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card flex-column align-items-start h-100">
            <div class="d-flex align-items-center gap-3 w-100">
                <div class="stat-icon green"><i class="bi bi-cash-stack"></i></div>
                <div>
                    <div class="stat-value text-success">@Model.TotalRevenue.ToString("N0") ₫</div>
                    <div class="stat-label">Tổng doanh thu (@Model.InvoiceCount HĐ · @Model.PaymentCount GD)</div>
                </div>
            </div>
            <div class="w-100 pt-2 mt-2 border-top text-muted" style="font-size:0.78rem">
                Giờ bàn: <strong>@Model.TotalPlaytimeRevenue.ToString("N0") ₫</strong> · Đồ uống: <strong>@Model.TotalFnbRevenue.ToString("N0") ₫ (@Model.FnbSharePercent%)</strong>
            </div>
        </div>
    </div>

    <!-- Tổng chi phí vận hành -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card flex-column align-items-start h-100">
            <div class="d-flex align-items-center gap-3 w-100">
                <div class="stat-icon amber"><i class="bi bi-receipt"></i></div>
                <div>
                    <div class="stat-value text-warning">@Model.TotalOperatingCost.ToString("N0") ₫</div>
                    <div class="stat-label">Chi phí vận hành đã duyệt</div>
                </div>
            </div>
            <div class="w-100 pt-2 mt-2 border-top text-muted" style="font-size:0.78rem">
                Định mức kỳ: <strong>@Model.TotalBudgetCap.ToString("N0") ₫</strong> · Chờ duyệt: <strong>@Model.PendingExpenseCount phiếu</strong>
            </div>
        </div>
    </div>

    <!-- Lợi nhuận ròng -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card flex-column align-items-start h-100">
            <div class="d-flex align-items-center gap-3 w-100">
                <div class="stat-icon @(Model.NetProfit >= 0 ? "blue" : "red")">
                    <i class="bi @(Model.NetProfit >= 0 ? "bi-graph-up-arrow" : "bi-graph-down-arrow")"></i>
                </div>
                <div>
                    <div class="stat-value @(Model.NetProfit >= 0 ? "text-primary" : "text-danger")">
                        @(Model.NetProfit >= 0 ? "+" : "")@Model.NetProfit.ToString("N0") ₫
                    </div>
                    <div class="stat-label">Lợi nhuận ròng (Tỷ suất: @Model.NetMarginPercent%)</div>
                </div>
            </div>
            <div class="w-100 pt-2 mt-2 border-top text-muted" style="font-size:0.78rem">
                Kết quả: <strong class="text-success">@Model.ProfitablePeriodsCount kỳ lãi</strong> · <strong class="text-danger">@Model.LossPeriodsCount kỳ lỗ</strong>
                @if (Model.TotalRecoveredAmount > 0)
                {
                    <span>(Thu hồi: +@Model.TotalRecoveredAmount.ToString("N0") ₫)</span>
                }
            </div>
        </div>
    </div>

    <!-- Kiểm toán thất thoát -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card flex-column align-items-start h-100">
            <div class="d-flex align-items-center gap-3 w-100">
                <div class="stat-icon red"><i class="bi bi-shield-exclamation"></i></div>
                <div>
                    <div class="stat-value text-danger">-@Model.TotalLeakageAmount.ToString("N0") ₫</div>
                    <div class="stat-label">Chênh lệch / Thất thoát phát hiện</div>
                </div>
            </div>
            <div class="w-100 pt-2 mt-2 border-top text-muted" style="font-size:0.78rem">
                Chờ xử lý: <strong class="text-danger">@Model.OpenAuditCaseCount vụ</strong> · Đã xử lý: <strong class="text-success">@Model.ResolvedAuditCaseCount vụ</strong>
            </div>
        </div>
    </div>
</div>

<!-- 3. Các chức năng nghiệp vụ tài chính (Bấm vào từng chức năng để mở màn hình tương ứng) -->
<div class="data-card p-3 mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <div class="fw-semibold" style="font-size:0.9rem">
                <i class="bi bi-grid-1x2-fill text-danger me-2"></i>Chức năng quản trị tài chính &amp; kiểm soát nội bộ
            </div>
            <div class="text-muted" style="font-size:0.8rem">
                Chọn chức năng bên phải để thao tác chi tiết trên từng nghiệp vụ
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Expenses" class="btn-primary-bms">
                <i class="bi bi-journal-text"></i> Sổ cái &amp; Duyệt chi phí
                @if (Model.PendingExpenseCount > 0)
                {
                    <span class="badge bg-light text-danger ms-1">@Model.PendingExpenseCount</span>
                }
            </a>
            <a asp-action="CreateExpense" class="btn-outline-bms">
                <i class="bi bi-plus-circle"></i> Lập phiếu chi mới
            </a>
            <a asp-action="AuditCases" class="btn-outline-bms">
                <i class="bi bi-shield-check"></i> Kiểm toán thất thoát
                @if (Model.OpenAuditCaseCount > 0)
                {
                    <span class="badge bg-danger ms-1">@Model.OpenAuditCaseCount</span>
                }
            </a>
            <a asp-action="Budgets" class="btn-outline-bms">
                <i class="bi bi-sliders"></i> Định mức ngân sách tháng
            </a>
            <a asp-action="Export"
               asp-route-from="@Model.From.ToString("yyyy-MM-dd")"
               asp-route-to="@Model.To.ToString("yyyy-MM-dd")"
               asp-route-groupBy="@Model.GroupBy"
               class="btn-outline-bms">
                <i class="bi bi-download"></i> Xuất báo cáo CSV
            </a>
        </div>
    </div>
</div>

<!-- 4. Điểm nhấn phân tích theo mùa vụ và ca hoạt động -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="data-card p-3 h-100 border-start border-4 border-success">
            <div class="fw-semibold text-success mb-1" style="font-size:0.88rem">
                <i class="bi bi-graph-up me-1"></i>Chu kỳ cao điểm giờ chơi (Tháng 3 – Tháng 5)
            </div>
            <p class="mb-0 text-muted" style="font-size:0.8rem">@Model.PeakRevenueMonthsSummary</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="data-card p-3 h-100 border-start border-4 border-info">
            <div class="fw-semibold text-primary mb-1" style="font-size:0.88rem">
                <i class="bi bi-cup-straw me-1"></i>Chu kỳ cao điểm đồ uống (Tháng 4 – Tháng 6)
            </div>
            <p class="mb-0 text-muted" style="font-size:0.8rem">@Model.PeakBeverageMonthsSummary</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="data-card p-3 h-100 border-start border-4 border-warning">
            <div class="fw-semibold text-dark mb-1" style="font-size:0.88rem">
                <i class="bi bi-clock-history me-1 text-warning"></i>Hiệu suất Ca Đêm (@Model.DayNight.NightRevenueSharePercent%) vs Ca Ngày (@Model.DayNight.DayRevenueSharePercent%)
            </div>
            <p class="mb-0 text-muted" style="font-size:0.8rem">@Model.DayNight.ProblemSolvedExplanation</p>
        </div>
    </div>
</div>

<!-- 5. Biểu đồ Doanh thu - Chi phí - Lợi nhuận & Cơ cấu chi phí -->
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="data-card h-100">
            <div class="data-card-header">
                <span class="data-card-title">
                    <i class="bi bi-bar-chart-line me-2 text-danger"></i>Biểu đồ Doanh thu, Chi phí vận hành &amp; Lợi nhuận ròng
                </span>
                <span class="text-muted" style="font-size:0.75rem">Đơn vị: VNĐ</span>
            </div>
            <div class="p-3">
                <div style="position:relative;height:320px;width:100%">
                    <canvas id="pnlChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="data-card h-100">
            <div class="data-card-header">
                <span class="data-card-title">
                    <i class="bi bi-pie-chart me-2 text-warning"></i>Cơ cấu 4 nhóm chi phí vận hành
                </span>
            </div>
            <div class="p-3">
                <div style="position:relative;height:200px;width:100%">
                    <canvas id="expensePieChart"></canvas>
                </div>
                <div class="mt-3 pt-2 border-top d-flex flex-column gap-2" style="font-size:0.82rem">
                    @foreach (var cat in Model.ExpenseCategories)
                    {
                        <div class="d-flex justify-content-between align-items-center">
                            <span>@cat.CategoryName</span>
                            <span>
                                <strong>@cat.TotalAmount.ToString("N0") ₫</strong>
                                <span class="text-muted">(@cat.ShareOfTotalExpensePercent%)</span>
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 6. Bảng tổng hợp kết quả kinh doanh (P&L) theo kỳ -->
<div class="data-card mb-4">
    <div class="data-card-header">
        <span class="data-card-title">
            <i class="bi bi-table me-2 text-primary"></i>Bảng tổng hợp Doanh thu – Chi phí – Lợi nhuận theo kỳ
        </span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Kỳ</th>
                    <th>Thu giờ chơi</th>
                    <th>Thu đồ uống</th>
                    <th>Tổng thực thu</th>
                    <th>Chi bảo trì</th>
                    <th>Chi nhập nước</th>
                    <th>Chi điện nước</th>
                    <th>Chi lương</th>
                    <th>Lợi nhuận ròng</th>
                    <th>Nhận xét vận hành</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.PnlPeriods)
                {
                    var isLoss = row.TotalExpense > 0 && row.NetProfit < 0;
                    <tr class="@(isLoss ? "table-danger" : "")">
                        <td class="fw-semibold">
                            @row.Period
                            @if (row.IsPeakRevenue)
                            {
                                <span class="badge bg-success ms-1">Cao điểm thu</span>
                            }
                            @if (row.IsPeakBeverage)
                            {
                                <span class="badge bg-info text-dark ms-1">Cao điểm nước</span>
                            }
                            @if (row.IsOverBudget)
                            {
                                <span class="badge bg-warning text-dark ms-1">Vượt định mức</span>
                            }
                        </td>
                        <td>
                            <div class="fw-semibold">@row.PlaytimeRevenue.ToString("N0") ₫</div>
                            @if (row.PlaytimeRevenue > 0)
                            {
                                <small class="text-muted">Ca đêm: @row.NightSharePercent%</small>
                            }
                        </td>
                        <td>
                            <div class="fw-semibold">@row.FnbRevenue.ToString("N0") ₫</div>
                            @if (row.FnbSharePercent > 0)
                            {
                                <small class="text-muted">(@row.FnbSharePercent%)</small>
                            }
                        </td>
                        <td class="fw-semibold">
                            @row.CollectedRevenue.ToString("N0") ₫
                            @if (row.RecoveredAmount > 0)
                            {
                                <div class="small text-success">+@row.RecoveredAmount.ToString("N0") ₫ thu hồi</div>
                            }
                        </td>
                        <td>@row.MaintenanceCost.ToString("N0") ₫</td>
                        <td>@row.InventoryCogsCost.ToString("N0") ₫</td>
                        <td>@row.UtilitiesCost.ToString("N0") ₫</td>
                        <td>@row.PayrollCost.ToString("N0") ₫</td>
                        <td class="fw-bold @(row.NetProfit >= 0 ? "text-success" : "text-danger")">
                            @(row.NetProfit >= 0 ? "+" : "")@row.NetProfit.ToString("N0") ₫
                        </td>
                        <td style="max-width:290px;font-size:0.8rem" class="text-muted">@row.DiagnosticReason</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- 7. Phương thức thanh toán & Top mặt hàng đồ uống -->
<div class="row g-4">
    <div class="col-lg-5">
        <div class="data-card h-100">
            <div class="data-card-header">
                <span class="data-card-title">
                    <i class="bi bi-credit-card me-2"></i>Doanh thu theo phương thức thanh toán
                </span>
            </div>
            <table class="table">
                <thead>
                    <tr>
                        <th>Phương thức</th>
                        <th>Doanh thu</th>
                        <th>Số giao dịch</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Methods)
                    {
                        <tr>
                            <td class="fw-semibold">@row.Method</td>
                            <td>@row.Revenue.ToString("N0") ₫</td>
                            <td>@row.PaymentCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="data-card h-100">
            <div class="data-card-header">
                <span class="data-card-title">
                    <i class="bi bi-cup-straw me-2 text-primary"></i>Sản lượng tiêu thụ đồ uống &amp; bia trong kỳ
                </span>
            </div>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Mặt hàng</th>
                            <th>Số lượng</th>
                            <th>Tổng doanh thu</th>
                            <th>Doanh thu T4–T6</th>
                            <th>Ghi chú tồn kho</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.TopBeverages.Count == 0)
                        {
                            <tr><td colspan="5" class="text-muted text-center py-3">Chưa có dữ liệu đơn hàng đồ uống trong kỳ.</td></tr>
                        }
                        else
                        {
                            @foreach (var bev in Model.TopBeverages)
                            {
                                <tr>
                                    <td class="fw-semibold">@bev.ProductName</td>
                                    <td>@bev.TotalQuantitySold</td>
                                    <td class="fw-semibold">@bev.TotalRevenue.ToString("N0") ₫ (@bev.ShareOfFnbPercent%)</td>
                                    <td class="text-primary fw-semibold">@bev.PeakSummerRevenue.ToString("N0") ₫</td>
                                    <td style="font-size:0.78rem" class="text-muted">@bev.ProblemSolvedNote</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
    <script>
        const pnlLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PnlPeriods.Select(x => x.Period)));
        const revData   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PnlPeriods.Select(x => x.CollectedRevenue)));
        const expData   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PnlPeriods.Select(x => x.TotalExpense)));
        const netData   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PnlPeriods.Select(x => x.NetProfit)));

        const ctxPnl = document.getElementById('pnlChart').getContext('2d');
        new Chart(ctxPnl, {
            type: 'bar',
            data: {
                labels: pnlLabels,
                datasets: [
                    {
                        type: 'line',
                        label: 'Lợi nhuận ròng (VNĐ)',
                        data: netData,
                        borderColor: '#e94560',
                        backgroundColor: '#e94560',
                        borderWidth: 3,
                        tension: 0.3,
                        pointRadius: 4,
                        yAxisID: 'y'
                    },
                    {
                        type: 'bar',
                        label: 'Tổng thực thu (VNĐ)',
                        data: revData,
                        backgroundColor: 'rgba(16, 185, 129, 0.75)',
                        borderRadius: 4,
                        yAxisID: 'y'
                    },
                    {
                        type: 'bar',
                        label: 'Chi phí vận hành (VNĐ)',
                        data: expData,
                        backgroundColor: 'rgba(245, 158, 11, 0.75)',
                        borderRadius: 4,
                        yAxisID: 'y'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'top' }
                },
                scales: {
                    y: {
                        ticks: {
                            callback: function(value) {
                                if (Math.abs(value) >= 1000000) return (value / 1000000) + ' tr';
                                return value;
                            }
                        }
                    }
                }
            }
        });

        const catLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpenseCategories.Select(x => x.CategoryName)));
        const catValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpenseCategories.Select(x => x.TotalAmount)));
        const ctxPie = document.getElementById('expensePieChart').getContext('2d');
        new Chart(ctxPie, {
            type: 'doughnut',
            data: {
                labels: catLabels,
                datasets: [{
                    data: catValues,
                    backgroundColor: ['#e94560', '#f59e0b', '#3b82f6', '#10b981'],
                    borderWidth: 2,
                    borderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                cutout: '62%'
            }
        });
    </script>
}
