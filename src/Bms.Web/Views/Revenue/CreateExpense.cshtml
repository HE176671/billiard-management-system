@model Bms.Web.Models.CreateExpenseScreenViewModel
@{
    ViewData["Title"] = "Lập phiếu chi vận hành mới";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@await Html.PartialAsync("_FinancialNav", "CreateExpense")
@await Html.PartialAsync("_Alerts")

<div class="row g-3">
    <!-- Cột trái: Form Lập Phiếu Chi -->
    <div class="col-lg-7">
        <div class="data-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <h6 class="fw-bold mb-0"><i class="bi bi-file-earmark-plus me-2 text-danger"></i>Thông tin phiếu chi vận hành</h6>
                <span class="text-muted small">Kỳ ngân sách: <strong>@Model.CurrentPeriodMonth</strong></span>
            </div>

            <form asp-action="CreateExpense" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Ngày phát sinh <span class="text-danger">*</span></label>
                        <input asp-for="Input.ExpenseDate" type="date" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Nhóm chi phí <span class="text-danger">*</span></label>
                        <select asp-for="Input.Category" class="form-select" required>
                            <option value="Maintenance">Bảo trì bàn, vải nỉ, gậy &amp; bi</option>
                            <option value="InventoryCOGS">Giá vốn nhập bia &amp; nước giải khát</option>
                            <option value="Utilities">Tiền điện, nước &amp; mặt bằng</option>
                            <option value="Payroll">Lương nhân sự theo ca</option>
                        </select>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Nội dung khoản chi <span class="text-danger">*</span></label>
                        <input asp-for="Input.Title" class="form-control" placeholder="Nhập nội dung khoản chi..." required maxlength="150" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Số tiền (VNĐ) <span class="text-danger">*</span></label>
                        <input asp-for="Input.Amount" type="number" min="1000" max="1000000000" step="1000" class="form-control fw-bold text-danger" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Nhà cung cấp / Đơn vị nhận</label>
                        <input asp-for="Input.VendorName" class="form-control" placeholder="Tên nhà cung cấp hoặc bộ phận..." maxlength="150" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Ca phân bổ</label>
                        <select asp-for="Input.ShiftPeriod" class="form-select">
                            <option value="All">Toàn thời gian</option>
                            <option value="Day">Ca ngày (08:00–18:00)</option>
                            <option value="Night">Ca đêm (18:00–02:00)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Bàn liên quan</label>
                        <select asp-for="Input.TableId" class="form-select">
                            <option value="">Chi phí chung toàn quán</option>
                            @foreach (var t in Model.TableOptions)
                            {
                                <option value="@t.Id">@t.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Trạng thái phiếu</label>
                        <select asp-for="Input.InitialStatus" class="form-select">
                            <option value="Pending">Chờ phê duyệt</option>
                            <option value="Approved">Duyệt và ghi sổ ngay</option>
                        </select>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Ghi chú chứng từ</label>
                        <textarea asp-for="Input.Notes" class="form-control" rows="3" maxlength="500" placeholder="Số hóa đơn, chứng từ kèm theo hoặc lý do chi..."></textarea>
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Expenses" class="btn-outline-bms">Hủy</a>
                    <button type="submit" class="btn-primary-bms">
                        <i class="bi bi-check2"></i> Lưu phiếu chi
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Cột phải: Theo dõi hạn mức ngân sách tháng -->
    <div class="col-lg-5">
        <div class="data-card p-4 h-100">
            <h6 class="fw-bold mb-2 pb-2 border-bottom">
                <i class="bi bi-speedometer2 me-2 text-primary"></i>Hạn mức ngân sách kỳ @Model.CurrentPeriodMonth
            </h6>
            <p class="small text-muted mb-3">
                Đối chiếu số tiền đã duyệt chi trong tháng với định mức trần của từng nhóm chi phí.
            </p>
            @foreach (var b in Model.CategoryBudgets)
            {
                var pct = Math.Min(100m, b.UsagePercent);
                var barColor = b.UsagePercent > 100 ? "bg-danger" : (b.UsagePercent >= 80 ? "bg-warning" : "bg-success");
                <div class="border rounded p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fw-semibold small">@b.CategoryName</span>
                        <span class="badge @(b.UsagePercent > 100 ? "bg-danger" : "bg-secondary")">@b.UsagePercent%</span>
                    </div>
                    <div class="progress mb-2" style="height: 7px;">
                        <div class="progress-bar @barColor" role="progressbar" style="width: @pct.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                    </div>
                    <div class="d-flex justify-content-between small text-muted">
                        <span>Đã chi: <strong>@b.ActualApproved.ToString("N0") ₫</strong></span>
                        <span>Định mức: <strong>@b.BudgetCap.ToString("N0") ₫</strong></span>
                    </div>
                    <div class="small mt-1 @(b.RemainingCap < 0 ? "text-danger fw-semibold" : "text-success")">
                        @(b.RemainingCap >= 0
                            ? $"Hạn mức còn lại: {b.RemainingCap:N0} ₫"
                            : $"Vượt định mức tháng: {Math.Abs(b.RemainingCap):N0} ₫")
                    </div>
                </div>
            }
        </div>
    </div>
</div>
