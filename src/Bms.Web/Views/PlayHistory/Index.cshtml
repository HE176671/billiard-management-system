@model Bms.Web.Models.PlayHistoryListViewModel
@{
    ViewData["Title"] = "Lịch sử phiên chơi";
    Layout = "_AdminLayout";
}

<div class="data-card">
    <div class="data-card-header">
        <span class="data-card-title"><i class="bi bi-clock-history me-2"></i>Lịch sử phiên chơi</span>
        @if (Model.TotalCount > 0)
        {
            <span style="font-size:0.8rem;color:#64748b">Tổng: @Model.TotalCount phiên</span>
        }
    </div>

    @if (!Model.Sessions.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
            Bạn chưa có phiên chơi nào.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Bàn</th>
                        <th>Bắt đầu</th>
                        <th>Kết thúc</th>
                        <th>Thời lượng</th>
                        <th class="text-end">Tổng tiền (₫)</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Sessions)
                    {
                        <tr>
                            <td><code style="font-size:0.8rem">#@s.Id</code></td>
                            <td>
                                <strong>@s.TableCode</strong>
                                <span style="font-size:0.78rem;color:#64748b"> @s.TableTypeName</span>
                            </td>
                            <td>@s.StartAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (s.IsActive || !s.EndAtUtc.HasValue) { <span>—</span> }
                                else { @s.EndAtUtc.Value.AddHours(7).ToString("dd/MM/yyyy HH:mm") }
                            </td>
                            <td>@s.DurationDisplay</td>
                            <td class="text-end">
                                @if (s.TotalAmount.HasValue)
                                {
                                    <span class="fw-semibold">@s.TotalAmount.Value.ToString("#,##0")</span>
                                    @if (s.FoodAmount > 0)
                                    {
                                        <div style="font-size:0.72rem;color:#64748b" title="Gồm @s.FoodAmount.ToString("#,##0") ₫ đồ ăn/uống">
                                            <i class="bi bi-cup-straw"></i> +@s.FoodAmount.ToString("#,##0")
                                        </div>
                                    }
                                }
                                else { <span>—</span> }
                            </td>

                            <td>
                                @if (s.IsActive)
                                { <span class="badge-active">Đang chơi</span> }
                                else
                                { <span class="badge-inactive" style="background:#e0f2fe;color:#0369a1">Đã kết thúc</span> }
                            </td>
                            <td>
                                <a asp-action="Detail" asp-route-id="@s.Id"
                                   class="btn-sm-icon" title="Xem chi tiết">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Phân trang -->
        @if (Model.TotalPages > 1)
        {
            <div class="d-flex justify-content-center align-items-center gap-2 py-3">
                @if (Model.Page > 1)
                {
                    <a asp-action="Index" asp-route-page="@(Model.Page - 1)"
                       class="btn-sm-icon" title="Trang trước">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                }
                @for (int i = Math.Max(1, Model.Page - 2); i <= Math.Min(Model.TotalPages, Model.Page + 2); i++)
                {
                    <a asp-action="Index" asp-route-page="@i"
                       class="btn-sm-icon @(i == Model.Page ? "active" : "")"
                       style="@(i == Model.Page ? "background:#e94560;color:#fff;border-color:#e94560" : "")">
                        @i
                    </a>
                }
                @if (Model.Page < Model.TotalPages)
                {
                    <a asp-action="Index" asp-route-page="@(Model.Page + 1)"
                       class="btn-sm-icon" title="Trang sau">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                }
            </div>
        }
    }
</div>
