@model Bms.Web.Models.PlayHistoryDetailViewModel
@{
    ViewData["Title"] = $"Chi tiết phiên #{Model.Id}";
    Layout = "_AdminLayout";
}

<div class="mb-3">
    <a asp-action="Index" class="btn-outline-bms">
        <i class="bi bi-arrow-left"></i> Danh sách phiên
    </a>
</div>

<div class="row g-4">
    <!-- Thông tin phiên -->
    <div class="col-lg-6">
        <div class="form-card h-100">
            <div class="data-card-header mb-3" style="border-bottom:1px solid #f1f5f9;padding-bottom:0.75rem">
                <span class="data-card-title">
                    <i class="bi bi-table me-2"></i>Thông tin phiên chơi
                </span>
                @if (Model.IsActive)
                { <span class="badge-active">Đang chơi</span> }
                else
                { <span class="badge-inactive" style="background:#e0f2fe;color:#0369a1">Đã kết thúc</span> }
            </div>

            <div class="row g-3">
                <div class="col-6">
                    <div class="form-label text-muted" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:.5px">Mã phiên</div>
                    <div><code>#@Model.Id</code></div>
                </div>
                <div class="col-6">
                    <div class="form-label text-muted" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:.5px">Bàn</div>
                    <div><strong>@Model.TableCode</strong> <span style="color:#64748b;font-size:0.85rem">(@Model.TableTypeName – Tầng @Model.FloorNumber)</span></div>
                </div>
                <div class="col-6">
                    <div class="form-label text-muted" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:.5px">Bắt đầu</div>
                    <div>@Model.StartAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                <div class="col-6">
                    <div class="form-label text-muted" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:.5px">Kết thúc</div>
                    <div>
                        @if (Model.IsActive || !Model.EndAtUtc.HasValue) { <span>—</span> }
                        else { @Model.EndAtUtc.Value.AddHours(7).ToString("dd/MM/yyyy HH:mm") }
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-label text-muted" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:.5px">Thời lượng</div>
                    <div>@Model.DurationDisplay</div>
                </div>
                <div class="col-6">
                    <div class="form-label text-muted" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:.5px">Giá/giờ</div>
                    <div>@Model.HourlyRateSnapshot.ToString("#,##0") ₫</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tóm tắt tiền & điểm -->
    <div class="col-lg-6">
        <div class="form-card h-100">
            <div class="data-card-header mb-3" style="border-bottom:1px solid #f1f5f9;padding-bottom:0.75rem">
                <span class="data-card-title"><i class="bi bi-receipt me-2"></i>Tổng kết</span>
            </div>

            <div class="row g-3">
                <div class="col-6">
                    <div class="stat-card" style="flex-direction:column;align-items:flex-start;gap:0.25rem">
                        <div class="stat-label">Tiền giờ chơi</div>
                        <div class="stat-value" style="font-size:1.2rem">
                            @if (Model.PlaytimeAmount.HasValue)
                            { @($"{Model.PlaytimeAmount.Value:#,##0} ₫") }
                            else { <span style="font-size:0.9rem;color:#94a3b8">Chưa có</span> }
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="stat-card" style="flex-direction:column;align-items:flex-start;gap:0.25rem">
                        <div class="stat-label">Tiền đồ ăn / uống</div>
                        <div class="stat-value" style="font-size:1.2rem">
                            @Model.FoodAmount.ToString("#,##0") ₫
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="stat-card" style="flex-direction:column;align-items:flex-start;gap:0.25rem;background:#f8fafc">
                        <div class="stat-label">Tổng tiền phiên</div>
                        <div class="stat-value" style="font-size:1.2rem;color:var(--primary);font-weight:800">
                            @Model.TotalBillAmount.ToString("#,##0") ₫
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="stat-card" style="flex-direction:column;align-items:flex-start;gap:0.25rem">
                        <div class="stat-label">Điểm nhận được</div>
                        <div class="stat-value" style="font-size:1.2rem;color:#f59e0b">
                            @if (!Model.IsActive)
                            { @($"+{Model.SessionPoints} điểm") }
                            else { <span style="font-size:0.9rem;color:#94a3b8">—</span> }
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.IsActive)
            {
                <div class="mt-3 p-3 rounded-3" style="background:#f0fdf4;border:1px solid #bbf7d0;font-size:0.85rem;color:#166534">
                    <i class="bi bi-info-circle me-2"></i>Phiên đang diễn ra. Điểm sẽ được tính sau khi phiên kết thúc.
                </div>
            }
        </div>
    </div>
</div>

<!-- Đồ uống & đồ ăn đã gọi (UC07) -->
<div class="data-card mt-4">
    <div class="data-card-header">
        <span class="data-card-title"><i class="bi bi-cup-straw me-2"></i>Đồ ăn / uống đã gọi</span>
        @if (Model.OrderedItems.Any())
        {
            <span style="font-size:0.85rem;color:#64748b">Tổng: @Model.OrderedItems.Count món</span>
        }
    </div>
    @if (!Model.OrderedItems.Any())
    {
        <div class="text-center py-4 text-muted" style="font-size:0.875rem">
            <i class="bi bi-cup-straw me-1 fs-4 d-block mb-2"></i>
            Chưa có món nào được gọi trong phiên này.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th style="width:50px">#</th>
                        <th>Tên món</th>
                        <th class="text-center" style="width:120px">Số lượng</th>
                        <th class="text-end" style="width:140px">Đơn giá (₫)</th>
                        <th class="text-end" style="width:160px">Thành tiền (₫)</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int idx = 1; }
                    @foreach (var item in Model.OrderedItems)
                    {
                        <tr>
                            <td><span class="text-muted">@idx</span></td>
                            <td><strong>@item.ProductName</strong></td>
                            <td class="text-center"><span class="badge" style="background:#e2e8f0;color:#1e293b;font-size:0.85rem">×@item.Quantity</span></td>
                            <td class="text-end">@item.UnitPrice.ToString("#,##0") ₫</td>
                            <td class="text-end font-monospace fw-semibold">@item.Subtotal.ToString("#,##0") ₫</td>
                        </tr>
                        idx++;
                    }
                </tbody>
                <tfoot>
                    <tr style="background:#f8fafc;font-weight:600">
                        <td colspan="4" class="text-end">Tổng tiền đồ ăn / uống:</td>
                        <td class="text-end" style="color:var(--primary)">@Model.FoodAmount.ToString("#,##0") ₫</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>

