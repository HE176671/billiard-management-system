@model Bms.Web.Models.CreateEditTierViewModel
@{
    bool isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Sửa hạng thành viên" : "Thêm hạng thành viên";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-3">
    <a asp-action="Index" class="btn-outline-bms">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

<div class="form-card">
    <h6 class="fw-bold mb-4">@ViewData["Title"]</h6>

    <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
        @Html.AntiForgeryToken()
        @if (isEdit) { <input type="hidden" asp-for="Id" /> }

        <div asp-validation-summary="All" class="alert alert-danger py-2 mb-3" style="font-size:0.85rem"></div>

        <div class="mb-3">
            <label asp-for="TierName" class="form-label">Tên hạng <span class="text-danger">*</span></label>
            <input asp-for="TierName" class="form-control" placeholder="Vd: Đồng, Bạc, Vàng..." />
            <span asp-validation-for="TierName" class="field-error"></span>
        </div>

        <div class="mb-3">
            <label asp-for="MinPoints" class="form-label">Điểm tối thiểu <span class="text-danger">*</span></label>
            <input asp-for="MinPoints" class="form-control" type="number" min="0" />
            <div class="form-text">Khách hàng cần tích đủ số điểm này để đạt hạng.</div>
            <span asp-validation-for="MinPoints" class="field-error"></span>
        </div>

        <div class="mb-4">
            <label asp-for="DiscountPercent" class="form-label">Giảm giá (%) <span class="text-danger">*</span></label>
            <input asp-for="DiscountPercent" class="form-control" type="number" min="0" max="100" step="0.5" />
            <div class="form-text">Áp dụng cho mỗi hóa đơn khi khách ở hạng này.</div>
            <span asp-validation-for="DiscountPercent" class="field-error"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-primary-bms">
                <i class="bi bi-check-lg"></i> @(isEdit ? "Lưu thay đổi" : "Thêm hạng")
            </button>
            <a asp-action="Index" class="btn-outline-bms">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
