@model Bms.Web.Models.ResetStaffPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = "_AdminLayout";
}
<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn-sm-icon"><i class="bi bi-arrow-left"></i></a>
    <h5 class="mb-0">Đặt lại mật khẩu — @Model.FullName</h5>
</div>
<div class="form-card">
    <div class="mb-4 p-3 rounded-3" style="background:#fff8f0;border:1px solid #fed7aa;font-size:0.82rem;color:#92400e">
        <i class="bi bi-exclamation-triangle-fill me-1"></i>
        Mật khẩu cũ của <strong>@Model.UserName</strong> sẽ bị xóa và thay bằng mật khẩu mới.
        Hãy thông báo cho nhân viên sau khi đặt lại.
    </div>
    <form asp-action="ResetPassword" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="FullName" />
        <input type="hidden" asp-for="UserName" />

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(string.Empty))
        {
            <div class="alert alert-danger rounded-3 mb-3" style="font-size:0.875rem">
                @foreach (var err in ViewData.ModelState[string.Empty]!.Errors)
                { <div>@err.ErrorMessage</div> }
            </div>
        }

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" placeholder="Tối thiểu 8 ký tự" />
                <div class="form-text">Gồm chữ hoa, số và ký tự đặc biệt (vd: @@, #, !).</div>
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu mới" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
            <div class="col-12 d-flex gap-2 pt-2">
                <button type="submit" class="btn-primary-bms">
                    <i class="bi bi-key"></i> Đặt lại mật khẩu
                </button>
                <a asp-action="Index" class="btn-outline-bms">Hủy</a>
            </div>
        </div>
    </form>
</div>
