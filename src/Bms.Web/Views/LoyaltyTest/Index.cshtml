@model Bms.Web.Models.LoyaltyTestViewModel
@using Bms.Web.Services
@{
    ViewData["Title"] = "Tính tiền & Tích điểm hội viên";
    Layout = "_AdminLayout";
    var detail = Model.CustomerDetail;
    var p = Model.Preview;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3 rounded-3" style="font-size:0.875rem">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show mb-3 rounded-3" style="font-size:0.875rem">
        <i class="bi bi-shield-exclamation me-2"></i>@TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3 rounded-3" style="font-size:0.875rem">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3">
    <!-- Trái: Form nhập hóa đơn -->
    <div class="col-lg-7">
        <div class="data-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <h2 class="h6 fw-bold mb-0">
                    <i class="bi bi-receipt me-2 text-danger"></i>Thông tin hóa đơn thanh toán
                </h2>
            </div>

            <!-- Chọn khách hàng -->
            <form method="get" asp-action="Index" class="mb-3">
                <label class="form-label">Khách hàng hội viên</label>
                <div class="d-flex gap-2">
                    <select name="customerId" id="customerIdSelect" class="form-select" onchange="this.form.submit()">
                        @foreach (var c in Model.Customers)
                        {
                            <option value="@c.Id" selected="@(c.Id == Model.SelectedCustomerId)">
                                @c.FullName — @(c.PhoneNumber ?? "—") (Hạng @(c.TierName ?? "Member") · @VnFormat.Number(c.RewardPoints) điểm)
                            </option>
                        }
                    </select>
                    @if (detail != null)
                    {
                        <a asp-controller="CustomerManagement" asp-action="Profile" asp-route-id="@detail.Id"
                           class="btn-outline-bms text-nowrap" title="Xem hồ sơ hội viên">
                            <i class="bi bi-person-vcard"></i> Hồ sơ
                        </a>
                    }
                </div>
            </form>

            @if (detail != null)
            {
                <div class="p-3 rounded-3 mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2"
                     style="background:#f8fafc;border:1px solid #e2e8f0;font-size:0.84rem">
                    <div>
                        <strong>@detail.FullName</strong>
                        <span class="ms-2" style="@(VnFormat.TierBadgeStyle(detail.TierName));padding:2px 8px;border-radius:6px;font-weight:600">
                            Hạng @detail.TierName (-@detail.DiscountPercent.ToString("0.##")% giờ · ×@detail.PointMultiplier)
                        </span>
                    </div>
                    <div>
                        Điểm khả dụng: <strong class="text-danger">@VnFormat.Number(detail.RewardPoints) điểm</strong>
                        <span class="ms-2 text-muted">| Chi tiêu 12T: <strong>@VnFormat.Money(detail.Spend12Months)</strong></span>
                    </div>
                </div>

                <form asp-action="CommitCheckout" method="post" id="checkoutForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="customerId" id="inpCustomerId" value="@detail.Id" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Tiền giờ chơi (VNĐ) <span class="text-danger">*</span></label>
                            <input type="number" name="playtimeAmount" id="inpPlaytime" class="form-control calc-trigger"
                                   min="0" step="1000" value="@Model.PlaytimeAmount" required />
                            <div class="form-text">Chiết khấu theo hạng chỉ tính trên tiền giờ chơi.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tiền đồ ăn &amp; nước uống (VNĐ)</label>
                            <input type="number" name="fandBAmount" id="inpFnb" class="form-control calc-trigger"
                                   min="0" step="1000" value="@Model.FandBAmount" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Voucher ưu đãi</label>
                            <select name="voucherCode" id="inpVoucher" class="form-select calc-trigger">
                                <option value="">-- Không áp dụng voucher --</option>
                                @foreach (var v in Model.AvailableVouchers)
                                {
                                    <option value="@v.Code" selected="@(Model.VoucherCode == v.Code)">
                                        @v.Code — @v.Title (@(v.DiscountValue.HasValue ? "-" + VnFormat.Money(v.DiscountValue.Value) : VnFormat.RewardTypeLabel(v.VoucherType)))
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label d-flex justify-content-between">
                                <span>Đổi điểm trừ tiền (1 điểm = 1.000₫)</span>
                                <a href="javascript:void(0)" id="btnMaxPoints" class="text-danger fw-semibold text-decoration-none" style="font-size:0.78rem">
                                    Tối đa (<span id="lblMaxPts">@(p?.MaxRedeemablePoints ?? 0)</span> điểm)
                                </a>
                            </label>
                            <input type="number" name="pointsToRedeem" id="inpPoints" class="form-control calc-trigger"
                                   min="0" step="1" value="@Model.PointsToRedeem" />
                            <div class="form-text">Tối đa 50% số tiền còn lại sau chiết khấu hạng và voucher.</div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label d-flex justify-content-between">
                            <span>Mã hóa đơn</span>
                            <a href="javascript:void(0)" id="btnNewRef" class="text-primary text-decoration-none" style="font-size:0.78rem">
                                <i class="bi bi-arrow-clockwise"></i> Tạo mã mới
                            </a>
                        </label>
                        <input type="text" name="referenceCode" id="inpRefCode" class="form-control font-monospace"
                               value="@Model.ReferenceCode" required />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn-primary-bms px-4 py-2" id="btnCommitCheckout">
                            <i class="bi bi-check2-circle"></i> Xác nhận thanh toán
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>

    <!-- Phải: Phiếu tạm tính -->
    <div class="col-lg-5">
        <div class="data-card p-4">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                <div>
                    <div class="fw-bold">PHIẾU TẠM TÍNH HÓA ĐƠN</div>
                    <div class="text-muted" style="font-size:0.78rem">Mã HĐ: <code id="rcpRef">@Model.ReferenceCode</code></div>
                </div>
                <span class="badge bg-light text-secondary border">CLB Bida BMS</span>
            </div>

            <div id="rcpErrors" class="alert alert-danger py-2 mb-3 @(p != null && !p.IsValid ? "" : "d-none")" style="font-size:0.8rem">
                @if (p != null && !p.IsValid)
                {
                    foreach (var e in p.Errors) { <div>• @e</div> }
                }
            </div>

            <div class="d-flex justify-content-between py-1" style="font-size:0.88rem">
                <span>Tiền giờ chơi:</span>
                <strong id="rcpPlay">@VnFormat.Money(Model.PlaytimeAmount)</strong>
            </div>
            <div class="d-flex justify-content-between py-1 border-bottom pb-2" style="font-size:0.88rem">
                <span>Đồ ăn &amp; nước uống:</span>
                <strong id="rcpFnb">@VnFormat.Money(Model.FandBAmount)</strong>
            </div>

            <div class="d-flex justify-content-between py-1 mt-2 text-success" style="font-size:0.86rem">
                <span>Ưu đãi hạng (<span id="rcpTierName">@(p?.TierName ?? "Member")</span> -<span id="rcpTierPct">@(p?.TierDiscountPercent.ToString("0.##") ?? "0")</span>% giờ):</span>
                <span id="rcpTierDisc">-@VnFormat.Money(p?.TierDiscountAmount ?? 0)</span>
            </div>
            <div class="d-flex justify-content-between py-1 text-success" style="font-size:0.86rem">
                <span>Giảm voucher:</span>
                <span id="rcpVoucherDisc">-@VnFormat.Money(p?.VoucherDiscountAmount ?? 0)</span>
            </div>
            <div class="d-flex justify-content-between py-1 border-bottom pb-2 text-success" style="font-size:0.86rem">
                <span>Đổi điểm thưởng:</span>
                <span id="rcpPointsDisc">-@VnFormat.Money(p?.PointsDiscountAmount ?? 0)</span>
            </div>

            <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                <span class="fw-bold">TỔNG THANH TOÁN:</span>
                <span class="fw-bold fs-4 text-danger" id="rcpFinal">@VnFormat.Money(p?.FinalAmount ?? (Model.PlaytimeAmount + Model.FandBAmount))</span>
            </div>

            <div class="mt-3 p-3 rounded-3" style="background:#f8fafc;border:1px solid #e2e8f0;font-size:0.84rem">
                <div class="d-flex justify-content-between mb-1">
                    <span>Điểm cộng sau thanh toán:</span>
                    <strong class="text-primary" id="rcpEarn">+@(p?.PointsToEarn ?? 0) điểm</strong>
                </div>
                <div id="rcpTierStatus" class="mt-2 pt-2 border-top text-muted" style="font-size:0.8rem">
                    @if (p != null)
                    {
                        if (p.WillUpgradeTier)
                        {
                            <span class="text-success fw-semibold"><i class="bi bi-award me-1"></i>Đủ điều kiện lên hạng @p.NextTierName sau hóa đơn này.</span>
                        }
                        else if (p.NextTierName != null && p.AmountNeededForNextTier > 0)
                        {
                            <span>Cần thêm <strong>@VnFormat.Money(p.AmountNeededForNextTier)</strong> chi tiêu 12 tháng để lên hạng <strong>@p.NextTierName</strong>.</span>
                        }
                        else
                        {
                            <span>Khách hàng đang ở hạng cao nhất.</span>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        const custInput = document.getElementById('inpCustomerId');
        if (!custInput) return;

        const playInput = document.getElementById('inpPlaytime');
        const fnbInput = document.getElementById('inpFnb');
        const voucherInput = document.getElementById('inpVoucher');
        const pointsInput = document.getElementById('inpPoints');
        const refInput = document.getElementById('inpRefCode');
        const maxBtn = document.getElementById('btnMaxPoints');
        const lblMaxPts = document.getElementById('lblMaxPts');
        const newRefBtn = document.getElementById('btnNewRef');

        let maxAllowed = @(p?.MaxRedeemablePoints ?? 0);

        function fmtMoney(n) {
            return Math.round(n || 0).toLocaleString('vi-VN') + ' ₫';
        }

        function refreshPreview() {
            const url = `/CashierSimulator/Preview?customerId=${encodeURIComponent(custInput.value)}&playtimeAmount=${playInput.value || 0}&fandBAmount=${fnbInput.value || 0}&pointsToRedeem=${pointsInput.value || 0}&voucherCode=${encodeURIComponent(voucherInput.value || '')}&referenceCode=${encodeURIComponent(refInput.value || '')}`;
            fetch(url)
                .then(r => r.json())
                .then(d => {
                    maxAllowed = d.maxRedeemablePoints || 0;
                    lblMaxPts.textContent = maxAllowed;
                    document.getElementById('rcpRef').textContent = refInput.value;
                    document.getElementById('rcpPlay').textContent = fmtMoney(playInput.value);
                    document.getElementById('rcpFnb').textContent = fmtMoney(fnbInput.value);
                    document.getElementById('rcpTierName').textContent = d.tierName;
                    document.getElementById('rcpTierPct').textContent = d.tierDiscountPercent;
                    document.getElementById('rcpTierDisc').textContent = '-' + fmtMoney(d.tierDiscountAmount);
                    document.getElementById('rcpVoucherDisc').textContent = '-' + fmtMoney(d.voucherDiscountAmount);
                    document.getElementById('rcpPointsDisc').textContent = '-' + fmtMoney(d.pointsDiscountAmount);
                    document.getElementById('rcpFinal').textContent = fmtMoney(d.finalAmount);
                    document.getElementById('rcpEarn').textContent = '+' + d.pointsToEarn + ' điểm';

                    const errBox = document.getElementById('rcpErrors');
                    if (!d.isValid && d.errors && d.errors.length > 0) {
                        errBox.classList.remove('d-none');
                        errBox.innerHTML = d.errors.map(e => `<div>• ${e}</div>`).join('');
                    } else {
                        errBox.classList.add('d-none');
                        errBox.innerHTML = '';
                    }

                    const statusBox = document.getElementById('rcpTierStatus');
                    if (d.willUpgradeTier) {
                        statusBox.innerHTML = `<span class="text-success fw-bold"><i class="bi bi-trophy-fill me-1"></i>Sắp lên hạng ${d.nextTierName} ngay sau hóa đơn này!</span>`;
                    } else if (d.nextTierName && d.amountNeededForNextTier > 0) {
                        statusBox.innerHTML = `Còn thiếu <strong>${fmtMoney(d.amountNeededForNextTier)}</strong> chi tiêu 12 tháng để lên hạng <strong>${d.nextTierName}</strong>.`;
                    } else {
                        statusBox.innerHTML = 'Khách đang ở hạng cao nhất.';
                    }
                });
        }

        document.querySelectorAll('.calc-trigger').forEach(el => {
            el.addEventListener('input', refreshPreview);
            el.addEventListener('change', refreshPreview);
        });

        refInput.addEventListener('input', () => {
            document.getElementById('rcpRef').textContent = refInput.value;
        });

        maxBtn.addEventListener('click', () => {
            pointsInput.value = maxAllowed;
            refreshPreview();
        });

        newRefBtn.addEventListener('click', () => {
            const now = new Date();
            const pad = n => String(n).padStart(2, '0');
            const rand = Math.floor(1000 + Math.random() * 9000);
            refInput.value = `HD-${now.getFullYear()}${pad(now.getMonth() + 1)}${pad(now.getDate())}${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}-${rand}`;
            document.getElementById('rcpRef').textContent = refInput.value;
        });
    })();
</script>
}
