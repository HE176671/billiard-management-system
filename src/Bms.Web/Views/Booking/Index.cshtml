@model Bms.Web.Models.StaffBookingManagementViewModel
@{
    ViewData["Title"] = "Quản lý Đặt bàn & Check-in";
    Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_StaffLayout";
    var dateValue = Model.DateFilterLocal?.ToString("yyyy-MM-dd") ?? "";
}

<!-- ===================================================================== -->
<!-- PHẦN 1: CSS TÙY CHỈNH & THÔNG BÁO TEMPDATA                            -->
<!-- ===================================================================== -->

<style>
    .booking-toolbar {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.9rem 1.15rem;
        margin-bottom: 1rem;
    }
    .booking-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
    }
    .table-clean th {
        background: #f8fafc;
        font-size: 0.78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        color: #64748b;
        padding: 0.8rem 1.1rem;
        border-bottom: 1px solid #e2e8f0;
    }
    .table-clean td {
        padding: 0.9rem 1.1rem;
        vertical-align: middle;
        font-size: 0.9rem;
        border-bottom: 1px solid #f1f5f9;
    }
    .table-clean tbody tr:last-child td {
        border-bottom: none;
    }
    .dot-status {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        margin-right: 5px;
    }
    .dot-available { background-color: #10b981; }
    .dot-busy { background-color: #ef4444; }
    .badge-soft {
        font-weight: 600;
        font-size: 0.76rem;
        padding: 0.32rem 0.65rem;
        border-radius: 999px;
    }
    .badge-soft-green { background: #dcfce7; color: #15803d; }
    .badge-soft-amber { background: #fef3c7; color: #b45309; }
    .badge-soft-blue  { background: #dbeafe; color: #1d4ed8; }
    .badge-soft-red   { background: #fee2e2; color: #b91c1c; }
    .badge-soft-gray  { background: #f1f5f9; color: #475569; }
</style>

@if (TempData["StaffBookingSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3 py-2" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["StaffBookingSuccess"]
        <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["StaffBookingError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3 py-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["StaffBookingError"]
        <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0">Quản lý Đặt bàn & Check-in</h4>
    <a asp-controller="Table" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-grid-3x3 me-1"></i>Sơ đồ bàn
    </a>
</div>

<!-- ===================================================================== -->
<!-- PHẦN 2: THANH TÌM KIẾM & LỌC ĐẶT BÀN (GET /Booking)                   -->
<!-- ===================================================================== -->

<!-- Thanh tìm kiếm gọn 1 dòng -->
<div class="booking-toolbar">
    <form asp-controller="Booking" asp-action="Index" method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="keyword" value="@Model.Keyword" class="form-control border-start-0"
                       placeholder="Tìm SĐT, Tên khách, Mã bàn (B01)..." />
            </div>
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select form-select-sm">
                <option value="ALL" selected="@(string.IsNullOrEmpty(Model.StatusFilter) || Model.StatusFilter == "ALL")">Tất cả trạng thái</option>
                <option value="Confirmed" selected="@(Model.StatusFilter == "Confirmed")">Chờ khách đến (Confirmed)</option>
                <option value="CheckedIn" selected="@(Model.StatusFilter == "CheckedIn")">Đã Check-in</option>
                <option value="NoShow" selected="@(Model.StatusFilter == "NoShow")">Quá hạn 15p (NoShow)</option>
                <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Đã hoàn tất</option>
                <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Đã hủy</option>
            </select>
        </div>
        <div class="col-md-2">
            <input type="date" name="date" value="@dateValue" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-danger btn-sm w-100 fw-semibold">Tra cứu</button>
            @if (!string.IsNullOrWhiteSpace(Model.Keyword) || !string.IsNullOrWhiteSpace(Model.StatusFilter) || Model.DateFilterLocal.HasValue)
            {
                <a asp-controller="Booking" asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Đặt lại">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </div>
    </form>
</div>

<!-- ===================================================================== -->
<!-- PHẦN 3: BẢNG DANH SÁCH ĐẶT BÀN & CÁC NÚT THAO TÁC (CHECK-IN / HỦY)    -->
<!-- ===================================================================== -->

<!-- Bảng 5 cột tối giản -->
<div class="booking-card">
    <div class="table-responsive">
        <table class="table table-clean table-hover mb-0">
            <thead>
                <tr>
                    
                    <th>Khách hàng</th>
                    <th>Bàn đặt</th>
                    <th>Giờ hẹn</th>
                    <th class="text-end" style="width: 240px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Bookings != null && Model.Bookings.Count > 0)
                {
                    @foreach (var item in Model.Bookings)
                    {
                        var startVn = Bms.Web.Models.BookingPolicy.ToVietnamTime(item.StartAtUtc);
                        var holdVn = Bms.Web.Models.BookingPolicy.ToVietnamTime(item.HoldUntilUtc);
                        var isTableAvailable = item.TableCurrentStatus == "Available";

                        var (shortTag, tagClass) = item.ScenarioCode switch
                        {
                            "OnTime" => ("Đúng giờ", "badge-soft-green"),
                            "LateUnder15m" => ("Muộn ≤ 15p", "badge-soft-amber"),
                            "OnTimeNoTableYet" => ("Bàn đang bận", "badge-soft-amber"),
                            "EarlyArrival" when item.CanCheckInEarly => ("Đến sớm", "badge-soft-blue"),
                            "EarlyArrival" => ("Chưa tới giờ", "badge-soft-gray"),
                            "CheckedInReadyToAssign" => ("Đã Check-in • Chờ bàn", "badge-soft-amber"),
                            "CheckedInWaitingTable" => ("Chờ bàn trống", "badge-soft-amber"),
                            "AlreadyCheckedInPlaying" => ("Đang chơi", "badge-soft-green"),
                            "LateOver15m" => ("Quá hạn 15p", "badge-soft-red"),
                            "Cancelled" => ("Đã hủy", "badge-soft-gray"),
                            "Completed" => ("Hoàn tất", "badge-soft-gray"),
                            _ => (item.DisplayStatus, "badge-soft-gray")
                        };

                        <tr>
                            
                            <td>
                                <span class="fw-semibold text-dark">@item.CustomerName</span>
                                @if (!string.IsNullOrWhiteSpace(item.CustomerPhone))
                                {
                                    <span class="text-muted ms-1">- @item.CustomerPhone</span>
                                }
                            </td>
                            <td>
                                <span class="dot-status @(isTableAvailable ? "dot-available" : "dot-busy")"
                                      title="Bàn @item.TableCode hiện đang: @item.TableDisplayStatus"></span>
                                <span class="fw-semibold">@item.TableCode</span>
                                <span class="text-muted small">(@item.TableTypeName)</span>
                            </td>
                            <td>
                                <span class="fw-bold text-dark">@startVn.ToString("HH:mm")</span>
                                <span class="text-muted small me-2">(Giữ @holdVn.ToString("HH:mm"))</span>
                                <span class="badge-soft @tagClass" title="@item.BusinessGuidance">
                                    @shortTag
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex align-items-center gap-1">
                                    @if (item.CanCheckInNormal)
                                    {
                                        <form asp-controller="Booking" asp-action="CheckIn" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookingId" value="@item.BookingId" />
                                            <input type="hidden" name="allowEarly" value="false" />
                                            <input type="hidden" name="keyword" value="@Model.Keyword" />
                                            <input type="hidden" name="status" value="@Model.StatusFilter" />
                                            <input type="hidden" name="date" value="@dateValue" />
                                            <button type="submit" class="btn btn-success btn-sm fw-semibold px-3">
                                                ✓ Check-in
                                            </button>
                                        </form>
                                    }
                                    else if (item.CanCheckInEarly)
                                    {
                                        <form asp-controller="Booking" asp-action="CheckIn" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookingId" value="@item.BookingId" />
                                            <input type="hidden" name="allowEarly" value="true" />
                                            <input type="hidden" name="keyword" value="@Model.Keyword" />
                                            <input type="hidden" name="status" value="@Model.StatusFilter" />
                                            <input type="hidden" name="date" value="@dateValue" />
                                            <button type="submit" class="btn btn-primary btn-sm fw-semibold px-3">
                                                ⚡ Check-in sớm
                                            </button>
                                        </form>
                                    }
                                    else if (item.CanAssignTableAndOpen)
                                    {
                                        <button type="button"
                                                class="btn btn-danger btn-sm fw-semibold px-3"
                                                data-bs-toggle="modal"
                                                data-bs-target="#assignTableModal"
                                                data-booking-id="@item.BookingId"
                                                data-customer-name="@item.CustomerName"
                                                data-booked-table-id="@item.TableId"
                                                data-booked-table-code="@item.TableCode"
                                                data-booked-table-status="@item.TableDisplayStatus">
                                            🎱 Chọn bàn
                                        </button>
                                    }
                                    else if (item.LinkedSessionId.HasValue)
                                    {
                                        <a asp-controller="Table" asp-action="Index" class="btn btn-outline-success btn-sm">
                                            Đang chơi (#@item.LinkedSessionId)
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }

                                    @if (item.CanCancel)
                                    {
                                        <form asp-controller="Booking" asp-action="Cancel" method="post" class="d-inline"
                                              onsubmit="return confirm('Hủy đặt bàn #BK-@item.BookingId?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookingId" value="@item.BookingId" />
                                            <input type="hidden" name="keyword" value="@Model.Keyword" />
                                            <input type="hidden" name="status" value="@Model.StatusFilter" />
                                            <input type="hidden" name="date" value="@dateValue" />
                                            <button type="submit" class="btn btn-outline-secondary btn-sm">Hủy</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <div class="text-muted mb-2">Không tìm thấy lịch đặt bàn phù hợp.</div>
                            <a asp-controller="Table" asp-action="Index" class="btn btn-danger btn-sm fw-semibold">
                                🎱 Mở bàn trực tiếp cho khách vãng lai
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ===================================================================== -->
<!-- PHẦN 4: MODAL CHỌN BÀN MỞ PHIÊN & JAVASCRIPT ĐIỀU KHIỂN MODAL         -->
<!-- ===================================================================== -->

<!-- Modal Popup: Chọn bàn & Mở phiên chơi -->
<div class="modal fade" id="assignTableModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-controller="Booking" asp-action="AssignTable" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookingId" id="modalBookingId" />
                <input type="hidden" name="keyword" value="@Model.Keyword" />
                <input type="hidden" name="status" value="@Model.StatusFilter" />
                <input type="hidden" name="date" value="@dateValue" />

                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold" id="modalTitleText">Chọn bàn mở phiên</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body pt-2">
                    <p class="text-muted small mb-3" id="modalSubtitleText"></p>

                    @if (Model.AvailableTables.Any())
                    {
                        <label class="form-label small fw-semibold text-secondary">Chọn bàn trống cho khách:</label>
                        <select name="selectedTableId" id="modalTableSelect" class="form-select">
                            @foreach (var tbl in Model.AvailableTables)
                            {
                                <option value="@tbl.TableId" data-code="@tbl.TableCode">
                                    Bàn @tbl.TableCode — @tbl.TableTypeName (Tầng @tbl.FloorNumber • @tbl.HourlyRate.ToString("N0")đ/h)
                                </option>
                            }
                        </select>
                    }
                    else
                    {
                        <div class="alert alert-warning small mb-0">
                            Hiện chưa có bàn nào đang trống. Vui lòng kết thúc hoặc chuyển bàn trên Sơ đồ bàn trước.
                        </div>
                    }
                </div>

                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light btn-sm px-3" data-bs-dismiss="modal">Đóng</button>
                    @if (Model.AvailableTables.Any())
                    {
                        <button type="submit" class="btn btn-danger btn-sm fw-semibold px-4">
                            🎱 Xác nhận Mở bàn
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var assignModal = document.getElementById('assignTableModal');
            if (!assignModal) return;

            assignModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var bookingId = button.getAttribute('data-booking-id');
                var customerName = button.getAttribute('data-customer-name');
                var bookedTableId = button.getAttribute('data-booked-table-id');
                var bookedTableCode = button.getAttribute('data-booked-table-code');
                var bookedTableStatus = button.getAttribute('data-booked-table-status');

                document.getElementById('modalBookingId').value = bookingId;
                document.getElementById('modalTitleText').textContent = 'Chọn bàn cho đơn #BK-' + bookingId;
                document.getElementById('modalSubtitleText').textContent =
                    'Khách hàng: ' + customerName + ' • Bàn đặt trước: ' + bookedTableCode + ' (' + bookedTableStatus + ')';

                var selectEl = document.getElementById('modalTableSelect');
                if (selectEl) {
                    var foundBookedTable = false;
                    for (var i = 0; i < selectEl.options.length; i++) {
                        if (selectEl.options[i].value === bookedTableId) {
                            selectEl.selectedIndex = i;
                            foundBookedTable = true;
                            break;
                        }
                    }
                    if (!foundBookedTable && selectEl.options.length > 0) {
                        selectEl.selectedIndex = 0;
                    }
                }
            });
        });
    </script>
}
