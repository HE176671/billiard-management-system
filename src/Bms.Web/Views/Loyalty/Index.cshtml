@model Bms.Web.Models.LoyaltyViewModel
@{
    ViewData["Title"] = "Điểm thưởng & Hạng thành viên";
    Layout = "_AdminLayout";
}

<!-- Stat cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
        <div class="stat-card">
            <div class="stat-icon amber"><i class="bi bi-trophy-fill"></i></div>
            <div>
                <div class="stat-value">@Model.TotalPoints</div>
                <div class="stat-label">Tổng điểm tích lũy</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="stat-card">
            <div class="stat-icon red"><i class="bi bi-award-fill"></i></div>
            <div>
                <div class="stat-value" style="font-size:1.1rem">@Model.RankName</div>
                <div class="stat-label">Hạng thành viên</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="stat-card">
            <div class="stat-icon @(Model.PointsToNextRank.HasValue ? "blue" : "green")">
                <i class="bi bi-@(Model.PointsToNextRank.HasValue ? "arrow-up-circle-fill" : "star-fill")"></i>
            </div>
            <div>
                @if (Model.PointsToNextRank.HasValue)
                {
                    <div class="stat-value">@Model.PointsToNextRank</div>
                    <div class="stat-label">Điểm để lên hạng tiếp</div>
                }
                else
                {
                    <div class="stat-value" style="font-size:0.9rem">Cao nhất</div>
                    <div class="stat-label">Bạn đang ở hạng cao nhất</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Progress bar ngưỡng hạng -->
@{
    var (minPts, maxPts) = Model.RankName switch
    {
        "Đồng"      => (0, 100),
        "Bạc"       => (100, 200),
        "Vàng"      => (200, 300),
        _           => (300, 300)
    };
    var progress = maxPts > minPts
        ? (int)Math.Min(100, (Model.TotalPoints - minPts) * 100.0 / (maxPts - minPts))
        : 100;
}
<div class="data-card mb-4 p-3">
    <div class="d-flex justify-content-between mb-1" style="font-size:0.8rem;color:#64748b">
        <span>@Model.RankName (@minPts đ)</span>
        @if (Model.PointsToNextRank.HasValue)
        {
            var nextRank = Model.RankName switch { "Đồng" => "Bạc", "Bạc" => "Vàng", _ => "Kim cương" };
            <span>@nextRank (@maxPts đ)</span>
        }
        else { <span>Kim cương ✦</span> }
    </div>
    <div class="progress" style="height:10px;border-radius:99px;background:#f1f5f9">
        <div class="progress-bar" role="progressbar"
             style="width:@progress%;background:#e94560;border-radius:99px;transition:width .6s ease">
        </div>
    </div>
    <div class="text-center mt-1" style="font-size:0.75rem;color:#94a3b8">
        @Model.TotalPoints điểm
    </div>
</div>

<!-- Lịch sử điểm -->
<div class="data-card">
    <div class="data-card-header">
        <span class="data-card-title"><i class="bi bi-list-check me-2"></i>Lịch sử tích điểm</span>
        @if (Model.TotalCount > 0)
        {
            <span style="font-size:0.8rem;color:#64748b">@Model.TotalCount phiên đã hoàn thành</span>
        }
    </div>

    @if (!Model.History.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
            Chưa có lịch sử điểm.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>#Phiên</th>
                        <th>Bàn</th>
                        <th>Bắt đầu</th>
                        <th>Kết thúc</th>
                        <th class="text-end">Tiền giờ (₫)</th>
                        <th class="text-end">Điểm nhận</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.History)
                    {
                        <tr>
                            <td><code style="font-size:0.8rem">#@row.SessionId</code></td>
                            <td><strong>@row.TableCode</strong></td>
                            <td>@row.StartAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@row.EndAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">@row.PlaytimeAmount.ToString("#,##0")</td>
                            <td class="text-end">
                                <span style="color:#f59e0b;font-weight:700">+@row.Points</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Phân trang -->
        @if (Model.TotalPages > 1)
        {
            <div class="d-flex justify-content-center align-items-center gap-2 py-3">
                @if (Model.Page > 1)
                {
                    <a asp-action="Index" asp-route-page="@(Model.Page - 1)" class="btn-sm-icon">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                }
                @for (int i = Math.Max(1, Model.Page - 2); i <= Math.Min(Model.TotalPages, Model.Page + 2); i++)
                {
                    <a asp-action="Index" asp-route-page="@i"
                       class="btn-sm-icon @(i == Model.Page ? "active" : "")"
                       style="@(i == Model.Page ? "background:#e94560;color:#fff;border-color:#e94560" : "")">@i</a>
                }
                @if (Model.Page < Model.TotalPages)
                {
                    <a asp-action="Index" asp-route-page="@(Model.Page + 1)" class="btn-sm-icon">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                }
            </div>
        }
    }
</div>
