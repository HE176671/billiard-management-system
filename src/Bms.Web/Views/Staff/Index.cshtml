@model Bms.Web.Models.StaffHomeViewModel
@{
    Layout = "_AdminLayout";
    var s = Model.ActiveShift;
}
<partial name="_Alerts" />
<h5 class="mb-3">Xin chào, @Model.FullName</h5>

<div class="form-card mb-4">
    @if (s == null)
    {
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <div class="stat-icon amber"><i class="bi bi-exclamation-circle"></i></div>
            <div>
                <div style="font-weight:600">Bạn chưa mở ca</div>
                <div class="text-muted" style="font-size:0.85rem">Mở ca và nhập tiền đầu ca trước khi thu tiền mặt của khách.</div>
            </div>
            <a asp-controller="Shift" asp-action="Index" class="btn-primary-bms ms-auto"><i class="bi bi-play-fill"></i> Mở ca</a>
        </div>
    }
    else
    {
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <div class="stat-icon green"><i class="bi bi-cash-coin"></i></div>
            <div>
                <div style="font-weight:600">Ca #@s.Shift.Id đang mở từ @s.Shift.StartTimeUtc.ToVn().ToString("HH:mm dd/MM")</div>
                <div class="text-muted" style="font-size:0.85rem">
                    Đầu ca @s.Shift.StartingCash.ToString("N0") ₫ · tiền mặt đã thu @s.CashCollected.ToString("N0") ₫ ·
                    kỳ vọng trong két <strong>@s.ExpectedCash.ToString("N0") ₫</strong>
                </div>
            </div>
            <a asp-controller="Shift" asp-action="Index" class="btn-outline-bms ms-auto"><i class="bi bi-stop-circle"></i> Xem / đóng ca</a>
        </div>
    }
</div>

<div class="row g-3">
    <div class="col-sm-6 col-xl-3"><div class="stat-card"><div class="stat-icon green"><i class="bi bi-check2-circle"></i></div>
        <div><div class="stat-value">@Model.Count("Available")</div><div class="stat-label">Bàn trống</div></div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="stat-card"><div class="stat-icon blue"><i class="bi bi-play-circle"></i></div>
        <div><div class="stat-value">@Model.Count("InUse")</div><div class="stat-label">Đang chơi</div></div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="stat-card"><div class="stat-icon amber"><i class="bi bi-hourglass-split"></i></div>
        <div><div class="stat-value">@Model.Count("AwaitingPayment")</div><div class="stat-label">Chờ thanh toán</div></div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="stat-card"><div class="stat-icon red"><i class="bi bi-tools"></i></div>
        <div><div class="stat-value">@(Model.Count("Maintenance") + Model.Count("Inactive"))</div><div class="stat-label">Bảo trì / ngừng dùng</div></div></div></div>
</div>
<p class="mt-3 text-muted" style="font-size:0.8rem">Màn hình đặt bàn, mở phiên, gọi món và thanh toán do TV1, TV4, TV3 bổ sung vào menu Nghiệp vụ.</p>
