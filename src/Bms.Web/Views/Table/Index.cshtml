@model Bms.Web.Models.TableManagementViewModel
@{
    Layout = "_StaffLayout";
    ViewData["Title"] = "Quản lý bàn";
}

<!-- Token Anti-forgery riêng cho các thao tác AJAX của trang Quản lý bàn -->
<div id="antiforgery-holder" style="display:none;">
    @Html.AntiForgeryToken()
</div>

<!-- Toast thông báo Bootstrap 5 (chứa tối đa 3 toast cùng lúc) -->
<div class="toast-container position-fixed top-0 end-0 p-3" id="bms-toast-container" style="z-index: 1090;">
</div>

<div class="table-management-wrapper">
    <!-- Cột trái: Sơ đồ bàn (mặc định chiếm toàn bộ chiều rộng khi panel ẩn) -->
    <section class="table-grid-section">
        <div class="section-box-header">
            <h2 class="section-box-title">Sơ đồ bàn</h2>
        </div>
        <div id="table-grid-container" class="table-grid-container">
            <partial name="_TableGridPartial" model="Model.Tables" />
        </div>
    </section>

    <!-- Cột phải: Chi tiết phiên chơi (mặc định ẨN bằng d-none, không dùng modal) -->
    <aside class="table-detail-aside d-none" id="table-detail-panel" aria-label="Chi tiết phiên chơi">
        <div class="detail-panel-container">
            <div class="section-box-header detail-header-box">
                <h2 class="section-box-title">Chi tiết phiên chơi</h2>
                <button type="button" class="btn-close-detail" id="btn-close-detail" aria-label="Đóng" title="Đóng panel (Esc)">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- Khung 1: Thông tin bàn & Trạng thái -->
            <div class="panel-card-box">
                <div class="detail-data-row">
                    <span class="detail-key">Table Name:</span>
                    <span class="detail-val" id="detail-table-name">--</span>
                </div>
                <div class="detail-data-row">
                    <span class="detail-key">Status:</span>
                    <span class="detail-val" id="detail-status">--</span>
                </div>
            </div>

            <!-- Khung 2: Khách hàng & Thông tin đặt bàn -->
            <div class="panel-card-box">
                <div class="detail-data-row">
                    <span class="detail-key">Customer:</span>
                    <span class="detail-val" id="detail-customer">--</span>
                </div>
                <div class="detail-data-row">
                    <span class="detail-key">Booking Time:</span>
                    <span class="detail-val" id="detail-booking-time">--</span>
                </div>
                <div class="action-single-btn-wrapper">
                    <span class="tooltip-wrapper d-block" title="Chưa hỗ trợ" data-bs-toggle="tooltip">
                        <button type="button" class="btn btn-outline-secondary w-100 btn-wireframe" id="btn-confirm-booking" disabled>
                            CONFIRM BOOKING
                        </button>
                    </span>
                </div>
            </div>

            <!-- Khung 3: Thời gian chơi -->
            <div class="panel-card-box">
                <div class="detail-data-row">
                    <span class="detail-key">Hình thức:</span>
                    <span class="detail-val" id="detail-session-mode">--</span>
                </div>
                <div class="detail-data-row">
                    <span class="detail-key">Start Time:</span>
                    <span class="detail-val" id="detail-start-time">--</span>
                </div>
                <div class="detail-data-row">
                    <span class="detail-key">End Time:</span>
                    <span class="detail-val" id="detail-end-time">--</span>
                </div>
                <div class="detail-data-row">
                    <span class="detail-key">Tính giờ từ:</span>
                    <span class="detail-val" id="detail-billing-start">--</span>
                </div>
                <div class="detail-data-row">
                    <span class="detail-key">Dự kiến kết thúc:</span>
                    <span class="detail-val" id="detail-planned-end">--</span>
                </div>
                <div class="detail-data-row">
                    <span class="detail-key">Duration:</span>
                    <span class="detail-val duration-val" id="detail-duration">--</span>
                </div>
                <div class="detail-data-row" id="detail-remaining-row">
                    <span class="detail-key">Còn lại:</span>
                    <span class="detail-val duration-val" id="detail-remaining">--</span>
                </div>
                <div class="detail-data-row" id="detail-playtime-row">
                    <span class="detail-key" id="detail-playtime-label">Tạm tính:</span>
                    <span class="detail-val" id="detail-playtime-amount">--</span>
                </div>
            </div>

            <!-- Khung 3b: Lịch sử bàn (mặc định d-none, hiện khi có từ 2 đoạn trở lên) -->
            <div class="panel-card-box d-none" id="detail-segments-box">
                <div class="form-section-title mb-2 fw-bold d-flex justify-content-between align-items-baseline">
                    <span>Lịch sử bàn</span>
                    <span class="small text-muted fw-normal" style="font-size: 0.75rem;">Giờ thực tế. Tiền tính theo mốc 15 phút.</span>
                </div>
                <div class="detail-segments-list" id="detail-segments-list">
                </div>
            </div>

            <!-- Khung 4: Form Mở bàn (mặc định d-none, hiện khi bấm OPEN TABLE) -->
            <div class="panel-card-box open-session-form d-none" id="open-session-form">
                <div class="form-section-title mb-2 fw-bold">Mở bàn mới</div>
                <div class="mb-3">
                    <label class="form-label d-block text-muted small fw-bold mb-1">Hình thức:</label>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="sessionModeRadio" id="radio-mode-open" value="Open" checked>
                        <label class="form-check-label" for="radio-mode-open">Không giới hạn</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="sessionModeRadio" id="radio-mode-timed" value="Timed">
                        <label class="form-check-label" for="radio-mode-timed">Đăng ký thời gian</label>
                    </div>
                </div>

                <div id="timed-options-container" class="mb-3 d-none">
                    <label class="form-label d-block text-muted small fw-bold mb-1">Thời gian đăng ký:</label>
                    <div class="preset-buttons-group mb-2 d-flex gap-1 flex-wrap" id="preset-buttons-group">
                        <button type="button" class="btn btn-sm btn-outline-secondary btn-preset-minutes" data-minutes="30">30 phút</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary btn-preset-minutes" data-minutes="60">60 phút</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary btn-preset-minutes" data-minutes="90">90 phút</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary btn-preset-minutes" data-minutes="120">120 phút</button>
                    </div>
                    <div class="input-group input-group-sm">
                        <input type="number" class="form-control" id="input-planned-minutes" min="15" max="720" step="15" placeholder="Nhập số phút (15 - 720)">
                        <span class="input-group-text">phút</span>
                    </div>
                    <div id="open-form-error" class="form-text text-danger mt-1 small d-none"></div>
                </div>

                <div class="time-preview-box p-2 mb-3 rounded bg-light border">
                    <div class="small text-muted" id="preview-billing-start-row">
                        Tính giờ từ <strong id="preview-billing-start">--:--</strong> (dự kiến)
                    </div>
                    <div class="small text-muted d-none" id="preview-planned-end-row">
                        Dự kiến kết thúc <strong id="preview-planned-end">--:--</strong>
                    </div>
                </div>

                <div class="action-btn-row">
                    <button type="button" class="btn btn-primary-bms btn-action-main" id="btn-confirm-open">
                        Xác nhận mở bàn
                    </button>
                    <button type="button" class="btn btn-wireframe btn-action-main" id="btn-cancel-open">
                        Hủy
                    </button>
                </div>
            </div>

            <!-- Khung 4b: Form Gia hạn phiên (mặc định d-none, hiện khi bấm GIA HẠN) -->
            <div class="panel-card-box extend-session-form d-none" id="extend-session-form">
                <div class="form-section-title mb-2 fw-bold">Gia hạn phiên chơi</div>
                <div class="mb-3">
                    <label class="form-label d-block text-muted small fw-bold mb-1">Thời gian gia hạn thêm:</label>
                    <div class="preset-buttons-group mb-2 d-flex gap-1 flex-wrap" id="preset-extend-buttons-group">
                        <button type="button" class="btn btn-sm btn-outline-secondary btn-preset-extend-minutes" data-minutes="15">15 phút</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary btn-preset-extend-minutes active" data-minutes="30">30 phút</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary btn-preset-extend-minutes" data-minutes="60">60 phút</button>
                    </div>
                    <div class="input-group input-group-sm">
                        <input type="number" class="form-control" id="input-extend-minutes" min="15" max="240" step="15" value="30" placeholder="Nhập số phút (15 - 240)">
                        <span class="input-group-text">phút</span>
                    </div>
                    <div id="extend-form-error" class="form-text text-danger mt-1 small d-none"></div>
                </div>

                <div class="time-preview-box p-2 mb-3 rounded bg-light border">
                    <div class="small text-muted" id="preview-extend-planned-end-row">
                        Dự kiến kết thúc mới: <strong id="preview-extend-planned-end">--:--</strong>
                    </div>
                    <div class="small text-muted mt-1" id="preview-extend-remaining-row">
                        Còn lại sau gia hạn: <strong id="preview-extend-remaining">--</strong>
                    </div>
                </div>

                <div class="action-btn-row">
                    <button type="button" class="btn btn-warning-bms btn-action-main" id="btn-confirm-extend">
                        Xác nhận gia hạn
                    </button>
                    <button type="button" class="btn btn-wireframe btn-action-main" id="btn-cancel-extend">
                        Hủy
                    </button>
                </div>
            </div>

            <!-- Khung 4c: Form Đóng bàn (mặc định d-none, hiện khi bấm CLOSE TABLE) -->
            <div class="panel-card-box close-session-form d-none" id="close-session-form">
                <div class="form-section-title mb-2 fw-bold">Xác nhận đóng bàn</div>

                <div id="close-summary-loading" class="text-muted small py-2 d-none">
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    Đang tải tóm tắt...
                </div>

                <div id="close-summary-error" class="alert alert-danger p-2 small mb-2 d-none">
                    <div id="close-summary-error-msg" class="mb-1">Không thể tải tóm tắt đóng bàn.</div>
                    <button type="button" class="btn btn-sm btn-outline-danger" id="btn-retry-close-summary">Thử lại</button>
                </div>

                <div id="close-summary-content" class="close-summary-body d-none">
                    <div class="summary-data-row">
                        <span class="summary-key">Bàn:</span>
                        <span class="summary-val fw-bold" id="close-summary-table">--</span>
                    </div>
                    <div class="summary-data-row">
                        <span class="summary-key">Hình thức:</span>
                        <span class="summary-val" id="close-summary-mode">--</span>
                    </div>
                    <div class="summary-data-row">
                        <span class="summary-key">Giờ mở:</span>
                        <span class="summary-val" id="close-summary-start">--</span>
                    </div>
                    <div class="summary-data-row">
                        <span class="summary-key">Tính giờ từ:</span>
                        <span class="summary-val" id="close-summary-billing-start">--</span>
                    </div>
                    <div class="summary-data-row">
                        <span class="summary-key">Tính đến (dự kiến):</span>
                        <span class="summary-val" id="close-summary-billing-end">--</span>
                    </div>
                    <div class="summary-data-row">
                        <span class="summary-key">Thời gian tính tiền:</span>
                        <span class="summary-val" id="close-summary-blocks">--</span>
                    </div>
                    <div class="summary-data-row summary-amount-row py-1">
                        <span class="summary-key fw-bold">Tiền tạm tính:</span>
                        <span class="summary-val fw-bold text-success fs-6" id="close-summary-amount">--</span>
                    </div>
                    <div class="small text-muted text-end mb-1" id="close-summary-timestamp">
                        Tạm tính lúc --:--:--
                    </div>
                    <div class="small text-warning-emphasis mb-2 d-none" id="close-summary-minimum-note">
                        <i class="bi bi-info-circle me-1"></i>Áp dụng mức tối thiểu 1 block (15 phút)
                    </div>
                    <div class="small text-info-emphasis mb-2 d-none" id="close-summary-transfer-note">
                        <i class="bi bi-arrow-left-right me-1"></i><span id="close-summary-transfer-text">--</span>
                    </div>
                    <div class="small text-muted fst-italic mb-3" style="font-size: 0.75rem;">
                        * Số tiền cuối cùng do hệ thống chốt khi xác nhận, có thể khác nếu qua mốc 15 phút.
                    </div>
                </div>

                <div class="action-btn-row">
                    <button type="button" class="btn btn-danger-bms btn-action-main" id="btn-confirm-close" disabled>
                        Xác nhận đóng bàn
                    </button>
                    <button type="button" class="btn btn-wireframe btn-action-main" id="btn-cancel-close">
                        Hủy
                    </button>
                </div>
            </div>

            <!-- Khung 4d: Form Chuyển bàn (mặc định d-none, hiện khi bấm CHUYỂN BÀN) -->
            <div class="panel-card-box transfer-session-form d-none" id="transfer-session-form">
                <div class="form-section-title mb-2 fw-bold">Chuyển bàn</div>

                <div class="mb-3">
                    <label class="form-label d-block text-muted small fw-bold mb-1" for="select-target-table">Chọn bàn đích:</label>
                    <select class="form-select form-select-sm" id="select-target-table">
                        <option value="">Chọn bàn đích...</option>
                    </select>
                    <div id="transfer-no-tables-msg" class="text-danger small mt-1 d-none">Hiện không có bàn trống để chuyển.</div>
                    <div id="transfer-form-error" class="form-text text-danger mt-1 small d-none"></div>
                </div>

                <div class="time-preview-box p-2 mb-3 rounded bg-light border" id="transfer-preview-box">
                    <div class="small text-muted" id="preview-transfer-rate-current-row">
                        Đơn giá hiện tại: <strong id="preview-transfer-rate-current">--</strong>
                    </div>
                    <div class="small text-muted" id="preview-transfer-rate-target-row">
                        Đơn giá bàn đích: <strong id="preview-transfer-rate-target">--</strong>
                    </div>
                    <div class="small text-warning-emphasis fw-bold mt-1 d-none" id="preview-transfer-rate-diff-note">
                        <i class="bi bi-exclamation-triangle me-1"></i><span id="preview-transfer-rate-diff-text">--</span>
                    </div>
                    <div class="small text-muted mt-1" id="preview-transfer-time-row">
                        Bàn mới tính giá từ <strong id="preview-transfer-billing-start">--:--</strong> (dự kiến, mốc 15 phút kế tiếp)
                    </div>
                    <div class="small text-info-emphasis mt-1 d-none" id="preview-transfer-pending-note">
                        <i class="bi bi-info-circle me-1"></i>Phiên chưa đến giờ tính tiền: toàn bộ thời gian tính theo đơn giá bàn mới.
                    </div>
                </div>

                <div class="action-btn-row">
                    <button type="button" class="btn btn-primary-bms btn-action-main" id="btn-confirm-transfer" disabled>
                        Xác nhận chuyển bàn
                    </button>
                    <button type="button" class="btn btn-wireframe btn-action-main" id="btn-cancel-transfer">
                        Hủy
                    </button>
                </div>
            </div>

            <!-- Khung 5: Các nút hành động theo wireframe -->
            <div class="panel-card-box action-buttons-container" id="action-buttons-box">
                <div class="action-btn-row">
                    <button type="button" class="btn btn-primary-bms btn-action-main" id="btn-open-table" disabled>
                        OPEN TABLE
                    </button>
                    <button type="button" class="btn btn-warning-bms btn-action-main" id="btn-extend-table" disabled>
                        GIA HẠN
                    </button>
                    <button type="button" class="btn btn-danger-bms btn-action-main" id="btn-close-table" disabled>
                        CLOSE TABLE
                    </button>
                </div>
                <div class="action-btn-row">
                    <span class="tooltip-wrapper flex-fill" id="wrapper-btn-transfer" title="Chưa hỗ trợ" data-bs-toggle="tooltip">
                        <button type="button" class="btn btn-outline-secondary w-100 btn-wireframe" id="btn-transfer" disabled>
                            CHUYỂN BÀN
                        </button>
                    </span>
                    <span class="tooltip-wrapper flex-fill" title="Chưa hỗ trợ" data-bs-toggle="tooltip">
                        <button type="button" class="btn btn-outline-secondary w-100 btn-wireframe" id="btn-split-merge" disabled>
                            SPLIT/MERGE
                        </button>
                    </span>
                </div>
            </div>
        </div>
    </aside>
</div>

@section Scripts {
    <script src="~/js/table-management.js" asp-append-version="true"></script>
}
