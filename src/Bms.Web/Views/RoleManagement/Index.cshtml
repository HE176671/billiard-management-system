@model Bms.Web.Models.RoleManagementViewModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Quản trị tài khoản & Phân quyền hệ thống";
    Layout = "_AdminLayout";
    var curUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- KPI Tổng quan phân quyền -->
<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon red"><i class="bi bi-shield-lock"></i></div>
            <div>
                <div class="stat-label">Quản trị hệ thống (Admin)</div>
                <div class="stat-value">@Model.AdminCount tài khoản</div>
                <small class="text-muted">Chịu trách nhiệm phân quyền & bảo mật</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon blue"><i class="bi bi-person-badge"></i></div>
            <div>
                <div class="stat-label">Quản lý CLB & Hội viên (Manager)</div>
                <div class="stat-value">@Model.ManagerCount tài khoản</div>
                <small class="text-muted">Vận hành, Doanh thu, Ca, Bảng giá & CRM</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon green"><i class="bi bi-people"></i></div>
            <div>
                <div class="stat-label">Nhân viên tại quầy (Staff)</div>
                <div class="stat-value">@Model.StaffCount tài khoản</div>
                <small class="text-muted">Mở/đóng ca, Tra cứu quầy & Lập phiếu điểm</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Cột trái: Tạo tài khoản nội bộ & Cấp quyền -->
    <div class="col-lg-4">
        <div class="data-card p-4">
            <h2 class="h6 fw-bold mb-2">
                <i class="bi bi-person-plus-fill me-2 text-danger"></i>Tạo tài khoản & Cấp quyền mới
            </h2>
            <p class="text-muted mb-3" style="font-size:0.8rem">
                Tạo tài khoản nội bộ và gán trực tiếp vào nhóm quyền <strong>Admin</strong>, <strong>Manager</strong> hoặc <strong>Staff</strong>.
            </p>

            <form asp-action="CreateAccount" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-2">
                    <label class="form-label">Họ và tên <span class="text-danger">*</span></label>
                    <input type="text" name="FullName" class="form-control" placeholder="VD: Nguyễn Văn Quản Lý" required maxlength="100" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Tên đăng nhập <span class="text-danger">*</span></label>
                    <input type="text" name="UserName" class="form-control" placeholder="VD: manager.clb02" required maxlength="50" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Email <span class="text-danger">*</span></label>
                    <input type="email" name="Email" class="form-control" placeholder="manager02@bms.local" required />
                </div>
                <div class="mb-2">
                    <label class="form-label">Số điện thoại</label>
                    <input type="text" name="PhoneNumber" class="form-control" placeholder="09xxxxxxxx" maxlength="10" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Vai trò phân quyền (Role) <span class="text-danger">*</span></label>
                    <select name="Role" class="form-select" required>
                        <option value="Manager" selected>Manager — Quản lý Vận hành & Hội viên</option>
                        <option value="Staff">Staff — Nhân viên thu ngân tại quầy</option>
                        <option value="Admin">Admin — Quản trị phân quyền hệ thống</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Mật khẩu khởi tạo <span class="text-danger">*</span></label>
                    <input type="text" name="Password" class="form-control" value="Manager@123" required minlength="8" />
                </div>
                <button type="submit" class="btn-primary-bms w-100 justify-content-center">
                    <i class="bi bi-check2-circle"></i> Tạo tài khoản & Gán quyền
                </button>
            </form>
        </div>
    </div>

    <!-- Cột phải: Danh sách tài khoản & Đổi phân quyền -->
    <div class="col-lg-8">
        <div class="data-card">
            <div class="data-card-header flex-wrap gap-2">
                <span class="data-card-title">
                    <i class="bi bi-key-fill me-1 text-danger"></i> Danh sách tài khoản nội bộ & Phân quyền (@Model.Users.Count)
                </span>
                <form method="get" class="d-flex gap-2">
                    <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="Tìm tên, username, mã NV..." style="width:200px" />
                    <select name="roleFilter" class="form-select form-select-sm" style="width:140px" onchange="this.form.submit()">
                        <option value="">Tất cả vai trò</option>
                        <option value="Admin" selected="@(Model.RoleFilter == "Admin")">Admin</option>
                        <option value="Manager" selected="@(Model.RoleFilter == "Manager")">Manager</option>
                        <option value="Staff" selected="@(Model.RoleFilter == "Staff")">Staff</option>
                    </select>
                    <button type="submit" class="btn-outline-bms py-1 px-2">Lọc</button>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Mã</th>
                            <th>Tài khoản</th>
                            <th>Vai trò hiện tại</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Cấp / Đổi quyền (Role)</th>
                            <th class="text-end">Khóa</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.Users)
                        {
                            bool isSelf = u.Id == curUserId;
                            <tr>
                                <td><span class="badge bg-light text-dark border">@u.EmployeeCode</span></td>
                                <td>
                                    <div class="fw-semibold">@u.FullName</div>
                                    <small class="text-muted">@u.UserName @(string.IsNullOrEmpty(u.PhoneNumber) ? "" : $"• {u.PhoneNumber}")</small>
                                </td>
                                <td>
                                    @if (u.CurrentRole == "Admin")
                                    {
                                        <span class="badge bg-danger">Admin (Phân quyền)</span>
                                    }
                                    else if (u.CurrentRole == "Manager")
                                    {
                                        <span class="badge bg-primary">Manager (Quản lý)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Staff (Nhân viên)</span>
                                    }
                                </td>
                                <td>
                                    @if (u.IsActive)
                                    {
                                        <span class="badge-active">Đang hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge-inactive">Đã khóa</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (isSelf)
                                    {
                                        <span class="text-muted" style="font-size:0.8rem">Tài khoản đang dùng</span>
                                    }
                                    else
                                    {
                                        <form asp-action="ChangeRole" method="post" class="d-inline-flex gap-1 align-items-center">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.Id" />
                                            <input type="hidden" name="search" value="@Model.Search" />
                                            <input type="hidden" name="roleFilter" value="@Model.RoleFilter" />
                                            <select name="newRole" class="form-select form-select-sm" style="width:120px;font-size:0.8rem">
                                                <option value="Admin" selected="@(u.CurrentRole == "Admin")">Admin</option>
                                                <option value="Manager" selected="@(u.CurrentRole == "Manager")">Manager</option>
                                                <option value="Staff" selected="@(u.CurrentRole == "Staff")">Staff</option>
                                            </select>
                                            <button type="submit" class="btn-primary-bms py-1 px-2" style="font-size:0.75rem">
                                                Lưu quyền
                                            </button>
                                        </form>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (!isSelf)
                                    {
                                        <form asp-action="ToggleActive" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.Id" />
                                            <input type="hidden" name="search" value="@Model.Search" />
                                            <input type="hidden" name="roleFilter" value="@Model.RoleFilter" />
                                            <button type="submit" class="btn-outline-bms py-1 px-2" style="font-size:0.75rem"
                                                    title="@(u.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")">
                                                <i class="bi @(u.IsActive ? "bi-lock" : "bi-unlock")"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
