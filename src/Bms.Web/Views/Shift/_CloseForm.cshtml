@model Bms.Web.Models.CloseShiftViewModel
@*
    Form đóng ca theo kiểu ĐẾM MÙ: không hiện số tiền kỳ vọng trước khi đếm, để người đóng ca phải đếm thật.
    Nếu số đếm lệch, hệ thống báo số lệch và yêu cầu đếm lại hoặc ghi lý do (bảng đếm được điền lại).
*@
@{
    var restore = TempData["CloseBreakdown"] as string;
    var needReason = TempData["CloseNeedReason"] as string == "1";
}
<form asp-controller="Shift" asp-action="Close" method="post"
      onsubmit="return confirm('Đóng ca với số tiền vừa đếm? Sau khi đóng, ca này không thu tiền được nữa.')">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Close.ShiftId" value="@Model.ShiftId" />
    <p class="mb-2" style="font-size:0.85rem">Đếm toàn bộ tiền mặt trong két, nhập <strong>số tờ</strong> từng mệnh giá. Hệ thống không hiện số tiền phải có trước khi bạn đếm.</p>
    <partial name="_CashCounter" model='"Close.EndingCash"'
             view-data='new ViewDataDictionary(ViewData) { ["CounterId"] = "closeCounter", ["Restore"] = restore }' />
    <div class="mt-2" style="max-width:520px">
        <label class="form-label" for="Close_Notes">
            Lý do chênh lệch @(needReason ? "(bắt buộc)" : "(chỉ cần khi hệ thống báo lệch)")
        </label>
        <textarea id="Close_Notes" name="Close.Notes" maxlength="500" rows="2" class="form-control"
                  placeholder="Ví dụ: thối nhầm 10.000đ cho khách bàn 3" required="@needReason"></textarea>
    </div>
    <button type="submit" class="btn-primary-bms mt-3"><i class="bi bi-lock"></i> Đóng ca và đối soát</button>
</form>
