@model string
@*
    TV5 — Bảng đếm tiền theo mệnh giá. Nhân viên nhập SỐ TỜ từng mệnh giá, hệ thống tự cộng tổng
    (tránh cộng nhẩm sai). Tổng gửi lên qua input ẩn tên = Model (vd "Close.EndingCash"),
    chi tiết đếm gửi kèm qua "CashBreakdown" để ghi nhật ký và điền lại khi phải đếm lại.
    ViewData["CounterId"]: id duy nhất trên trang. ViewData["Restore"]: chuỗi "500000:2,100000:3" để điền lại.
*@
@{
    var id = ViewData["CounterId"] as string ?? "cashCounter";
    var restore = ViewData["Restore"] as string ?? "";
    int[] notes = { 500000, 200000, 100000, 50000, 20000, 10000, 5000, 2000, 1000 };
}
<div id="@id" class="cash-counter">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-2" style="max-width:520px;font-size:0.875rem">
            <thead>
                <tr><th>Mệnh giá</th><th style="width:130px">Số tờ</th><th class="text-end">Thành tiền</th></tr>
            </thead>
            <tbody>
                @foreach (var n in notes)
                {
                    <tr>
                        <td>@n.ToString("N0") đ</td>
                        <td><input type="number" min="0" max="100000" step="1" inputmode="numeric" class="form-control form-control-sm cc-qty" data-value="@n" placeholder="0" /></td>
                        <td class="text-end cc-sub">0</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr style="font-size:1rem">
                    <th colspan="2">Tổng đếm được</th>
                    <th class="text-end"><span class="cc-total">0</span> đ</th>
                </tr>
            </tfoot>
        </table>
    </div>
    <input type="hidden" name="@Model" class="cc-total-input" value="0" />
    <input type="hidden" name="CashBreakdown" class="cc-breakdown" value="" />
</div>
<script>
(function () {
    var root = document.getElementById('@id');
    if (!root) return;
    var qtys = root.querySelectorAll('.cc-qty');
    var restore = '@restore';
    if (restore) {
        var map = {};
        restore.split(',').forEach(function (p) { var kv = p.split(':'); if (kv.length === 2) map[kv[0]] = kv[1]; });
        qtys.forEach(function (q) { if (map[q.dataset.value]) q.value = map[q.dataset.value]; });
    }
    function recalc() {
        var total = 0, parts = [];
        qtys.forEach(function (q) {
            var n = Math.max(0, Math.floor(Number(q.value) || 0));
            var sub = n * Number(q.dataset.value);
            q.closest('tr').querySelector('.cc-sub').textContent = sub.toLocaleString('vi-VN');
            total += sub;
            if (n > 0) parts.push(q.dataset.value + ':' + n);
        });
        root.querySelector('.cc-total').textContent = total.toLocaleString('vi-VN');
        root.querySelector('.cc-total-input').value = total;
        root.querySelector('.cc-breakdown').value = parts.join(',');
    }
    qtys.forEach(function (q) { q.addEventListener('input', recalc); });
    recalc();
})();
</script>
