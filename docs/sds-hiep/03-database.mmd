erDiagram
    BilliardTables ||--o{ PlaySessions : "tổ chức"
    PlaySessions ||--o{ Orders : "chứa các đơn món"
    PlaySessions ||--o| Invoices : "xuất hóa đơn tổng"
    Orders ||--|{ OrderDetails : "chứa từng món"
    Products ||--o{ OrderDetails : "được gọi trong"
    Invoices ||--o{ PaymentTransactions : "thanh toán qua"

    BilliardTables {
        int Id PK
        varchar TableCode UK
        int TableTypeId FK
        varchar Status "Available, InUse, AwaitingPayment, Maintenance"
    }

    PlaySessions {
        int Id PK
        int TableId FK
        datetime2 StartAtUtc
        datetime2 EndAtUtc
        decimal HourlyRateSnapshot
        decimal PlaytimeAmount
        varchar Status "Active, Closed"
    }

    Orders {
        int Id PK
        int SessionId FK "Phiên chơi đang hoạt động"
        datetime2 OrderTimeUtc "Thời điểm đặt món"
        varchar Status "Pending, Preparing, Served, Completed, Cancelled"
        varchar OrderSource "QR, Counter"
        nvarchar Note "Ghi chú của khách"
        varchar PaymentStatus "Unpaid (chờ gộp bill bàn) | PaidImmediately (trả lẻ)"
    }

    OrderDetails {
        int Id PK
        int OrderId FK
        int ProductId FK
        int Quantity "Số lượng"
        decimal UnitPrice "Đơn giá lúc gọi"
        decimal Subtotal "Thành tiền"
        int CancelledQuantity "Số lượng hủy hoàn kho"
        nvarchar CancelReason "Lý do hủy"
    }

    Invoices {
        int Id PK
        int SessionId FK "Liên kết phiên bàn"
        decimal TotalPlaytime "Tổng tiền giờ bàn"
        decimal TotalFandB "Tổng tiền F&B chưa thanh toán lẻ"
        decimal DiscountAmount "Giảm giá / Voucher / Điểm"
        decimal FinalAmount "Tổng thanh toán cuối"
        varchar Status "Unpaid, Paid"
    }
